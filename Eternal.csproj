<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>3.1.0</Version>
    <InformationalVersion>3.1.0</InformationalVersion>
    <Authors>Eternal Analytics</Authors>
    <Product>Eternal System Intelligence</Product>
    <Description>System Intelligence and Diagnostics Suite</Description>
    
    <!-- Publish Configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <!-- GC & Runtime Optimization -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DevPreview_UpdatePackage\**" />
    <EmbeddedResource Remove="DevPreview_UpdatePackage\**" />
    <None Remove="DevPreview_UpdatePackage\**" />
    <Page Remove="DevPreview_UpdatePackage\**" />
    <ApplicationDefinition Remove="DevPreview_UpdatePackage\**" />

    <Compile Remove="Templated UI\**" />
    <EmbeddedResource Remove="Templated UI\**" />
    <None Remove="Templated UI\**" />
    <Page Remove="Templated UI\**" />
    <ApplicationDefinition Remove="Templated UI\**" />

    <Compile Remove="Views\LegacyMainWindow.xaml.cs" />
    <Page Remove="Views\LegacyMainWindow.xaml" />
    <Compile Remove="Views\MainWindow.xaml.cs" />
    <Page Remove="Views\MainWindow.xaml" />
    <Compile Remove="Views\SplashScreenWindow.xaml.cs" />
    <Page Remove="Views\SplashScreenWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FontAwesome.WPF" Version="4.7.0.9" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Management" Version="10.0.5" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.5" />
    <PackageReference Include="Obfuscar" Version="2.2.40">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="obfuscar.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
