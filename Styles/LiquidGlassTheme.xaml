<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Authentic Liquid Glass Brushes (Matched to Reference Visual) -->
    <SolidColorBrush x:Key="LiquidGlassPanelBackground" Color="#1A0F172A"/>
    <SolidColorBrush x:Key="LiquidGlassPanelBorder" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="LiquidGlassPanelInnerHighlight" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="LiquidGlassItemHoverBackground" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="LiquidGlassItemPressedBackground" Color="#35FFFFFF"/>
    <SolidColorBrush x:Key="LiquidGlassSeparatorBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="LiquidGlassTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LiquidGlassTextSecondary" Color="#B0C4DE"/>

    <!-- Authentic Liquid Glass Panel / Card Style -->
    <Style x:Key="LiquidGlassContainerStyle" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#22FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#0D0F172A" Offset="0.4"/>
                    <GradientStop Color="#1A0F172A" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassPanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="10" Opacity="0.50"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#60FFFFFF"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#00E5FF" BlurRadius="30" ShadowDepth="8" Opacity="0.30"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Liquid Glass Menu / Item Button Style -->
    <Style x:Key="LiquidGlassMenuItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource LiquidGlassTextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource LiquidGlassItemHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource LiquidGlassItemPressedBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liquid Glass Horizontal Separator Line -->
    <Style x:Key="LiquidGlassSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource LiquidGlassSeparatorBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,8"/>
    </Style>

    <!-- Liquid Glass Action Button Style -->
    <Style x:Key="LiquidGlassButtonStyle" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#25FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#0F172A" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassPanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#40FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#1E293B" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#3000E5FF"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
