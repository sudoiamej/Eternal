<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. Smooth View Transition (Fade + Subtle Slide) -->
    <Storyboard x:Key="ViewTransitionAnim">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.6">
            <DoubleAnimation.EasingFunction>
                <QuarticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- 2. Entrance Animation for Category Tiles (Cascade Effect) -->
    <Storyboard x:Key="TileEntranceAnim">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <BackEase Amplitude="0.3" EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <BackEase Amplitude="0.3" EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- 3. Pulse Animation for Alerts -->
    <Storyboard x:Key="AlertPulseAnim" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:1"/>
    </Storyboard>

    <!-- 4. Premium Branding Breath -->
    <Storyboard x:Key="LogoBreathingAnim" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" From="0" To="0" Duration="0:0:2">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.05" Duration="0:0:2">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.05" Duration="0:0:2">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- 5. CarPlay Engine Ignition (Tachometer Sweep + Engine Rev Zoom) -->
    <Storyboard x:Key="CarPlayEngineIgnitionAnim">
        <!-- 5a. Logo Zoom-in (Engine Rev) -->
        <DoubleAnimation Storyboard.TargetName="BootLogo" 
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                         From="0.2" To="1.3" Duration="0:0:0.6">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="BootLogo" 
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                         From="0.2" To="1.3" Duration="0:0:0.6">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        
        <!-- Settle to 1.0 -->
        <DoubleAnimation Storyboard.TargetName="BootLogo" 
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                         To="1.0" BeginTime="0:0:0.6" Duration="0:0:0.8">
            <DoubleAnimation.EasingFunction>
                <BackEase Amplitude="0.4" EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="BootLogo" 
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                         To="1.0" BeginTime="0:0:0.6" Duration="0:0:0.8">
            <DoubleAnimation.EasingFunction>
                <BackEase Amplitude="0.4" EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>

        <!-- 5b. Logo Fade-in -->
        <DoubleAnimation Storyboard.TargetName="BootLogo" 
                         Storyboard.TargetProperty="Opacity" 
                         From="0" To="1" Duration="0:0:0.5"/>

        <!-- 5c. Tachometer Width Sweep (Animate from 0 to 300px) -->
        <DoubleAnimation Storyboard.TargetName="TachometerSweep" 
                         Storyboard.TargetProperty="Width" 
                         From="0" To="300" BeginTime="0:0:0.4" Duration="0:0:1.8">
            <DoubleAnimation.EasingFunction>
                <QuarticEase EasingMode="EaseInOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>

        <!-- 5d. Status Text Slide-up + Fade -->
        <DoubleAnimation Storyboard.TargetName="StartupStatusText" 
                         Storyboard.TargetProperty="Opacity" 
                         From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.8"/>
    </Storyboard>

</ResourceDictionary>
