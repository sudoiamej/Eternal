<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Apple CarPlay Minimalist Black Theme Palette -->
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="SidebarColor">#000000</Color>
    <Color x:Key="CardColor">#121214</Color>
    
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#8E8E93</Color>
    <Color x:Key="TextDisabledColor">#48484A</Color>
    <Color x:Key="BorderColor">#1C1C1E</Color>

    <!-- Pure CarPlay Monochrome Semantics (Minimalist) -->
    <Color x:Key="SuccessColor">#FFFFFF</Color>
    <Color x:Key="WarningColor">#8E8E93</Color>
    <Color x:Key="CriticalColor">#FFFFFF</Color>
    <Color x:Key="InfoColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- CarPlay Sleek White Accents -->
    <Color x:Key="AccentColor">#FFFFFF</Color>
    <Color x:Key="AccentSecondaryColor">#8E8E93</Color>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000"/> <!-- Black text on white accent buttons -->

    <!-- CarPlay Home Grid Plate Brushes (making them flat dark plates with white icons) -->
    <SolidColorBrush x:Key="DiagnosticsPlateBrush" Color="#1C1C1E"/>
    <Color x:Key="DiagnosticsPlateColor">#00000000</Color>

    <SolidColorBrush x:Key="TuningPlateBrush" Color="#1C1C1E"/>
    <Color x:Key="TuningPlateColor">#00000000</Color>

    <SolidColorBrush x:Key="MonitoringPlateBrush" Color="#1C1C1E"/>
    <Color x:Key="MonitoringPlateColor">#00000000</Color>

    <SolidColorBrush x:Key="SupportPlateBrush" Color="#1C1C1E"/>
    <Color x:Key="SupportPlateColor">#00000000</Color>

</ResourceDictionary>
