<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High Contrast Theme Palette -->
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="BackgroundGradientColor">#000000</Color>
    <Color x:Key="SidebarColor">#000000</Color>
    <Color x:Key="CardColor">#000000</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFFF00</Color> <!-- Yellow for better visibility -->
    <Color x:Key="TextDisabledColor">#808080</Color>
    <Color x:Key="BorderColor">#00FFFF</Color> <!-- Cyan borders -->

    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#00FF00</Color>
    <Color x:Key="WarningColor">#FFFF00</Color>
    <Color x:Key="CriticalColor">#FF0000</Color>
    <Color x:Key="InfoColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <!-- Adaptive Text on Accent (High Contrast often stays White or Black) -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="White"/>

    <!-- Derived from Accent (Fallback) -->
    <Color x:Key="AccentSecondaryColor">#333333</Color>

    <!-- CarPlay style Plate brushes for Home Dashboard -->
    <SolidColorBrush x:Key="DiagnosticsPlateBrush" Color="#FFFFFF"/>
    <Color x:Key="DiagnosticsPlateColor">#00000000</Color>

    <SolidColorBrush x:Key="TuningPlateBrush" Color="#FFFFFF"/>
    <Color x:Key="TuningPlateColor">#00000000</Color>

    <SolidColorBrush x:Key="MonitoringPlateBrush" Color="#FFFFFF"/>
    <Color x:Key="MonitoringPlateColor">#00000000</Color>

    <SolidColorBrush x:Key="SupportPlateBrush" Color="#FFFFFF"/>
    <Color x:Key="SupportPlateColor">#00000000</Color>

</ResourceDictionary>
