<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neumorphic Soft UI Palette -->
    <Color x:Key="BackgroundColor">#15171e</Color>
    <Color x:Key="NeuLightShadowColor">#212530</Color>
    <Color x:Key="NeuDarkShadowColor">#09090c</Color>
    
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#D0D0E0</Color>
    <Color x:Key="TextDisabledColor">#505065</Color>
    <Color x:Key="BorderColor">#3A3D46</Color>

    <!-- Neon Semantic Colors (HCI: Feedback) -->
    <Color x:Key="SuccessColor">#00FFAA</Color>
    <Color x:Key="WarningColor">#FFB300</Color>
    <Color x:Key="CriticalColor">#FF2A6D</Color>
    <Color x:Key="InfoColor">#00E5FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="NeuLightShadowBrush" Color="{StaticResource NeuLightShadowColor}"/>
    <SolidColorBrush x:Key="NeuDarkShadowBrush" Color="{StaticResource NeuDarkShadowColor}"/>

    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Neon Accents -->
    <Color x:Key="AccentColor">#00E5FF</Color>
    <Color x:Key="AccentSecondaryColor">#7F00FF</Color>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="White"/>

    <!-- CarPlay style Plate brushes for Home Dashboard -->
    <LinearGradientBrush x:Key="DiagnosticsPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFAA" Offset="0"/>
        <GradientStop Color="#00B0FF" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="DiagnosticsPlateColor">#00FFAA</Color>

    <LinearGradientBrush x:Key="TuningPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB300" Offset="0"/>
        <GradientStop Color="#FF3D00" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="TuningPlateColor">#FF3D00</Color>

    <LinearGradientBrush x:Key="MonitoringPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00E5FF" Offset="0"/>
        <GradientStop Color="#7F00FF" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="MonitoringPlateColor">#00E5FF</Color>

    <LinearGradientBrush x:Key="SupportPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A000FF" Offset="0"/>
        <GradientStop Color="#FF2A6D" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="SupportPlateColor">#FF2A6D</Color>

</ResourceDictionary>
