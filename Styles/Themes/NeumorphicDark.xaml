<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neumorphic Soft UI Palette - Pure Monochrome Black & White -->
    <Color x:Key="BackgroundColor">#090A0E</Color>
    <Color x:Key="NeuLightShadowColor">#161822</Color>
    <Color x:Key="NeuDarkShadowColor">#000000</Color>
    
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A0A5B5</Color>
    <Color x:Key="TextDisabledColor">#404555</Color>
    <Color x:Key="BorderColor">#1CFFFFFF</Color>

    <!-- Monochrome Semantic Colors (No conflicting colors except selected accent) -->
    <Color x:Key="SuccessColor">#FFFFFF</Color>
    <Color x:Key="WarningColor">#A0A5B5</Color>
    <Color x:Key="CriticalColor">#FFFFFF</Color>
    <Color x:Key="InfoColor">#A0A5B5</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="NeuLightShadowBrush" Color="{StaticResource NeuLightShadowColor}"/>
    <SolidColorBrush x:Key="NeuDarkShadowBrush" Color="{StaticResource NeuDarkShadowColor}"/>

    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Neon Accents (Dynamic selected accent color is preserved) -->
    <Color x:Key="AccentColor">#00E5FF</Color>
    <Color x:Key="AccentSecondaryColor">#404555</Color>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="White"/>

    <!-- CarPlay style Plate brushes for Home Dashboard - Monochrome Black & Gray -->
    <LinearGradientBrush x:Key="DiagnosticsPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12131A" Offset="0"/>
        <GradientStop Color="#222430" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="DiagnosticsPlateColor">#222430</Color>

    <LinearGradientBrush x:Key="TuningPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12131A" Offset="0"/>
        <GradientStop Color="#222430" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="TuningPlateColor">#222430</Color>

    <LinearGradientBrush x:Key="MonitoringPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12131A" Offset="0"/>
        <GradientStop Color="#222430" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="MonitoringPlateColor">#222430</Color>

    <LinearGradientBrush x:Key="SupportPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12131A" Offset="0"/>
        <GradientStop Color="#222430" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="SupportPlateColor">#222430</Color>

</ResourceDictionary>
