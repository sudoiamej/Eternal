<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Clean Modern Light Theme -->
    <Color x:Key="BackgroundColor">#F3F3F7</Color>
    <Color x:Key="SidebarColor">#E6E6EB</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    
    <Color x:Key="TextColor">#202020</Color>
    <Color x:Key="TextSecondaryColor">#707075</Color>
    <Color x:Key="TextDisabledColor">#A0A0A5</Color>
    <Color x:Key="BorderColor">#E0E0E5</Color>

    <!-- Semantic Diagnostics Status Colors -->
    <Color x:Key="SuccessColor">#27AE60</Color>
    <Color x:Key="WarningColor">#D35400</Color>
    <Color x:Key="CriticalColor">#C0392B</Color>
    <Color x:Key="InfoColor">#2980B9</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Accent Color -->
    <Color x:Key="AccentColor">#2980B9</Color>
    <Color x:Key="AccentSecondaryColor">#E6E6EB</Color>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

    <!-- Plate mappings -->
    <SolidColorBrush x:Key="DiagnosticsPlateBrush" Color="#FFFFFF"/>
    <Color x:Key="DiagnosticsPlateColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TuningPlateBrush" Color="#FFFFFF"/>
    <Color x:Key="TuningPlateColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="MonitoringPlateBrush" Color="#FFFFFF"/>
    <Color x:Key="MonitoringPlateColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SupportPlateBrush" Color="#FFFFFF"/>
    <Color x:Key="SupportPlateColor">#FFFFFF</Color>

</ResourceDictionary>
