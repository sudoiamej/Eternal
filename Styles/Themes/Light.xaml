<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Palette -->
    <Color x:Key="BackgroundColor">#F5F5F7</Color>
    <Color x:Key="BackgroundGradientColor">#FFFFFF</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>
    <Color x:Key="TextDisabledColor">#999999</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>

    <!-- Semantic Colors (Adjusted for Light) -->
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#F57C00</Color>
    <Color x:Key="CriticalColor">#D32F2F</Color>
    <Color x:Key="InfoColor">#7B1FA2</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <!-- Adaptive Text on Accent (Default for Light) -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="White"/>

    <!-- Derived from Accent (Fallback) -->
    <Color x:Key="AccentSecondaryColor">#E0E0E0</Color>

    <!-- CarPlay style Plate brushes for Home Dashboard -->
    <LinearGradientBrush x:Key="DiagnosticsPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFAA" Offset="0"/>
        <GradientStop Color="#00B0FF" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="DiagnosticsPlateColor">#00FFAA</Color>

    <LinearGradientBrush x:Key="TuningPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB300" Offset="0"/>
        <GradientStop Color="#FF3D00" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="TuningPlateColor">#FF3D00</Color>

    <LinearGradientBrush x:Key="MonitoringPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00E5FF" Offset="0"/>
        <GradientStop Color="#7F00FF" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="MonitoringPlateColor">#00E5FF</Color>

    <LinearGradientBrush x:Key="SupportPlateBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A000FF" Offset="0"/>
        <GradientStop Color="#FF2A6D" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="SupportPlateColor">#FF2A6D</Color>

</ResourceDictionary>
