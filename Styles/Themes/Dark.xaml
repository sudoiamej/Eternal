<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- AMOLED Pure Dark Theme -->
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="SidebarColor">#000000</Color>
    <Color x:Key="CardColor">#000000</Color>
    
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A2A2A9</Color>
    <Color x:Key="TextDisabledColor">#484850</Color>
    <Color x:Key="BorderColor">#1D1D22</Color>

    <!-- Semantic Diagnostics Status Colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="CriticalColor">#EF4444</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <!-- Accent Color -->
    <Color x:Key="AccentColor">#3A86FF</Color>
    <Color x:Key="AccentSecondaryColor">#16161C</Color>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

    <!-- Plate mappings -->
    <SolidColorBrush x:Key="DiagnosticsPlateBrush" Color="#000000"/>
    <Color x:Key="DiagnosticsPlateColor">#000000</Color>
    <SolidColorBrush x:Key="TuningPlateBrush" Color="#000000"/>
    <Color x:Key="TuningPlateColor">#000000</Color>
    <SolidColorBrush x:Key="MonitoringPlateBrush" Color="#000000"/>
    <Color x:Key="MonitoringPlateColor">#000000</Color>
    <SolidColorBrush x:Key="SupportPlateBrush" Color="#000000"/>
    <Color x:Key="SupportPlateColor">#000000</Color>

</ResourceDictionary>
