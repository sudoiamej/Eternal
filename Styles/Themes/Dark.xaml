<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Futuristic Glassmorphism Palette -->
    <Color x:Key="BackgroundColor">#05050A</Color>
    <Color x:Key="BackgroundGradientColor">#0D0D1A</Color>
    <Color x:Key="SidebarColor">#0AFFFFFF</Color> <!-- Ultra-translucent glass -->
    <Color x:Key="CardColor">#15FFFFFF</Color>    <!-- Layered glass -->
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#B0B0C0</Color>
    <Color x:Key="TextDisabledColor">#404050</Color>
    <Color x:Key="BorderColor">#20FFFFFF</Color>  <!-- Thin glass border -->

    <!-- Neon Semantic Colors (HCI: Feedback) -->
    <Color x:Key="SuccessColor">#00FFAA</Color>    <!-- Neon Cyan-Green -->
    <Color x:Key="WarningColor">#FFCC00</Color>    <!-- Bright Amber -->
    <Color x:Key="CriticalColor">#FF3366</Color>   <!-- Neon Magenta-Red -->
    <Color x:Key="InfoColor">#00CCFF</Color>       <!-- Electric Blue -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <!-- Neon Accents -->
    <Color x:Key="AccentColor">#00E5FF</Color>
    <Color x:Key="AccentSecondaryColor">#6200EA</Color>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="White"/>

</ResourceDictionary>
