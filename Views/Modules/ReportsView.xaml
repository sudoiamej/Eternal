<UserControl x:Class="Eternal.Views.Modules.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Border Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Report Configuration -->
                    <RowDefinition Height="*"/>    <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- 1. Unified Header (HCI Rule 9: Consistency) -->
                <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="INTELLIGENCE EXPORT" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="System Reporting" Style="{StaticResource H1}" Margin="0"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Report Configuration (HCI Rule 6 & 11: Conceptual Model & Disclosure) -->
                <Border Grid.Row="1" Style="{StaticResource StandardCard}" Margin="0,0,0,25" Padding="25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="FileCodeOutline" Width="32" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,30,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="REPORT DATA MANIFEST" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <TextBlock Text="The following telemetry modules will be included in the generated snapshot:" 
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                            
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="CheckSquare" Width="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="CPU &amp; Architecture Details" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="CheckSquare" Width="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="Motherboard &amp; Chipset Info" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="CheckSquare" Width="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="Physical Memory Configuration" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="CheckSquare" Width="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="System Timestamp &amp; Environment" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Export Actions (HCI Rule 5 & 13: Mapping & Execution) -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="EXPORT DESTINATION" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Padding="20" Background="#0AFFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Local Desktop" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Files are saved as .json for professional audit compatibility." 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding GenerateJsonReportCommand}" 
                                    Style="{StaticResource PrimaryAction}" Padding="25,12">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Download" Width="14" Foreground="White" Margin="0,0,12,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="Generate Intelligence Report"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- BSOD Minidump & Crash Analyzer Section -->
                    <TextBlock Text="BSOD MINIDUMP &amp; CRASH ANALYZER" Style="{StaticResource Caption}" Margin="0,30,0,15" Foreground="{DynamicResource CriticalBrush}"/>
                    <Border Style="{StaticResource StandardCard}" Padding="25" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="MINIDUMP SCAN PATH" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding MinidumpPath}" Padding="10" Background="{DynamicResource BackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}" FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding BrowseCustomMinidumpCommand}" Content="BROWSE DMP" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Padding="15,9"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Command="{Binding ScanMinidumpsCommand}" Content="SCAN MINIDUMPS" Style="{StaticResource PrimaryAction}" Padding="20,10" Margin="0,0,10,0"/>
                            </StackPanel>

                            <!-- Results Listing -->
                            <TextBlock Text="{Binding MinidumpResults.Count, StringFormat='{}FOUND {0} CRASH DUMP FILES'}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding MinidumpResults}" SelectedItem="{Binding SelectedMinidump}" 
                                      AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" Height="150"
                                      BorderThickness="0" RowBackground="Transparent" GridLinesVisibility="None"
                                      Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FILE NAME" Binding="{Binding FileName}" Width="150"/>
                                    <DataGridTextColumn Header="BUGCHECK" Binding="{Binding BugCheckCode}" Width="100"/>
                                    <DataGridTextColumn Header="SUSPECT DRIVER" Binding="{Binding SuspectDriver}" Width="150" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Details Card -->
                            <Border Visibility="{Binding SelectedMinidump, Converter={StaticResource VisibilityConverter}}" Background="#0DFFFFFF" Padding="15" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="CRASH DUMP ANALYTICS SUMMARY" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SelectedMinidump.FileName, StringFormat='File: {0}'}" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding SelectedMinidump.BugCheckCode, StringFormat='BugCheck: {0}'}" FontSize="11" Foreground="{DynamicResource CriticalBrush}" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding SelectedMinidump.SuspectDriver, StringFormat='Culprit: {0}'}" FontSize="11" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SelectedMinidump.Description}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <Border Margin="0,20,0,0" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="InfoCircle" Width="14" Foreground="{DynamicResource InfoBrush}" Margin="0,0,12,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            <TextBlock Text="Note: Exporting does not modify system files. This is a read-only operation." 
                                        FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>




