<UserControl x:Class="Eternal.Views.Modules.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Border Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Report Configuration -->
                    <RowDefinition Height="*"/>    <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- 1. Unified Header (HCI Rule 9: Consistency) -->
                <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="INTELLIGENCE EXPORT" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="System Reporting" Style="{StaticResource H1}" Margin="0"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Report Configuration (HCI Rule 6 & 11: Conceptual Model & Disclosure) -->
                <Border Grid.Row="1" Style="{StaticResource StandardCard}" Margin="0,0,0,25" Padding="25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="FileCodeOutline" Width="32" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,30,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="REPORT DATA MANIFEST" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <TextBlock Text="The following telemetry modules will be included in the generated snapshot:" 
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                            
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="CheckSquare" Width="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="CPU &amp; Architecture Details" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="CheckSquare" Width="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Motherboard &amp; Chipset Info" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="CheckSquare" Width="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Physical Memory Configuration" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="CheckSquare" Width="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="System Timestamp &amp; Environment" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Export Actions (HCI Rule 5 & 13: Mapping & Execution) -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="EXPORT DESTINATION" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Padding="20" Background="#0AFFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Local Desktop" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Files are saved as .json for professional audit compatibility." 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding GenerateJsonReportCommand}" 
                                    Style="{StaticResource PrimaryAction}" Padding="25,12">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Download" Width="14" Foreground="White" Margin="0,0,12,0"/>
                                    <TextBlock Text="Generate Intelligence Report"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <Border Margin="0,20,0,0" Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="InfoCircle" Width="14" Foreground="{StaticResource InfoBrush}" Margin="0,0,12,0"/>
                            <TextBlock Text="Note: Exporting does not modify system files. This is a read-only operation." 
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
