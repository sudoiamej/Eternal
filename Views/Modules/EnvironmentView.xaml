<UserControl x:Class="Eternal.Views.Modules.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="EnvDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
    </UserControl.Resources>
    
    <Border Padding="40">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Scrollable Content -->
            </Grid.RowDefinitions>

            <!-- 1. Unified Header -->
            <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                        <TextBlock Text="SYSTEM INFRASTRUCTURE" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Text="Environment Manager" Style="{StaticResource H1}" Margin="0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <Button Command="{Binding AddVariableCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Plus" Width="10" Foreground="White" Margin="0,0,10,0"/>
                            <TextBlock Text="NEW VARIABLE" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" ToolTip="Refresh Variables">
                        <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsLoading}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 2. User Variables Section -->
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,25" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="User" Width="14" Foreground="#4FC3F7" Margin="0,0,12,0"/>
                                    <TextBlock Text="USER VARIABLES" Style="{StaticResource Caption}" Foreground="White"/>
                                    <TextBlock Text="{Binding UserVariables.Count, StringFormat='({0})'}" Foreground="{DynamicResource TextDisabledBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding UserVariables}" Style="{StaticResource EnvDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VARIABLE NAME" Binding="{Binding Name}" Width="250">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Command="{Binding DataContext.UpdateVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource IconButton}"
                                                            ToolTip="Edit Variable"
                                                            Margin="0,0,10,0">
                                                        <fa:ImageAwesome Icon="Pencil" Width="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource IconButton}"
                                                            ToolTip="Delete Variable">
                                                        <fa:ImageAwesome Icon="Trash" Width="12" Foreground="{DynamicResource CriticalBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 3. System Variables Section -->
                    <Border Style="{StaticResource StandardCard}" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="Windows" Width="14" Foreground="#F44336" Margin="0,0,12,0"/>
                                    <TextBlock Text="SYSTEM VARIABLES" Style="{StaticResource Caption}" Foreground="White"/>
                                    <TextBlock Text="{Binding SystemVariables.Count, StringFormat='({0})'}" Foreground="{DynamicResource TextDisabledBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="ADMIN PRIVILEGES REQUIRED FOR MODIFICATION" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource WarningBrush}" Opacity="0.7"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding SystemVariables}" Style="{StaticResource EnvDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VARIABLE NAME" Binding="{Binding Name}" Width="250">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Command="{Binding DataContext.UpdateVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource IconButton}"
                                                            ToolTip="Edit System Variable"
                                                            Margin="0,0,10,0">
                                                        <fa:ImageAwesome Icon="Pencil" Width="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource IconButton}"
                                                            ToolTip="Delete System Variable">
                                                        <fa:ImageAwesome Icon="Trash" Width="12" Foreground="{DynamicResource CriticalBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Border Grid.RowSpan="2" Background="#CC0A0A0A" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}" Margin="-40">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="18" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
