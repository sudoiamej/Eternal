<UserControl x:Class="Eternal.Views.Modules.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <Border Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Summary Audit -->
                    <RowDefinition Height="*"/>    <!-- Data Grid -->
                </Grid.RowDefinitions>

                <!-- 1. Unified Header (HCI Rule 9: Consistency) -->
                <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="SYSTEM ENVIRONMENT" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="Environment Manager" Style="{StaticResource H1}" Margin="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding LoadCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Margin="0,0,0,5" ToolTip="Refresh Variables">
                        <fa:ImageAwesome Icon="Refresh" Width="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- 2. Configuration Audit (HCI Rule 11: Progressive Disclosure) -->
                <Border Grid.Row="1" Style="{StaticResource StandardCard}" Margin="0,0,0,25" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Code" Width="32" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,25,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CONFIGURATION AUDIT" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Variables.Count}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text=" Active Environment Variables Defined" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="5,0,0,2"/>
                            </StackPanel>
                            <TextBlock Text="Variables define the execution context for system processes and user applications." FontSize="11" Foreground="{StaticResource InfoBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Variable Grid (HCI Rule 5: Mapping & Execution) -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding Variables}" AutoGenerateColumns="False" 
                          IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                          RowBackground="Transparent" GridLinesVisibility="None"
                          Foreground="{StaticResource TextBrush}" CanUserAddRows="False"
                          VirtualizingStackPanel.IsVirtualizing="True">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="VARIABLE NAME" Binding="{Binding Name}" Width="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.UpdateVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Modify Variable (Validation Required)"
                                            HorizontalAlignment="Center">
                                        <fa:ImageAwesome Icon="Pencil" Width="12" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay (HCI Rule 7: Status) -->
                <Border Grid.RowSpan="3" Background="#CC0A0A0A" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}" Margin="-40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{StaticResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                        <TextBlock Text="Parsing System Environment..." FontSize="18" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>

</UserControl>
