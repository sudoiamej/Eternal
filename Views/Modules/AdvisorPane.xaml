<UserControl x:Class="Eternal.Views.Modules.AdvisorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Bolt" Width="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="NEURAL ADVISOR" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Phi-3 Local Inference" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Hardware Status -->
                    <Border Background="#1AFFFFFF" Padding="15" CornerRadius="6" Margin="0,0,0,15" 
                            Visibility="{Binding IsHardwareCompatible, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                        <StackPanel>
                            <TextBlock Text="HARDWARE INCOMPATIBLE" Foreground="{DynamicResource CriticalBrush}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding CompatibilityMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Chat/Response Area -->
                    <Border Background="{DynamicResource CardBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,15" MinHeight="100">
                        <TextBlock Text="{Binding CurrentResponse}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="HISTORY" Style="{StaticResource Caption}" Margin="0,0,0,10" Opacity="0.4"/>
                    <TextBlock Text="{Binding ChatHistory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Opacity="0.7"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Controls -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Command="{Binding UnloadEngineCommand}" Style="{StaticResource SecondaryButton}" 
                        Content="UNLOAD FROM RAM" HorizontalAlignment="Right" FontSize="9" Margin="0,0,0,10"
                        Visibility="{Binding IsModelLoaded, Converter={StaticResource VisibilityConverter}}"/>
                
                <TextBlock Text="Note: Advice is local and private. Verify all commands before execution." 
                           FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>

            <!-- Loading Spinner -->
            <Border Grid.RowSpan="3" Background="#CC000000" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Spinner" Spin="True" Width="32" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Thinking..." HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
