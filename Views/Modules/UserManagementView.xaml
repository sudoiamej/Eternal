<UserControl x:Class="Eternal.Views.Modules.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: User & Group Inventory (Data) -->
        <Border Grid.Column="0" Padding="40" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <TextBlock Text="ETERNAL › ACTIVE MONITORING" Style="{StaticResource HeaderBreadcrumb}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Local Users &amp; Groups" Style="{StaticResource H1}" Margin="0"/>
                        
                        <Button Grid.Column="1" Command="{Binding LoadDataCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh User Data" VerticalAlignment="Center">
                            <fa:ImageAwesome Icon="Refresh" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsBusy}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <TabControl Grid.Row="1" Style="{StaticResource ModernTabControl}">
                    <TabItem Header="USERS">
                        <Border Style="{StaticResource StandardCard}" Padding="0" Margin="0,20,0,0">
                            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" 
                                      AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent"
                                      BorderThickness="0" RowBackground="Transparent" GridLinesVisibility="None"
                                      Foreground="{DynamicResource TextBrush}">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowUserDetailsCommand}" CommandParameter="{Binding SelectedUser}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTemplateColumn Header="STATUS" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="6,2" CornerRadius="2" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Background" Value="#1A4CAF50"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Background" Value="#1AF44336"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="9" FontWeight="Black">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Text" Value="ACTIVE"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Text" Value="DISABLED"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="LAST LOGON" Binding="{Binding LastLogon, StringFormat='{}{0:g}'}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                    
                    <TabItem Header="GROUPS">
                        <Border Style="{StaticResource StandardCard}" Padding="0" Margin="0,20,0,0">
                            <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" 
                                      AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent"
                                      BorderThickness="0" RowBackground="Transparent" GridLinesVisibility="None"
                                      Foreground="{DynamicResource TextBrush}">
                                <DataGrid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowGroupDetailsCommand}" CommandParameter="{Binding SelectedGroup}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GROUP NAME" Binding="{Binding Name}" Width="200" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Right: Management Pane (HCI) -->
        <Border Grid.Column="1" Padding="30" Background="{DynamicResource SidebarBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="IDENTITY MANAGEMENT" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                    
                    <!-- Global Actions -->
                    <Border Background="{DynamicResource CardBrush}" Padding="20" CornerRadius="8" Margin="0,0,0,30">
                        <StackPanel>
                            <TextBlock Text="QUICK PROVISIONING" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <Button Command="{Binding CreateUserCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="UserPlus" Width="12" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="PROVISION NEW USER" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Selected User Management -->
                    <TextBlock Text="SELECTION CONTEXT" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Visibility="{Binding SelectedUser, Converter={StaticResource VisibilityConverter}}" 
                            Background="{DynamicResource CardBrush}" Padding="20" CornerRadius="8" Margin="0,0,0,25">                        <StackPanel>
                            <TextBlock Text="{Binding SelectedUser.Name}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedUser.FullName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,15"/>

                            <!-- Detailed Metadata Card -->
                            <Border Background="#0DFFFFFF" Padding="12" CornerRadius="6" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Last Logon -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Last Logon:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,8,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastLogonString}" FontSize="10" Foreground="White" Margin="0,2,0,2" FontWeight="SemiBold"/>

                                    <!-- Password Age -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password Age:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,8,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PasswordAgeString}" FontSize="10" Foreground="White" Margin="0,2,0,2" FontWeight="SemiBold"/>

                                    <!-- Lock Status -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Lockout Status:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,8,2" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,2">
                                        <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLockedOut}" Value="True">
                                                            <Setter Property="Text" Value="LOCKED"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLockedOut}" Value="False">
                                                            <Setter Property="Text" Value="UNLOCKED"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Command="{Binding UnlockAccountCommand}" Content="UNLOCK" Margin="10,0,0,0" Padding="6,2" FontSize="8" 
                                                Visibility="{Binding IsLockedOut, Converter={StaticResource VisibilityConverter}}"
                                                Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>

                                    <!-- Password Never Expires Toggle -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Never Expires:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,8,2" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding PasswordNeverExpires}" Command="{Binding TogglePasswordNeverExpiresCommand}"
                                              Style="{StaticResource StandardCheckBox}" Margin="0,6,0,2" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Interactive Local Groups Binder -->
                            <TextBlock Text="LOCAL GROUP MEMBERSHIPS" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                            <Border Background="#05FFFFFF" Padding="12" CornerRadius="6" Margin="0,0,0,20">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding IsInAdministratorsGroup}" Content="Administrators" FontSize="11" Margin="0,4" Foreground="White"/>
                                    <CheckBox IsChecked="{Binding IsInUsersGroup}" Content="Users" FontSize="11" Margin="0,4" Foreground="White"/>
                                    <CheckBox IsChecked="{Binding IsInRemoteDesktopUsersGroup}" Content="Remote Desktop Users" FontSize="11" Margin="0,4" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ACCOUNT CONSTRAINTS" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="UserSafetyLock" Content="Unlock Administrative Actions" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,20"/>

                            <Button Command="{Binding ToggleUserStatusCommand}" CommandParameter="{Binding SelectedUser}"
                                    IsEnabled="{Binding IsChecked, ElementName=UserSafetyLock}"
                                    Style="{StaticResource StandardButton}" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="PowerOff" Width="12" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="TOGGLE ENABLED STATE" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding DeleteUserCommand}" CommandParameter="{Binding SelectedUser}"
                                    IsEnabled="{Binding IsChecked, ElementName=UserSafetyLock}"
                                    Style="{StaticResource StandardButton}" Background="{DynamicResource CriticalBrush}" Margin="0,0,0,15">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Trash" Width="12" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="PURGE USER ACCOUNT" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ShowUserDetailsCommand}" CommandParameter="{Binding SelectedUser}"
                                    Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="InfoCircle" Width="12" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="VIEW FULL PROPERTIES" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding SelectedUser, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" 
                            Background="{DynamicResource CardBrush}" Padding="30" CornerRadius="8" Opacity="0.5">
                        <TextBlock Text="Select a user from the inventory to manage account state and policies." 
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#CC0A0A0A" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="18" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
