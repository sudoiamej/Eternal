<UserControl x:Class="Eternal.Views.Modules.RegistryLexiconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Summary Bar -->
            <RowDefinition Height="*"/>    <!-- Data Grid -->
            <RowDefinition Height="Auto"/> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="ETERNAL › BASELINE CONFIGURATION" Style="{StaticResource HeaderBreadcrumb}"/>
            <Grid>
                <TextBlock Text="Zenith DNA Baseline Audit" Style="{StaticResource H1}" Margin="0" FontSize="32" FontWeight="Black"/>
                
                <Button Command="{Binding LoadAuditCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Re-audit Baseline">
                    <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
            <TextBlock Text="Audit system configurations against the Eternal Master Blueprint to detect and repair drift." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Summary Bar -->
        <Border Grid.Row="1" Style="{StaticResource StandardCard}" Margin="0,0,0,20" Background="#11FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Shield" Width="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SYSTEM STATUS: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DriftCount, StringFormat='{}{0} DRIFTED NODES DETECTED'}" Foreground="White" FontSize="12" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#16FFFFFF" CornerRadius="10" Padding="12,6">
                    <TextBlock Text="V3.5 BETA BASELINE" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Deltas}" 
                  Style="{StaticResource NeuDataGrid}"
                  Margin="0,0,0,20"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Theme" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#16FFFFFF" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Theme}" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.5*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Registry Value Name" Binding="{Binding ValueName}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Baseline" Binding="{Binding ExpectedValue}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Actual" Binding="{Binding ActualValue}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Status" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDrifted}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDrifted}" Value="False">
                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="Black" FontSize="9">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDrifted}" Value="True">
                                                    <Setter Property="Text" Value="DRIFTED"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDrifted}" Value="False">
                                                    <Setter Property="Text" Value="HEALTHY"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Footer -->
        <Border Grid.Row="3" Style="{StaticResource StandardCard}" Background="#10FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="REALIGN SYSTEM CONFIGURATIONS" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Realignment will restore modified registry values back to the Golden Baseline configuration." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RealignSystemCommand}" Style="{DynamicResource PrimaryButton}" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Height="45" Width="200">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Wrench" Width="12" Foreground="White" Margin="0,0,10,0"/>
                        <TextBlock Text="REALIGN BASELINE" FontSize="11" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
