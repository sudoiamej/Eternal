<UserControl x:Class="Eternal.Views.Modules.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- 1. Header & Utility -->
            <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                        <TextBlock Text="SECURITY &amp; INTEGRITY" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Text="Security Audit" Style="{StaticResource H1}" Margin="0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LoadCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <fa:ImageAwesome Icon="Refresh" Width="16" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 2. Security Summary Cards -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Defender Status -->
                        <Border Grid.Column="0" Style="{StaticResource StandardCard}" Margin="0,0,10,0" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="WINDOWS DEFENDER" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Real-time: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="ACTIVE" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="12" Visibility="{Binding Defender.RealTimeProtection, Converter={StaticResource VisibilityConverter}}"/>
                                        <TextBlock Text="OFF" Foreground="{DynamicResource CriticalBrush}" FontWeight="Bold" FontSize="12" Visibility="{Binding Defender.RealTimeProtection, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Cloud Protection: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="ENABLED" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="12" Visibility="{Binding Defender.AntivirusEnabled, Converter={StaticResource VisibilityConverter}}"/>
                                        <TextBlock Text="INACTIVE" Foreground="{DynamicResource CriticalBrush}" FontWeight="Bold" FontSize="12" Visibility="{Binding Defender.AntivirusEnabled, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}"/>
                                    </StackPanel>
                                </StackPanel>
                                <fa:ImageAwesome Grid.Column="1" Icon="Shield" Width="24" Opacity="0.5" VerticalAlignment="Center">
                                    <fa:ImageAwesome.Style>
                                        <Style TargetType="fa:ImageAwesome">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Defender.RealTimeProtection}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fa:ImageAwesome.Style>
                                </fa:ImageAwesome>
                            </Grid>
                        </Border>

                        <!-- REAgent Status (Support & Safety) -->
                        <Border Grid.Column="1" Style="{StaticResource StandardCard}" Margin="10,0,0,0" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="WINDOWS RECOVERY (REAGENT)" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Status: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="ENABLED" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="12" Visibility="{Binding ReAgent.IsEnabled, Converter={StaticResource VisibilityConverter}}"/>
                                        <TextBlock Text="DISABLED" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" FontSize="12" Visibility="{Binding ReAgent.IsEnabled, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReAgent.WindowsLocation}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <fa:ImageAwesome Grid.Column="1" Icon="LifeRing" Width="24" Foreground="{DynamicResource InfoBrush}" Opacity="0.5" VerticalAlignment="Center"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Threat Intelligence Audit -->
                    <TextBlock Text="SYSTEM THREAT INTELLIGENCE AUDIT" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30">
                        <DataGrid ItemsSource="{Binding Threats}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                  RowBackground="Transparent" GridLinesVisibility="None"
                                  Foreground="{DynamicResource TextBrush}" CanUserAddRows="False">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0DFFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="150"/>
                                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                <DataGridTemplateColumn Header="STATUS" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThreat}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="WARNING">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 3. BitLocker Encryption -->
                    <TextBlock Text="BITLOCKER &amp; DEVICE ENCRYPTION" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30">
                        <DataGrid ItemsSource="{Binding BitLockerVolumes}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                  RowBackground="Transparent" GridLinesVisibility="None"
                                  Foreground="{DynamicResource TextBrush}" CanUserAddRows="False">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0DFFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DRIVE" Binding="{Binding DriveLetter}" Width="80"/>
                                <DataGridTemplateColumn Header="STATUS" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProtectionStatus}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProtectionStatus}" Value="Off">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="METHOD" Binding="{Binding EncryptionMethod}" Width="150"/>
                                <DataGridTextColumn Header="PROTECTORS" Binding="{Binding KeyProtectors}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 4. Startup Programs -->
                    <TextBlock Text="STARTUP PROGRAMS" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30">
                        <DataGrid ItemsSource="{Binding Startups}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                  RowBackground="Transparent" GridLinesVisibility="None"
                                  Foreground="{DynamicResource TextBrush}" CanUserAddRows="False"
                                  Height="200">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0DFFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PROGRAM" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="100"/>
                                <DataGridTextColumn Header="PATH" Binding="{Binding Path}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 4. System Component Store Repair (SFC & DISM) -->
                    <TextBlock Text="SYSTEM COMPONENT INTEGRITY &amp; REPAIR" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,25" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Automated DISM &amp; System File Checker (SFC)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <TextBlock Text="Run automated Windows system image repair and component store integrity verification." FontSize="10" Foreground="#888896"/>
                                </StackPanel>
                                <Button Command="{Binding RunSystemRepairCommand}" Content="RUN SYSTEM REPAIR (SFC &amp; DISM)" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Background="#0A0A10" BorderBrush="#1C1C28" BorderThickness="1" CornerRadius="8" Padding="12" Height="110">
                                <ScrollViewer x:Name="RepairScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding RepairLog}" FontFamily="Consolas" FontSize="10" Foreground="#A0A0B0" TextWrapping="Wrap" LineHeight="16"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 5. System Services -->
                    <TextBlock Text="ACTIVE SYSTEM SERVICES" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource StandardCard}">
                        <DataGrid ItemsSource="{Binding Services}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                  RowBackground="Transparent" GridLinesVisibility="None"
                                  Foreground="{DynamicResource TextBrush}" CanUserAddRows="False"
                                  Height="200">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0DFFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SERVICE NAME" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="DISPLAY NAME" Binding="{Binding DisplayName}" Width="2*"/>
                                <DataGridTextColumn Header="MODE" Binding="{Binding StartMode}" Width="80"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Border Grid.RowSpan="2" Background="#CC0A0A0A" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                    <TextBlock Text="Auditing System Security..." FontSize="18" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>




