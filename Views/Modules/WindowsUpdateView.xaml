<UserControl x:Class="Eternal.Views.Modules.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:vmm="clr-namespace:Eternal.ViewModels.Modules"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid>
        <Border Padding="40">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Style="{StaticResource ModuleHeaderStyle}">
                        <TextBlock Text="ETERNAL › SYSTEM ADMINISTRATION" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Windows Update" Style="{StaticResource H1}" Margin="0"/>
                            
                            <Button Grid.Column="1" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="Help" Style="{StaticResource IconButton}" ToolTip="Open Knowledge Base" VerticalAlignment="Center">
                                <fa:ImageAwesome Icon="QuestionCircleOutline" Width="12" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Status Banner (Windows 11 Style) -->
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30" Padding="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" Background="{DynamicResource CardBrush}" CornerRadius="32" Margin="0,0,25,0">
                                <fa:ImageAwesome Icon="Refresh" Width="32" Foreground="{DynamicResource AccentBrush}" 
                                                 Spin="{Binding IsChecking}"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="24" FontWeight="Black" Foreground="White"/>
                                
                                <Grid Margin="0,15,40,0" Visibility="{Binding IsInstalling, Converter={StaticResource VisibilityConverter}}">
                                    <ProgressBar Height="12" Value="{Binding InstallProgress}" 
                                                 Style="{StaticResource GlowingProgressBar}"/>
                                    <TextBlock Text="{Binding InstallProgress, StringFormat='{}{0:F0}%'}" 
                                               FontSize="8" FontWeight="Bold" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>


                                <TextBlock Text="{Binding EstimatedTimeRemaining}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,5,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource VisibilityConverter}}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding IsPaused, Converter={StaticResource VisibilityConverter}}">
                                    <fa:ImageAwesome Icon="PauseCircleOutline" Width="12" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="{Binding PauseUntil, StringFormat='Updates are paused until {0:D}'}" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Command="{Binding RebootSystemCommand}" Style="{StaticResource PrimaryAction}" Padding="15,10" Margin="0,0,10,0"
                                        Background="{DynamicResource WarningBrush}"
                                        Visibility="{Binding IsRebootRequired, Converter={StaticResource VisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Refresh" Width="12" Foreground="White" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                        <TextBlock Text="REBOOT NOW" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DismissRebootFlagCommand}" Style="{StaticResource PrimaryAction}" Padding="12,10" Margin="0,0,15,0"
                                        Background="#242436" ToolTip="Clear stale Windows reboot flags from registry if no updates are pending."
                                        Visibility="{Binding IsRebootRequired, Converter={StaticResource VisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Times" Width="10" Foreground="#A0A0B0" Margin="0,0,8,0"/>
                                        <TextBlock Text="CLEAR REBOOT FLAG" FontSize="11" FontWeight="Bold" Foreground="#D0D0DC"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ResumeUpdatesCommand}" Style="{StaticResource PrimaryAction}" Padding="15,10" Margin="0,0,15,0"
                                        Visibility="{Binding IsPaused, Converter={StaticResource VisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Play" Width="10" Foreground="White" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                        <TextBlock Text="RESUME UPDATES" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding InstallAllCommand}" Style="{StaticResource PrimaryAction}" Padding="15,10" Margin="0,0,15,0"
                                        IsEnabled="{Binding IsInstalling, Converter={StaticResource InvertBooleanConverter}}">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource MultiBooleanToVisibilityConverter}">
                                            <Binding Path="IsPaused" Converter="{StaticResource InvertBooleanConverter}"/>
                                            <Binding Path="AvailableUpdates.Count" Converter="{StaticResource IntToBooleanConverter}"/>
                                        </MultiBinding>
                                    </Button.Visibility>
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Download" Width="12" Foreground="White" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                        <TextBlock Text="INSTALL ALL" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource PrimaryAction}" Padding="15,10"
                                        Visibility="{Binding IsPaused, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Search" Width="12" Foreground="White" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                        <TextBlock Text="CHECK FOR UPDATES" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Windows OS Lifecycle & EOL Expiration Audit -->
                    <TextBlock Text="WINDOWS OS LIFECYCLE &amp; EOL AUDIT" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,25" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding LifecycleInfo.Edition}" FontSize="13" FontWeight="Black" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                    <Border Background="#1A3A86FF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LifecycleInfo.DisplayVersion, StringFormat='Version {0}'}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Build: " FontSize="10" Foreground="#888896" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LifecycleInfo.BuildNumber}" FontSize="10" Foreground="#A0A0B0" Margin="0,0,15,0"/>
                                    <TextBlock Text="Servicing EOL Date: " FontSize="10" Foreground="#888896" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LifecycleInfo.EolDate, StringFormat='{}{0:D}'}" FontSize="10" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#154CAF50" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Shield" Width="11" Foreground="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LifecycleInfo.Status}" FontSize="10" FontWeight="Black" Foreground="#4CAF50" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding LifecycleInfo.DaysRemaining, StringFormat='{}{0} Days Remaining'}" 
                                           FontSize="10" FontWeight="Bold" Foreground="#888896" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Pause Controls -->
                    <TextBlock Text="UPDATE CONTROLS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30" Padding="20">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="ClockOutline" Width="18" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,15,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Pause Updates" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Temporarily stop updates from being downloaded and installed." 
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding PauseUpdatesCommand}" CommandParameter="7" Content="Pause for 1 week" 
                                        Style="{StaticResource SecondaryButton}" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Command="{Binding OpenSettingsCommand}" Content="Advanced Settings" 
                                        Style="{StaticResource SecondaryButton}" Padding="15,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Lists -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Available Updates -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="AVAILABLE UPDATES" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <ItemsControl ItemsSource="{Binding AvailableUpdates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StandardCard}" Margin="0,0,0,10" Padding="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <fa:ImageAwesome Icon="Download" Width="14" Foreground="{DynamicResource AccentBrush}" 
                                                                 VerticalAlignment="Top" Margin="0,3,15,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding KBArticle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="INSTALL" Style="{StaticResource SecondaryButton}" 
                                                                FontSize="9" Padding="10,4" VerticalAlignment="Top"
                                                                Command="{Binding DataContext.InstallUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{DynamicResource CardBrush}" Padding="20" CornerRadius="6" 
                                    Visibility="{Binding AvailableUpdates.Count, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                                <TextBlock Text="No pending updates found." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Update History -->
                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                            <TextBlock Text="RECENTLY INSTALLED" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <ItemsControl ItemsSource="{Binding InstalledUpdates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StandardCard}" Margin="0,0,0,10" Padding="15" Opacity="0.8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <fa:ImageAwesome Icon="Check" Width="14" Foreground="{DynamicResource SuccessBrush}" 
                                                                 VerticalAlignment="Top" Margin="0,3,15,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding KBArticle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>




