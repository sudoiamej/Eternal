<UserControl x:Class="Eternal.Views.Modules.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:vm="clr-namespace:Eternal.ViewModels.Modules"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100">
    
    <UserControl.Resources>
        <!-- Spatial Entrance Animation -->
        <Storyboard x:Key="EntranceAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style TargetType="TextBlock" x:Key="HistoryTitleStyle" BasedOn="{StaticResource Caption}">
            <Setter Property="Text" Value="PROCESSOR LOAD TREND (60 SECONDS)"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedHistory}" Value="{x:Static vm:HistoryType.Ram}">
                    <Setter Property="Text" Value="MEMORY CONSUMPTION TREND (60 SECONDS)"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedHistory}" Value="{x:Static vm:HistoryType.Disk}">
                    <Setter Property="Text" Value="DISK THROUGHPUT TREND (60 SECONDS)"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <Border Padding="35">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Header Section -->
                    <StackPanel Style="{StaticResource ModuleHeaderStyle}" Margin="0,0,0,35">
                        <TextBlock Text="ETERNAL › LIVE TELEMETRY ARCHIVE" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Performance Sentry" Style="{StaticResource H1}" Margin="0" FontSize="32" FontWeight="Black"/>
                                <Border Background="#1000FFAA" CornerRadius="10" Padding="12,4" Margin="25,0,0,12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Text="REAL-TIME" FontSize="9" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" Command="{Binding LoadCommand}" Style="{StaticResource IconButton}" ToolTip="Recalibrate Sensors">
                                <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsBusy}"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 2. Core Vital Tiles (HCI: Immediate Feedback) -->
                    <UniformGrid Columns="3" Margin="0,0,0,30">
                        <Border Cursor="Hand" Margin="0,0,15,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StandardCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHistory}" Value="{x:Static vm:HistoryType.Cpu}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectHistoryCommand}" CommandParameter="{x:Static vm:HistoryType.Cpu}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CPU LOAD" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,15" Opacity="0.7"/>
                                <TextBlock Text="{Binding CurrentCpu, StringFormat='{}{0:F0}%'}" FontSize="42" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                <ProgressBar Value="{Binding CurrentCpu}" Style="{StaticResource GlowingProgressBar}" Width="120" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Cursor="Hand" Margin="7.5,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StandardCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHistory}" Value="{x:Static vm:HistoryType.Ram}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectHistoryCommand}" CommandParameter="{x:Static vm:HistoryType.Ram}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="RAM USAGE" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,15" Opacity="0.7"/>
                                <TextBlock Text="{Binding CurrentRam, StringFormat='{}{0:F0}%'}" FontSize="42" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                <ProgressBar Value="{Binding CurrentRam}" Style="{StaticResource GlowingProgressBar}" Foreground="{DynamicResource InfoBrush}" Width="120" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Cursor="Hand" Margin="15,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StandardCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHistory}" Value="{x:Static vm:HistoryType.Disk}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectHistoryCommand}" CommandParameter="{x:Static vm:HistoryType.Disk}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="DISK ACTIVE" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,15" Opacity="0.7"/>
                                <TextBlock Text="{Binding CurrentDisk, StringFormat='{}{0:F0}%'}" FontSize="42" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                <ProgressBar Value="{Binding CurrentDisk}" Style="{StaticResource GlowingProgressBar}" Foreground="{DynamicResource WarningBrush}" Width="120" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 3. Trend Analytics (Spatial Layering) -->
                    <Border Style="{StaticResource StandardCard}" Padding="40">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="250"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Margin="0,0,0,35">
                                <TextBlock Style="{StaticResource HistoryTitleStyle}" FontSize="12"/>
                                <TextBlock Text="Dynamic sensor trend calculated via kernel delta pooling." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Opacity="0.6" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>

                            <ItemsControl Grid.Row="1" VerticalAlignment="Bottom" Height="220" ClipToBounds="True">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemsSource" Value="{Binding CpuHistory}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedHistory}" Value="{x:Static vm:HistoryType.Ram}">
                                                <Setter Property="ItemsSource" Value="{Binding RamHistory}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedHistory}" Value="{x:Static vm:HistoryType.Disk}">
                                                <Setter Property="ItemsSource" Value="{Binding DiskHistory}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="60" Rows="1" VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="1,0" VerticalAlignment="Bottom" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                    <Setter Property="Height" Value="{Binding}"/>
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value><ScaleTransform ScaleY="2.0"/></Setter.Value>
                                                    </Setter>
                                                    <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedHistory, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="{x:Static vm:HistoryType.Ram}">
                                                            <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedHistory, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="{x:Static vm:HistoryType.Disk}">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Grid Lines -->
                            <Grid Grid.Row="1" IsHitTestVisible="False" Opacity="0.05">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="White" BorderThickness="0,0,0,1"/>
                                <Border Grid.Row="1" BorderBrush="White" BorderThickness="0,0,0,1"/>
                                <Border Grid.Row="2" BorderBrush="White" BorderThickness="0,0,0,1"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Feedback -->
        <Border Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <Border.Effect><BlurEffect Radius="25"/></Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,25"/>
                <TextBlock Text="CALIBRATING SENSORS..." FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
