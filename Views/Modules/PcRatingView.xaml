<UserControl x:Class="Eternal.Views.Modules.PcRatingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid>
        <Border Padding="40">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Style="{StaticResource ModuleHeaderStyle}">
                        <TextBlock Text="ETERNAL › PERFORMANCE BENCHMARKING" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PC Intelligence Rating" Style="{StaticResource H1}" Margin="0"/>

                            <Button Grid.Column="1" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="Help" Style="{StaticResource IconButton}" ToolTip="Open Knowledge Base" VerticalAlignment="Center">
                                <fa:ImageAwesome Icon="QuestionCircleOutline" Width="12" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Base Score Hero -->
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30" Padding="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="100" Height="100" Background="{DynamicResource CardBrush}" CornerRadius="10" Margin="0,0,30,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="BASE SCORE" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentScore.BaseScore, StringFormat='{}{0:F1}'}" FontSize="42" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Windows Experience Rating" FontSize="24" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Command="{Binding RunAssessmentCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"
                                    Style="{StaticResource PrimaryAction}" Padding="25,12"
                                    ToolTip="Formal assessments may cause temporary screen flickering and heavy system load. Ensure all work is saved.">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Trophy" Width="14" Foreground="White" Margin="0,0,10,0" Spin="{Binding IsBusy}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="RUN NEW ASSESSMENT" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Subscore Breakdown -->
                    <TextBlock Text="PERFORMANCE COMPONENT BREAKDOWN" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <!-- Processor -->
                            <Border Style="{StaticResource StandardCard}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="PROCESSOR" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding CurrentScore.CpuScore, StringFormat='{}{0:F1}'}" HorizontalAlignment="Right" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" FontSize="18"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding CurrentScore.CpuScore}" Maximum="9.9" Height="6" Margin="0,10" Style="{StaticResource GlowingProgressBar}"/>
                                    <TextBlock Text="{Binding CpuExplanation}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Memory -->
                            <Border Style="{StaticResource StandardCard}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="MEMORY (RAM)" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding CurrentScore.MemoryScore, StringFormat='{}{0:F1}'}" HorizontalAlignment="Right" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" FontSize="18"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding CurrentScore.MemoryScore}" Maximum="9.9" Height="6" Margin="0,10" Style="{StaticResource GlowingProgressBar}"/>
                                    <TextBlock Text="{Binding MemoryExplanation}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Desktop Graphics -->
                            <Border Style="{StaticResource StandardCard}" Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="DESKTOP GRAPHICS" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding CurrentScore.GraphicsScore, StringFormat='{}{0:F1}'}" HorizontalAlignment="Right" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" FontSize="18"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding CurrentScore.GraphicsScore}" Maximum="9.9" Height="6" Margin="0,10" Style="{StaticResource GlowingProgressBar}"/>
                                    <TextBlock Text="{Binding GraphicsExplanation}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                            <!-- 3D Graphics -->
                            <Border Style="{StaticResource StandardCard}" Padding="20" Margin="0,0,0,15">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="3D &amp; GAMING GRAPHICS" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding CurrentScore.D3DScore, StringFormat='{}{0:F1}'}" HorizontalAlignment="Right" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" FontSize="18"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding CurrentScore.D3DScore}" Maximum="9.9" Height="6" Margin="0,10" Style="{StaticResource GlowingProgressBar}"/>
                                    <TextBlock Text="{Binding D3DExplanation}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Primary Disk -->
                            <Border Style="{StaticResource StandardCard}" Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="PRIMARY HARD DISK" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding CurrentScore.DiskScore, StringFormat='{}{0:F1}'}" HorizontalAlignment="Right" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" FontSize="18"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding CurrentScore.DiskScore}" Maximum="9.9" Height="6" Margin="0,10" Style="{StaticResource GlowingProgressBar}"/>
                                    <TextBlock Text="{Binding DiskExplanation}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>


