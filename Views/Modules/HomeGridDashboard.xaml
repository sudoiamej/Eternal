<UserControl x:Class="Eternal.Views.Modules.HomeGridDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,50">
            <TextBlock Text="ETERNAL DASHBOARD" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Black" Opacity="0.7"/>
            <TextBlock Text="Select a Workspace" Foreground="{DynamicResource TextBrush}" FontSize="36" FontWeight="Black"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="10">
            <!-- Diagnostics -->
            <Button Style="{StaticResource CarPlayAppTile}" Width="360" Height="200" Margin="15"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                    CommandParameter="Category_Diagnostics"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tile_PreviewMouseMove">
                <Button.RenderTransform>
                    <ScaleTransform CenterX="180" CenterY="100"/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource TileEntranceAnim}"/>
                    </EventTrigger>
                </Button.Triggers>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,12" HorizontalAlignment="Center" Background="{DynamicResource DiagnosticsPlateBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource DiagnosticsPlateColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <fa:ImageAwesome Icon="Search" Width="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DIAGNOSTICS" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hardware, Storage, Battery" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Opacity="0.6" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <!-- Tuning & Repair -->
            <Button Style="{StaticResource CarPlayAppTile}" Width="360" Height="200" Margin="15"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                    CommandParameter="Category_Tuning"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tile_PreviewMouseMove">
                <Button.RenderTransform>
                    <ScaleTransform CenterX="180" CenterY="100"/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource TileEntranceAnim}"/>
                    </EventTrigger>
                </Button.Triggers>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,12" HorizontalAlignment="Center" Background="{DynamicResource TuningPlateBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource TuningPlateColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <fa:ImageAwesome Icon="Wrench" Width="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TUNING &amp; REPAIR" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Guardian Debloater, Registry" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Opacity="0.6" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <!-- Monitoring -->
            <Button Style="{StaticResource CarPlayAppTile}" Width="360" Height="200" Margin="15"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                    CommandParameter="Category_Monitoring"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tile_PreviewMouseMove">
                <Button.RenderTransform>
                    <ScaleTransform CenterX="180" CenterY="100"/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource TileEntranceAnim}"/>
                    </EventTrigger>
                </Button.Triggers>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,12" HorizontalAlignment="Center" Background="{DynamicResource MonitoringPlateBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource MonitoringPlateColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <fa:ImageAwesome Icon="LineChart" Width="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MONITORING" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Performance, Network" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Opacity="0.6" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <!-- Support & Tools -->
            <Button Style="{StaticResource CarPlayAppTile}" Width="360" Height="200" Margin="15"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                    CommandParameter="Category_Support"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tile_PreviewMouseMove">
                <Button.RenderTransform>
                    <ScaleTransform CenterX="180" CenterY="100"/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource TileEntranceAnim}"/>
                    </EventTrigger>
                </Button.Triggers>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,12" HorizontalAlignment="Center" Background="{DynamicResource SupportPlateBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource SupportPlateColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <fa:ImageAwesome Icon="LifeRing" Width="24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SUPPORT &amp; TOOLS" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Logs, Update, Recovery" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Opacity="0.6" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
