<UserControl x:Class="Eternal.Views.Modules.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:m="clr-namespace:Eternal.Models"
             xmlns:vm="clr-namespace:Eternal.ViewModels.Modules"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1000"
             Focusable="True" PreviewKeyDown="UserControl_PreviewKeyDown" PreviewKeyUp="UserControl_PreviewKeyUp">
    <UserControl.Resources>
        <!-- Camera Template -->
        <DataTemplate x:Key="CameraTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SELECT CAMERA" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,15,0"/>
                            <ComboBox ItemsSource="{Binding CameraGroups}" SelectedItem="{Binding SelectedCameraGroup}" Width="250" DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                        <Button Command="{Binding ToggleCameraCommand}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="{Binding IsCameraActive, Converter={StaticResource CategoryToIconConverter}, ConverterParameter='Camera'}" 
                                                Width="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding IsCameraActive, Converter={StaticResource BooleanToStatusConverter}, ConverterParameter='Camera'}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StandardCard}" Padding="0" ClipToBounds="True">
                    <Grid Background="Black">
                        <Image Source="{Binding CameraFeed}" Stretch="Uniform"/>
                        <Border Background="#AA000000" VerticalAlignment="Bottom" Padding="20">
                            <StackPanel>
                                <TextBlock Text="LIVE CAMERA FEED" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding CameraStatus}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,5"/>
                                <TextBlock Text="{Binding FrameInfo}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,5"/>
                                <TextBlock Text="Verifying sensor integrity and frame consistency." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Mouse/Touchpad/Touchscreen Template -->
        <DataTemplate x:Key="InputTestTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="InfoCircle" Width="14" Foreground="{DynamicResource InfoBrush}" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            <TextBlock Text="Tracking Accuracy Test: Move or touch the canvas to plot input data. Use the clear button to reset." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Content="Clear Canvas" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="ClearCanvas_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StandardCard}" Padding="0" Background="#050505">
                    <InkCanvas x:Name="TestCanvas" Background="Transparent" EditingMode="Ink">
                        <InkCanvas.DefaultDrawingAttributes>
                            <DrawingAttributes Color="#9B59B6" Width="2" Height="2" FitToCurve="True"/>
                        </InkCanvas.DefaultDrawingAttributes>
                    </InkCanvas>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Keyboard Template -->
        <DataTemplate x:Key="KeyboardTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="N-KEY ROLLOVER" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ActiveKeysCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Press multiple keys simultaneously to test ghosting and rollover limits. Ensure focus is on this window." 
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="500" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StandardCard}" Padding="20">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <ItemsControl ItemsSource="{Binding KeyboardRows}" MinWidth="850">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}" Margin="0,0,0,5">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="KeyBorder" Width="{Binding Width}" Height="45" Margin="2" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="#111111">
                                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                            <Setter TargetName="KeyBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="KeyBorder" Property="TextBlock.Foreground" Value="White"/>
                                                            <Setter TargetName="KeyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Speakers Template -->
        <DataTemplate x:Key="SpeakersTemplate">
            <Border Style="{StaticResource StandardCard}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <StackPanel HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="VolumeUp" Width="64" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,30"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                    <TextBlock Text="AUDIO CHANNEL TEST" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Verify speakers or headphones output clean audio signal." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <Button Command="{Binding PlayTestSoundCommand}" Style="{StaticResource PrimaryButton}" Content="Play Test Tone" Width="200"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Monitor Template -->
        <DataTemplate x:Key="MonitorTemplate">
            <Border Style="{StaticResource StandardCard}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                <StackPanel HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="Television" Width="64" Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,30"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                    <TextBlock Text="COLOR INTEGRITY TEST" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Detect dead pixels or backlight bleed by cycling through solid colors (RGBW+K)." 
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,30" TextWrapping="Wrap"/>
                    <Button Command="{Binding StartMonitorTestCommand}" Style="{StaticResource PrimaryButton}" Content="Start Full-Screen Test" Width="200"/>
                    <TextBlock Text="Press any key or click to cycle colors. ESC to exit." FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- USB Template -->
        <DataTemplate x:Key="UsbPortsTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Usb" Width="16" Foreground="{DynamicResource WarningBrush}" Margin="0,0,15,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                        <TextBlock Text="USB EVENT TRACKER: Monitoring bus changes in real-time. Connect/Disconnect devices to verify ports." 
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StandardCard}" Padding="0">
                    <DataGrid ItemsSource="{Binding UsbHistory}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="100"/>
                            <DataGridTemplateColumn Header="ACTION" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#204CAF50"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action}" Value="Disconnected">
                                                            <Setter Property="Background" Value="#20F44336"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Action}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}" Value="Disconnected">
                                                                <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DEVICE NAME" Binding="{Binding DeviceName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Padding="40">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                        <TextBlock Text="COMPONENT DIAGNOSTICS" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Text="Hardware Component Testing" Style="{StaticResource H1}" Margin="0"/>
                </StackPanel>
            </Grid>

            <!-- Main Master-Detail -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Master: Component List -->
                <Border Grid.Column="0" Style="{StaticResource StandardCard}" Padding="10" Margin="0,0,20,0">
                    <ListBox ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource VisibilityConverter}}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="15,12" CornerRadius="4" Background="Transparent" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <fa:ImageAwesome Grid.Column="0" Icon="{Binding Icon}" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                        <fa:ImageAwesome.Style>
                                                            <Style TargetType="fa:ImageAwesome">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa:ImageAwesome.Style>
                                                    </fa:ImageAwesome>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <!-- Detail: Test Area -->
                <ContentControl x:Name="DetailArea" Grid.Column="1" Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource CameraTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedComponent.Type}" Value="{x:Static m:HardwareComponentType.Camera}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource CameraTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedComponent.Type}" Value="{x:Static m:HardwareComponentType.Mouse}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource InputTestTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedComponent.Type}" Value="{x:Static m:HardwareComponentType.Keyboard}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource KeyboardTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedComponent.Type}" Value="{x:Static m:HardwareComponentType.Speakers}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SpeakersTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedComponent.Type}" Value="{x:Static m:HardwareComponentType.Monitor}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MonitorTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedComponent.Type}" Value="{x:Static m:HardwareComponentType.Touchpad}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource InputTestTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedComponent.Type}" Value="{x:Static m:HardwareComponentType.Touchscreen}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource InputTestTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedComponent.Type}" Value="{x:Static m:HardwareComponentType.UsbPorts}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource UsbPortsTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>




