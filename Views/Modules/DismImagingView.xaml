<UserControl x:Class="Eternal.Views.Modules.DismImagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:vmm="clr-namespace:Eternal.ViewModels.Modules"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid>
        <Border Padding="40">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Style="{StaticResource ModuleHeaderStyle}">
                            <TextBlock Text="ETERNAL › DEPLOYMENT &amp; IMAGING" Style="{StaticResource HeaderBreadcrumb}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DISM Image Studio" Style="{StaticResource H1}" Margin="0"/>
                                
                                <Button Grid.Column="1" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="Help" Style="{StaticResource IconButton}" ToolTip="Open Knowledge Base" VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="QuestionCircleOutline" Width="12" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- File Selection Area -->
                        <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30" Padding="25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="TARGET IMAGE FILE (.WIM / .ESD)" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <TextBox Text="{Binding SelectedFilePath}" IsReadOnly="True" Padding="12,12,40,12" 
                                                 Background="{DynamicResource BackgroundBrush}" Foreground="White" BorderBrush="{DynamicResource BorderBrush}"
                                                 FontSize="12"/>
                                        <Button Command="{Binding CopyPathCommand}" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Margin="0,0,10,0" ToolTip="Copy file path to clipboard">
                                            <fa:ImageAwesome Icon="Copy" Width="12" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Button Command="{Binding BrowseImageCommand}" Content="BROWSE IMAGE" 
                                            Style="{StaticResource PrimaryAction}" Padding="20,10" Margin="0,0,10,0"/>
                                    <Button Command="{Binding ClearCommand}" Content="CLEAR" 
                                            Style="{StaticResource SecondaryButton}" Padding="20,10"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Results Area -->
                        <Grid>
                            <!-- Empty State -->
                            <Border Visibility="{Binding WimDetails, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}"
                                    Background="{DynamicResource CardBrush}" Padding="60" CornerRadius="10" Opacity="0.5">
                                <StackPanel HorizontalAlignment="Center">
                                    <fa:ImageAwesome Icon="FileArchiveOutline" Width="64" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="No Image Loaded" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select a Windows Image (.wim) or Electronic Software Download (.esd) file to begin analysis." 
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Image List -->
                            <StackPanel Visibility="{Binding WimDetails, Converter={StaticResource VisibilityConverter}}">
                                <TextBlock Text="{Binding WimDetails.Images.Count, StringFormat='{}FOUND {0} IMAGE EDITIONS IN FILE'}" 
                                           Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                                
                                <ItemsControl ItemsSource="{Binding WimDetails.Images}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StandardCard}" Margin="0,0,0,15" Padding="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Index Circle -->
                                                    <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource AccentBrush}" CornerRadius="20" Margin="0,0,20,0">
                                                        <TextBlock Text="{Binding Index}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Black" Foreground="White" FontSize="16"/>
                                                    </Border>

                                                    <!-- Metadata -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Tech Specs -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Border Background="#1AFFFFFF" Padding="6,2" CornerRadius="3" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Architecture}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                            <Border Background="#1AFFFFFF" Padding="6,2" CornerRadius="3">
                                                                <TextBlock Text="{Binding Version}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Size}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Loading Overlay -->
                <Border Background="#CC000000" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}" Margin="-40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                        <TextBlock Text="Analyzing Windows Image Structure..." FontSize="18" Foreground="{DynamicResource TextBrush}" FontWeight="Bold"/>
                        <TextBlock Text="Direct DISM communication in progress..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>




