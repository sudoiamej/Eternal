<UserControl x:Class="Eternal.Views.Modules.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Driver Stack (Data) -->
        <Border Grid.Column="0" Padding="40" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <TextBlock Text="ETERNAL › ACTIVE MONITORING" Style="{StaticResource HeaderBreadcrumb}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Driver Inspector" Style="{StaticResource H1}" Margin="0"/>
                        
                        <Button Grid.Column="1" Command="{Binding LoadCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh Driver List" VerticalAlignment="Center">
                            <fa:ImageAwesome Icon="Refresh" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsBusy}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}" 
                          AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowDetailsCommand}" CommandParameter="{Binding SelectedDriver}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PROVIDER" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="6,2" CornerRadius="3" Background="#15FFFFFF">
                                        <TextBlock Text="{Binding Provider}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DEVICE NAME" Binding="{Binding Name}" Width="*" FontWeight="Bold"/>
                        <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="120"/>
                        <DataGridTemplateColumn Header="TYPE" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="3rd Party">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right: Management Pane (HCI) -->
        <Border Grid.Column="1" Padding="30" Background="{DynamicResource SidebarBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SYSTEM SUPPORT IDENTIFIER" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Padding="20" Margin="0,0,0,25">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <fa:ImageAwesome Icon="InfoCircle" Width="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding OemInfo.Vendor}" FontWeight="Black" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OemInfo.Model}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OemInfo.SerialNumber}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5" Margin="0,2,0,15"/>
                            
                            <Button Command="{Binding OpenOemSupportCommand}" Content="OPEN OFFICIAL PORTAL" Style="{StaticResource StandardButton}" Background="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DRIVER FORENSICS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Visibility="{Binding SelectedDriver, Converter={StaticResource VisibilityConverter}}" 
                            Background="{DynamicResource CardBrush}" Padding="20" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDriver.Name}" FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedDriver.HardwareId}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,20" TextWrapping="Wrap" Opacity="0.6"/>

                            <Button Command="{Binding FindOfficialDriverCommand}" 
                                    CommandParameter="{Binding SelectedDriver}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Download" Width="12" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="SEARCH FOR UPDATES" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportDriverCommand}" 
                                    CommandParameter="{Binding SelectedDriver}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="FileArchiveOutline" Width="12" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="BACK UP DRIVER (ZIP)" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding ShowDetailsCommand}" 
                                    CommandParameter="{Binding SelectedDriver}"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="List" Width="12" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="FULL STACK PROPERTIES" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding SelectedDriver, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" 
                            Background="{DynamicResource CardBrush}" Padding="30" CornerRadius="8" Opacity="0.5">
                        <TextBlock Text="Select a driver from the stack to analyze provenance and check for updates." 
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#CC0A0A0A" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="18" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
