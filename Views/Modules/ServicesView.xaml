<UserControl x:Class="Eternal.Views.Modules.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Service Inventory (Data) -->
        <Border Grid.Column="0" Padding="40" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <TextBlock Text="ETERNAL › ACTIVE MONITORING" Style="{StaticResource HeaderBreadcrumb}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Services Inspector" Style="{StaticResource H1}" Margin="0"/>
                        
                        <Button Grid.Column="1" Command="{Binding LoadCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh Service List" VerticalAlignment="Center">
                            <fa:ImageAwesome Icon="Refresh" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsBusy}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" 
                          AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                          HeadersVisibility="Column" GridLinesVisibility="None">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowDetailsCommand}" CommandParameter="{Binding SelectedService}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STATUS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter Property="Background" Value="#1A4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Stopped">
                                                        <Setter Property="Background" Value="#1AF44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Stopped">
                                                            <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DISPLAY NAME" Binding="{Binding DisplayName}" Width="*"/>
                        <DataGridTextColumn Header="STARTUP" Binding="{Binding StartupType}" Width="120"/>
                        <DataGridTextColumn Header="LOG ON" Binding="{Binding LogOnAs}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right: Management Pane (HCI) -->
        <Border Grid.Column="1" Padding="30" Background="{DynamicResource SidebarBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SERVICE MANAGEMENT" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                    
                    <Border Visibility="{Binding SelectedService, Converter={StaticResource VisibilityConverter}}" 
                            Background="{DynamicResource CardBrush}" Padding="20" CornerRadius="8" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedService.DisplayName}" FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedService.Name}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,20"/>

                            <TextBlock Text="SCM CONSTRAINTS" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="SafetyLock" Content="Unlock Advanced Actions" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,20"/>

                            <Button Command="{Binding StopServiceCommand}" 
                                    CommandParameter="{Binding SelectedService}"
                                    IsEnabled="{Binding IsChecked, ElementName=SafetyLock}"
                                    Style="{StaticResource StandardButton}" Background="{DynamicResource WarningBrush}" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Stop" Width="12" Foreground="White" Margin="0,0,12,0"/>
                                    <TextBlock Text="STOP SERVICE" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Command="{Binding ShowDetailsCommand}" 
                                    CommandParameter="{Binding SelectedService}"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="InfoCircle" Width="12" Foreground="White" Margin="0,0,12,0"/>
                                    <TextBlock Text="VIEW ALL PROPERTIES" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding SelectedService, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" 
                            Background="{DynamicResource CardBrush}" Padding="30" CornerRadius="8" Opacity="0.5">
                        <TextBlock Text="Select a service from the inventory to manage startup and state." 
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#CC0A0A0A" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="18" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
