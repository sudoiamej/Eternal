<UserControl x:Class="Eternal.Views.Modules.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1200">

    <Grid>
        <Border Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Navigation -->
                    <RowDefinition Height="*"/>    <!-- Main Content -->
                    <RowDefinition Height="Auto"/> <!-- Status Bar -->
                </Grid.RowDefinitions>

                <!-- Search & Navigation -->
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REGISTRY INTELLIGENCE" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding NavigateUpCommand}" Style="{StaticResource IconButton}" Margin="0,0,10,0">
                                <fa:ImageAwesome Icon="AngleUp" Width="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <TextBox Grid.Column="1" Text="{Binding SearchPath, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" Background="#111111" Foreground="White" BorderBrush="{StaticResource BorderBrush}" 
                                     VerticalContentAlignment="Center" FontSize="13">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoadRegistryCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding LoadRegistryCommand}" Style="{StaticResource PrimaryButton}" 
                            Content="Surgical Read" Margin="15,20,0,0"/>
                </Grid>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Registry Values & Browsing -->
                    <Border Grid.Column="0" Margin="0,0,20,0" Style="{StaticResource StandardCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Key Metadata & Provenance -->
                                <RowDefinition Height="*"/>    <!-- Value List -->
                            </Grid.RowDefinitions>

                            <!-- FEATURE 4: Component Provenance -->
                            <Border Grid.Row="0" Background="#1A1A1A" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentKey.Name}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="{Binding KeyDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <fa:ImageAwesome Icon="Shield" Width="10" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="PROVENANCE:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding CurrentProvenance.OwnerName}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text=" · " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0"/>
                                            <TextBlock Text="{Binding CurrentProvenance.Publisher}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <Border Grid.Column="1" Background="#204CAF50" Padding="8,4" CornerRadius="4" VerticalAlignment="Top" 
                                            Visibility="{Binding CurrentProvenance.IsSystemComponent, Converter={StaticResource VisibilityConverter}}">
                                        <TextBlock Text="SYSTEM PROTECTED" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="Black"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="15">
                                    <!-- Sub-keys Navigation -->
                                    <TextBlock Text="CHILD KEYS" Style="{StaticResource Caption}" Margin="5,0,0,10" Visibility="{Binding CurrentKey.SubKeys.Count, Converter={StaticResource VisibilityConverter}}"/>
                                    <ItemsControl ItemsSource="{Binding CurrentKey.SubKeys}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.NavigateToSubKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Margin="5" Padding="10,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <fa:ImageAwesome Icon="FolderOutline" Width="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding}" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,15" Visibility="{Binding CurrentKey.SubKeys.Count, Converter={StaticResource VisibilityConverter}}"/>

                                    <!-- Values -->
                                    <TextBlock Text="REGISTRY VALUES" Style="{StaticResource Caption}" Margin="5,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding CurrentKey.Values}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#111111" Padding="15" Margin="0,0,0,10" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource AccentSecondaryBrush}" FontSize="11" Margin="0,3,0,5"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Command="{Binding DataContext.ModifyValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" Style="{StaticResource IconButton}" VerticalAlignment="Top">
                                                            <fa:ImageAwesome Icon="Pencil" Width="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Right Column: Tools, Vault & Watchlist -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Presets -->
                            <RowDefinition Height="Auto"/> <!-- Watchlist -->
                            <RowDefinition Height="*"/>    <!-- Undo Vault -->
                        </Grid.RowDefinitions>

                        <!-- Intelligent Presets -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,25">
                            <TextBlock Text="INTELLIGENT PRESETS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CommonTweaks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12" Padding="15">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StandardCard}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentOSCompatible}" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Border Background="#20FFFFFF" Padding="4,1" CornerRadius="2" Margin="5,0,0,0"
                                                                    Visibility="{Binding IsWin10Compatible, Converter={StaticResource VisibilityConverter}}">
                                                                <TextBlock Text="W10" FontSize="7" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </Border>
                                                            <Border Background="#20FFFFFF" Padding="4,1" CornerRadius="2" Margin="5,0,0,0"
                                                                    Visibility="{Binding IsWin11Compatible, Converter={StaticResource VisibilityConverter}}">
                                                                <TextBlock Text="W11" FontSize="7" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Options}" IsEnabled="{Binding IsCurrentOSCompatible}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                        <Button Style="{StaticResource SecondaryButton}" Margin="2" Padding="5" 
                                                                Command="{Binding DataContext.ApplyTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding Label}" FontSize="10" TextAlignment="Center"/>
                                                        </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- FEATURE 3: Registry Drift Monitor -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,25">
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="DRIFT WATCHLIST" Style="{StaticResource Caption}"/>
                                <Button Command="{Binding RefreshWatchlistCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Right">
                                    <fa:ImageAwesome Icon="Refresh" Width="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Watchlist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111111" Padding="12,8" Margin="0,0,0,8" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                                                    <TextBlock Text="{Binding DisplayPath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{StaticResource WarningBrush}" Padding="6,2" CornerRadius="2" VerticalAlignment="Center"
                                                        Visibility="{Binding IsDrifting, Converter={StaticResource VisibilityConverter}}">
                                                    <TextBlock Text="DRIFT" Foreground="Black" FontSize="8" FontWeight="Black"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- FEATURE 2: Undo Vault -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="UNDO VAULT (RECOVERY)" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding UndoVault}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" Margin="0,0,0,10" CornerRadius="4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.1"/>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Command="{Binding DataContext.UndoChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="8,4">
                                                        <fa:ImageAwesome Icon="Undo" Width="10" Foreground="White"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="#111111" Padding="10" Margin="0,20,0,0" CornerRadius="4">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <fa:ImageAwesome Icon="Spinner" Spin="True" Width="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                                         Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
