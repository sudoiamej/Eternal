<UserControl x:Class="Eternal.Views.Modules.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1200">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Registry Intelligence (Data) -->
        <Border Grid.Column="0" Padding="40" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Navigation -->
                    <RowDefinition Height="*"/>    <!-- Main Key Browsing -->
                </Grid.RowDefinitions>

                <!-- Search & Navigation -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ETERNAL › SYSTEM CONFIGURATION" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding NavigateUpCommand}" Style="{StaticResource IconButton}" Margin="0,0,10,0">
                                <fa:ImageAwesome Icon="AngleUp" Width="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <TextBox Grid.Column="1" Text="{Binding SearchPath, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" FontSize="13">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoadRegistryCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding LoadRegistryCommand}" Style="{StaticResource PrimaryButton}" 
                            Content="SURGICAL READ" Margin="15,20,0,0"/>
                </Grid>

                <!-- Key Browsing Content -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Key Metadata -->
                        <RowDefinition Height="*"/>    <!-- Value List -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#15FFFFFF" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentKey.Name}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding KeyDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Shield" Width="10" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="PROVENANCE:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding CurrentProvenance.OwnerName}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBlock Text="{Binding CurrentProvenance.Publisher}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <Border Grid.Column="1" Background="#204CAF50" Padding="8,4" CornerRadius="4" VerticalAlignment="Top" 
                                    Visibility="{Binding CurrentProvenance.IsSystemComponent, Converter={StaticResource VisibilityConverter}}">
                                <TextBlock Text="SYSTEM PROTECTED" Foreground="{DynamicResource SuccessBrush}" FontSize="9" FontWeight="Black"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Sub-keys -->
                            <TextBlock Text="CHILD KEYS" Style="{StaticResource Caption}" Margin="5,0,0,10" Visibility="{Binding CurrentKey.SubKeys.Count, Converter={StaticResource VisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding CurrentKey.SubKeys}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.NavigateToSubKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Margin="5" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <fa:ImageAwesome Icon="FolderOutline" Width="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,20" Visibility="{Binding CurrentKey.SubKeys.Count, Converter={StaticResource VisibilityConverter}}"/>

                            <!-- Values -->
                            <TextBlock Text="REGISTRY VALUES" Style="{StaticResource Caption}" Margin="5,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding CurrentKey.Values}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0CFFFFFF" Padding="15" Margin="0,0,0,10" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AccentSecondaryBrush}" FontSize="11" Margin="0,3,0,5"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{Binding DataContext.ModifyValueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        IsEnabled="{Binding IsChecked, ElementName=SafetyLock}"
                                                        CommandParameter="{Binding}" Style="{StaticResource IconButton}" VerticalAlignment="Top">
                                                    <fa:ImageAwesome Icon="Pencil" Width="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Right: Management Pane (HCI Rule 6) -->
        <Border Grid.Column="1" Padding="30" Background="{DynamicResource SidebarBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="REGISTRY FORENSICS" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                    
                    <!-- Safety Constraint -->
                    <Border Background="{DynamicResource CardBrush}" Padding="20" CornerRadius="8" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="SECURITY CONSTRAINTS" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="SafetyLock" Content="Unlock Intelligence Editing" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,5"/>
                            <TextBlock Text="Manual modifications can cause system instability." FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Presets -->
                    <TextBlock Text="INTELLIGENT PRESETS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <ItemsControl ItemsSource="{Binding CommonTweaks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,12" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Options}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="2" Padding="5" 
                                                            IsEnabled="{Binding IsChecked, ElementName=SafetyLock}"
                                                            Command="{Binding DataContext.ApplyTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Label}" FontSize="10"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Recovery Vault -->
                    <TextBlock Text="UNDO VAULT" Style="{StaticResource Caption}" Margin="0,15,0,15"/>
                    <ItemsControl ItemsSource="{Binding UndoVault}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,0,0,10" CornerRadius="4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Background="#109B59B6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding DataContext.UndoChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource IconButton}">
                                            <fa:ImageAwesome Icon="Undo" Width="10" Foreground="White"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#CC0A0A0A" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="18" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
