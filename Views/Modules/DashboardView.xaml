<UserControl x:Class="Eternal.Views.Modules.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             xmlns:m="clr-namespace:Eternal.Models"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Spatial Module Entry Animation -->
        <Storyboard x:Key="ModuleEntrance">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 1. GRID / CARPLAY STYLE DASHBOARD -->
        <DataTemplate x:Key="GridLayoutTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/> <!-- Intelligence Core -->
                    <ColumnDefinition Width="1*"/> <!-- Identity & Utilities -->
                </Grid.ColumnDefinitions>

                <!-- A. Intelligence Core (Primary Focal Point) -->
                <StackPanel Grid.Column="0" Margin="10,0">
                    <!-- Trust Index Glass Module -->
                    <Border Style="{StaticResource StandardCard}" Padding="35" Margin="0,0,0,25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Overall Trust Gauge -->
                            <Grid Grid.Column="0" HorizontalAlignment="Left" Visibility="{Binding IsPeMode, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="GaugeScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Grid.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="GaugeScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.03" Duration="0:0:3">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="GaugeScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.03" Duration="0:0:3">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Outer Ring Clockwise Rotation -->
                                                <DoubleAnimation Storyboard.TargetName="OuterRingRot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:20" RepeatBehavior="Forever"/>
                                                <!-- Inner Ring Counter-Clockwise Rotation -->
                                                <DoubleAnimation Storyboard.TargetName="InnerRingRot" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:12" RepeatBehavior="Forever"/>
                                                <!-- Sweeping Scanline -->
                                                <DoubleAnimation Storyboard.TargetName="ScannerLineTrans" Storyboard.TargetProperty="Y" From="-110" To="110" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>

                                <!-- Ambient Aura Backdrop Glow -->
                                <Border CornerRadius="85" Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.15">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrustLevel}" Value="Safe">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value><BlurEffect Radius="35"/></Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrustLevel}" Value="Warning">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value><BlurEffect Radius="35"/></Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrustLevel}" Value="Critical">
                                                    <Setter Property="Background" Value="{DynamicResource CriticalBrush}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value><BlurEffect Radius="35"/></Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Holographic Outer Concentric Ring -->
                                <Ellipse Width="224" Height="224" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Opacity="0.25" StrokeDashArray="12 6" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="OuterRingRot"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Holographic Inner Concentric Ring -->
                                <Ellipse Width="176" Height="176" Stroke="{DynamicResource AccentSecondaryBrush}" StrokeThickness="1" Opacity="0.35" StrokeDashArray="6 4" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="InnerRingRot"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Holographic Sweeping Scanning Line -->
                                <Border Width="230" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/>
                                            <GradientStop Color="#00000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ScannerLineTrans" Y="-110"/>
                                    </Border.RenderTransform>
                                </Border>

                                <helpers:RadialGauge Value="{Binding TrustScoreIndex}" 
                                                   Stroke="{Binding TrustLevel, Converter={StaticResource TrustLevelToBrushConverter}}"
                                                   GlowColor="{Binding TrustLevel, Converter={StaticResource TrustLevelToColorConverter}}"
                                                   StrokeThickness="18" Width="200" Height="200">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TrustScoreIndex}" FontSize="64" FontWeight="Black" Foreground="White" HorizontalAlignment="Center">
                                            <TextBlock.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" Opacity="0"/></TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="TRUST INDEX" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8"/>
                                    </StackPanel>
                                </helpers:RadialGauge>
                            </Grid>

                            <!-- Status Logic -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="35,0,0,0">
                                <TextBlock Text="SYSTEM PULSE" Style="{StaticResource Caption}" Margin="0,0,0,15" Opacity="0.7"/>
                                <TextBlock Text="{Binding SystemStatusText}" FontSize="48" FontWeight="Black" Foreground="White">
                                    <TextBlock.Effect><DropShadowEffect BlurRadius="0" Opacity="0"/></TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="{Binding SystemStatusExplanation}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" TextWrapping="Wrap" Margin="0,15,0,0" LineHeight="24" Opacity="0.9"/>
                                
                                <Button Command="{Binding ShowTrustDetailsCommand}" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Margin="0,25,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="VIEW ANALYTIC BRIEF" FontSize="11" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                                        <fa:ImageAwesome Icon="ArrowRight" Width="10" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Findings Stack -->
                    <TextBlock Text="ACTIVE FINDINGS" Style="{StaticResource Caption}" Margin="10,0,0,15" Opacity="0.6"/>
                    <ItemsControl ItemsSource="{Binding RootCauses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#08FFFFFF" Padding="25" Margin="0,0,0,15" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Icon="InfoCircle" Width="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,25,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Issue}" FontWeight="Black" FontSize="18" Foreground="White" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Explanation.PlainLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="14" Opacity="0.8" LineHeight="20"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- B. Identity & Utilities (Side Rail Content) -->
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="SYSTEM IDENTITY" Style="{StaticResource Caption}" Margin="10,0,0,15" Opacity="0.6"/>
                    <Border Style="{StaticResource StandardCard}" Padding="30" Margin="0,0,0,25">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Processor" Style="{StaticResource Caption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding CpuName}" HorizontalAlignment="Right" FontWeight="Black" FontSize="12" Foreground="White" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Architecture" Style="{StaticResource Caption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding OsVersion}" HorizontalAlignment="Right" FontWeight="Black" FontSize="12" Foreground="White" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Border Background="{DynamicResource BorderBrush}" Height="1" Opacity="0.2" Margin="0,5,0,20"/>
                            <Grid>
                                <TextBlock Text="Secure Boot" Style="{StaticResource Caption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding SecureBootStatus}" HorizontalAlignment="Right" FontWeight="Black" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="BASELINE ALIGNMENT" Style="{StaticResource Caption}" Margin="10,10,0,15" Opacity="0.6"/>
                    <Border Style="{StaticResource StandardCard}" Padding="30" Margin="0,0,0,25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Registry Configuration" Style="{StaticResource Caption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding DriftCount, StringFormat='{}{0} Anomalies Detected'}" FontWeight="Black" FontSize="14" Foreground="White" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding DriftPercentage, StringFormat='{}{0:F0}% Aligned'}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RealignSystemCommand}" Style="{StaticResource IconButton}" VerticalAlignment="Center">
                                <fa:ImageAwesome Icon="ArrowRight" Width="14" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="RAPID MAINTENANCE" Style="{StaticResource Caption}" Margin="10,10,0,15" Opacity="0.6"/>
                    <UniformGrid Columns="1">
                        <Button Command="{Binding CleanTempCommand}" Style="{StaticResource PrimaryAction}" Margin="0,0,0,12" Height="60">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="TrashOutline" Width="14" Foreground="White" Margin="0,0,15,0"/>
                                <TextBlock Text="OPTIMIZE STORAGE" FontWeight="Black" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DataContext.PurgeRAMCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryAction}" Background="Transparent" Height="60">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Leaf" Width="14" Foreground="White" Margin="0,0,15,0"/>
                                <TextBlock Text="PURGE MEMORY" FontWeight="Black" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 2. LIST / TELEMETRY DASHBOARD -->
        <DataTemplate x:Key="ListLayoutTemplate">
            <StackPanel Margin="10,0">
                <TextBlock Text="SYSTEM TELEMETRY SUMMARY" Style="{StaticResource Caption}" Margin="10,0,0,15" Opacity="0.6"/>
                
                <!-- Table-like List Container -->
                <Border Style="{StaticResource StandardCard}" Padding="10">
                    <StackPanel>
                        <!-- Row 1: Trust Score -->
                        <Border Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="#02FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="SECURITY &amp; TRUST INDEX" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="Overall System Integrity" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="Score: " FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TrustScoreIndex}" FontSize="18" FontWeight="Black" Foreground="{Binding TrustLevel, Converter={StaticResource TrustLevelToBrushConverter}}" Margin="5,0,20,0"/>
                                    <TextBlock Text="{Binding TrustScoreExplanation}" FontSize="12" Foreground="White" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding ShowTrustDetailsCommand}" Style="{StaticResource PrimaryAction}" Height="35" HorizontalAlignment="Right" Content="VIEW DETAILS"/>
                            </Grid>
                        </Border>

                        <!-- Row 2: Processor -->
                        <Border Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="#02FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="PROCESSOR (CPU)" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="Hardware Telemetry" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CpuName}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="SENSOR ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row 3: Graphics Engine -->
                        <Border Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="#02FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="GRAPHICS (GPU)" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="Visual Co-processor" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding GpuName}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="SENSOR ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row 4: Memory -->
                        <Border Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="#02FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="MEMORY (RAM)" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="System Allocation" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding RamTotal}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Command="{Binding DataContext.PurgeRAMCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryAction}" Height="35" HorizontalAlignment="Right" Content="PURGE MEMORY"/>
                            </Grid>
                        </Border>

                        <!-- Row 5: Operating System -->
                        <Border Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="#02FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="OPERATING SYSTEM" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="OS Kernel &amp; Environment" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OsVersion}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Command="{Binding CleanTempCommand}" Style="{StaticResource PrimaryAction}" Height="35" HorizontalAlignment="Right" Content="CLEAN TEMP"/>
                            </Grid>
                        </Border>

                        <!-- Row 6: Secure Boot Status -->
                        <Border Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="#02FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="SECURE BOOT" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="Platform Boot Security" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SecureBootStatus}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="SECURE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Row 7: Registry Baseline Drift -->
                        <Border Padding="15" Background="#02FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="REGISTRY BASELINE" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="Configuration Alignment" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="{Binding DriftPercentage, StringFormat='{}{0:F0}% Aligned'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="{Binding DriftCount, StringFormat='({0} Drifted)'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding RealignSystemCommand}" Style="{StaticResource PrimaryAction}" Height="35" HorizontalAlignment="Right" Content="AUDIT DRIFT"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Findings List in Telemetry Mode -->
                <TextBlock Text="ACTIVE FINDINGS" Style="{StaticResource Caption}" Margin="10,25,0,15" Opacity="0.6"/>
                <ItemsControl ItemsSource="{Binding RootCauses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#08FFFFFF" Padding="15" Margin="0,0,0,10" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <fa:ImageAwesome Icon="InfoCircle" Width="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Issue}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                        <TextBlock Text="{Binding Explanation.PlainLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Main Content (HCI: Visibility of System Status) -->
        <Border Padding="30" Visibility="{Binding HasError, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 1. Header -->
                        <RowDefinition Height="*"/>    <!-- 2. Main Spatial Workspace -->
                    </Grid.RowDefinitions>

                    <!-- 1. Header Section (Breadcrumbs) -->
                    <StackPanel Grid.Row="0" Margin="10,0,10,30" Style="{StaticResource ModuleHeaderStyle}">
                        <TextBlock Text="WORKSPACE › NEURAL ANALYTICS DASHBOARD" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <TextBlock Text="Spatial Intelligence" Style="{StaticResource H1}" Margin="0" FontSize="36" FontWeight="Black"/>
                            
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <!-- Dynamic Layout Toggle Button (Grid Mode Active -> Switch to List) -->
                                <Button Command="{Binding ToggleLayoutModeCommand}" Margin="0,0,10,0" ToolTip="Switch to List Layout">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentLayoutMode}" Value="{x:Static m:DashboardLayoutMode.Grid}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <fa:ImageAwesome Icon="ThList" Width="14" Foreground="{DynamicResource AccentBrush}"/>
                                </Button>

                                <!-- Dynamic Layout Toggle Button (List Mode Active -> Switch to Grid) -->
                                <Button Command="{Binding ToggleLayoutModeCommand}" Margin="0,0,10,0" ToolTip="Switch to Grid Layout">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentLayoutMode}" Value="{x:Static m:DashboardLayoutMode.List}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <fa:ImageAwesome Icon="Th" Width="14" Foreground="{DynamicResource AccentBrush}"/>
                                </Button>

                                <Button Command="{Binding RefreshSystemCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh Workspace">
                                    <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource AccentBrush}" Spin="{Binding IsBusy}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 2. Main Workspace Switcher -->
                    <ContentControl Grid.Row="1" Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource GridLayoutTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLayoutMode}" Value="{x:Static m:DashboardLayoutMode.List}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ListLayoutTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Loading Feedback (Spatial Blur Overlay) -->
        <Border Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <Border.Effect><BlurEffect Radius="20"/></Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,25"/>
