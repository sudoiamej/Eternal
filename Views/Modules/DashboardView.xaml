<UserControl x:Class="Eternal.Views.Modules.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             xmlns:m="clr-namespace:Eternal.Models"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid>
        <!-- Main Content (HCI Rule 7: Visibility of System Status) -->
        <Border Padding="40" Visibility="{Binding HasError, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 1. Navigation & Header -->
                        <RowDefinition Height="Auto"/> <!-- 2. Primary Focal Point (The Pulse) -->
                        <RowDefinition Height="*"/>    <!-- 3. Intelligence & Platform Details -->
                        <RowDefinition Height="Auto"/> <!-- 4. Toolkit Sections (Progressive Disclosure) -->
                    </Grid.RowDefinitions>

                    <!-- 1. Header Section -->
                    <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                        <TextBlock Text="ETERNAL › SYSTEM OVERVIEW" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Intelligence Dashboard" Style="{StaticResource H1}" Margin="0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="Help" Style="{StaticResource IconButton}" ToolTip="Open Knowledge Base" Margin="0,0,10,0">
                                    <fa:ImageAwesome Icon="QuestionCircleOutline" Width="14" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                </Button>
                                <Button Command="{Binding RefreshSystemCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" ToolTip="Refresh System Data">
                                    <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                </Button>
                                <Button Command="{Binding CleanTempCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" ToolTip="Clear Temporary Files" Margin="10,0,0,0">
                                    <fa:ImageAwesome Icon="TrashOutline" Width="14" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 2. Primary Focal Point: System Pulse (HCI Rule 1 & 2: Affordance & Signifiers) -->
                    <Button Grid.Row="1" Command="{Binding ShowTrustDetailsCommand}" Margin="0,0,0,30" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="PulseBorder" Padding="30" BorderThickness="1" Cursor="Hand" CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StandardCard}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static m:TrustLevel.Warning}">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static m:TrustLevel.Critical}">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0FFFFFFF"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM PULSE" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SystemStatusText}" FontSize="28" FontWeight="Black">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighestSeverity}" Value="{x:Static m:SeverityLevel.Medium}">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HighestSeverity}" Value="{x:Static m:SeverityLevel.High}">
                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HighestSeverity}" Value="{x:Static m:SeverityLevel.Critical}">
                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding SystemStatusExplanation}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" MaxWidth="450" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Separator Grid.Column="1" Width="1" Margin="40,10" Background="{DynamicResource BorderBrush}"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="TRUST INDEX" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TrustScoreIndex}" FontSize="42" FontWeight="Black">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static m:TrustLevel.Warning}">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrustLevel}" Value="{x:Static m:TrustLevel.Critical}">
                                                        <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="/100" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="5,0,0,10"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TrustScoreExplanation}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextAlignment="Right" MaxWidth="220" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 3. Intelligence & Platform Details (HCI Rule 4: Mapping) -->
                    <Grid Grid.Row="2" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- Intelligence Findings -->
                        <StackPanel Grid.Column="0" Margin="0,0,30,0">
                            <TextBlock Text="INTELLIGENCE FINDINGS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                <ItemsControl ItemsSource="{Binding RootCauses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBrush}" Padding="20" Margin="0,0,0,12" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <fa:ImageAwesome Grid.Column="0" Icon="ExclamationTriangle" Width="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,4,15,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                                            <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0"/>
                                                            <TextBlock Text="{Binding Component}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Explanation.PlainLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
                                                        <TextBlock Text="{Binding Explanation.TechnicalValue}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border Background="#104CAF50" Padding="20" CornerRadius="6" 
                                    Visibility="{Binding RootCauses.Count, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="CheckCircle" Width="16" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,15,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="Intelligence engine reports all system parameters within optimal thresholds." 
                                               Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- System Identity Card -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SYSTEM IDENTITY" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <Border Style="{StaticResource StandardCard}" Padding="25">
                                <StackPanel>
                                    <Grid Margin="0,0,0,18">
                                        <TextBlock Text="Architecture" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CpuName}" HorizontalAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
                                        <TextBlock Text="Total Memory" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding RamTotal}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,18"/>
                                    <Grid Margin="0,0,0,18">
                                        <TextBlock Text="OS Version" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding OsVersion}" HorizontalAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Secure Boot" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SecureBootStatus}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <Button Command="{Binding ExportBriefCommand}" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" HorizontalAlignment="Right" Padding="15,8" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="FileTextOutline" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="Export Brief Intelligence Report" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 4. Toolkit Sections (HCI Rule 6: Conceptual Model Clarity) -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Workflow & Dev Preview Toolkit -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="DEV PREVIEW SUITE &amp; WORKFLOW" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <Border Style="{StaticResource StandardCard}" Padding="20">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding DataContext.IsDevModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Command="{Binding DataContext.ToggleDevModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Content="Enable System Developer Mode (Long Paths/Symlinks)" 
                                              FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                                    
                                    <CheckBox IsChecked="{Binding DataContext.IsDevHostEnabled, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Command="{Binding DataContext.ToggleDevHostCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Content="Map dev.local to 127.0.0.1 (Hosts File)" 
                                              FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20"/>
                                    
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding DataContext.ApplySilenceProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StandardButton}" Margin="0,0,5,0">
                                            <StackPanel Orientation="Horizontal">
                                                <fa:ImageAwesome Icon="VolumeOff" Width="12" Foreground="#FFFFFF" Margin="0,0,8,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                                <TextBlock Text="Silence Profile" FontSize="11" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding DataContext.ForceKillHandleCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StandardButton}" Background="#333333" Margin="5,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <fa:ImageAwesome Icon="Bomb" Width="12" Foreground="#FFFFFF" Margin="0,0,8,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                                <TextBlock Text="Force Kill Handle" FontSize="11" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Button Command="{Binding DataContext.PurgeRAMCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StandardButton}" Background="#16a085" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="Leaf" Width="12" Foreground="#FFFFFF" Margin="0,0,8,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                            <TextBlock Text="Purge Standby List &amp; RAM" FontSize="11" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Security & Persistence Toolkit -->
                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                            <TextBlock Text="SECURITY &amp; THREAT HUNTER" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <Border Style="{StaticResource StandardCard}" Padding="20">
                                <StackPanel>
                                    <Button Command="{Binding DataContext.ScanMalwarePersistenceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StandardButton}" Background="#c0392b" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="Shield" Width="12" Foreground="#FFFFFF" Margin="0,0,8,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                            <TextBlock Text="Scan for Persistence &amp; Malware" FontSize="11" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>

                                    <CheckBox IsChecked="{Binding DataContext.IsRansomGuardEnabled, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Command="{Binding DataContext.ToggleRansomGuardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Content="Active Ransom Guard (Protected Docs)" 
                                              FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="SUSPICIOUS PROCESSES" FontSize="9" FontWeight="Black" Foreground="{DynamicResource CriticalBrush}" Margin="0,5,0,10"
                                               Visibility="{Binding DataContext.UnsignedProcesses.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibilityConverter}}"/>
                                    
                                    <ItemsControl ItemsSource="{Binding DataContext.UnsignedProcesses, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15F44336" Padding="10" Margin="0,0,0,8" CornerRadius="4" BorderBrush="#30F44336" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F44336" FontSize="11"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Command="{Binding DataContext.NeutralizeProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding PID}" Style="{StaticResource IconButton}" ToolTip="Kill Process">
                                                            <fa:ImageAwesome Icon="Times" Width="10" Foreground="#F44336"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Error Recovery (HCI Rule 8) -->
        <helpers:ErrorCard HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource VisibilityConverter}}"
                           MaxWidth="500">
            <helpers:ErrorCard.DataContext>
                <Binding Path="." />
            </helpers:ErrorCard.DataContext>
        </helpers:ErrorCard>

        <!-- Feedback Overlay -->
        <Border Background="#CC0A0A0A" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                <TextBlock Text="Synchronizing Intelligence Engine..." FontSize="18" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>




