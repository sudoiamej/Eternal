<UserControl x:Class="Eternal.Views.Modules.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:m="clr-namespace:Eternal.Models"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="800">
    <Border Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Style="{StaticResource ModuleHeaderStyle}"><TextBlock Text="ETERNAL › SYSTEM INTELLIGENCE" Style="{StaticResource HeaderBreadcrumb}"/><TextBlock Text="Application Settings" Style="{StaticResource H1}" Margin="0"/></StackPanel>

                <!-- 0. Appearance & Theme -->
                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE &amp; THEME" Style="{StaticResource Caption}" Margin="0,0,0,20"/>

                        <!-- Interface Theme Selector (Global) -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Interface Theme" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Select a global visual style (choose 'CarPlay' for Apple CarPlay minimalist black)." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox SelectedValue="{Binding SelectedTheme}" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <system:String>NeumorphicDark</system:String>
                                <system:String>CarPlay</system:String>
                            </ComboBox>
                        </Grid>

                        <!-- Modern Gradiency Selector -->
                        <Grid Margin="0,0,0,20">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.UseLegacyUI}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="CarPlay">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel>
                                <TextBlock Text="Modern Background Gradiency" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Select a neural background profile for the modern workspace." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox SelectedValue="{Binding SelectedGradiency}" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <system:String>Deep Space</system:String>
                                <system:String>Nebula</system:String>
                                <system:String>Aurora</system:String>
                                <system:String>Crimson Flow</system:String>
                            </ComboBox>
                        </Grid>

                        <!-- System Accent Color (Hidden for CarPlay monochrome style) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="CarPlay">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <TextBlock Text="System Accent Color" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="Choose a primary color for the application interface." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15"/>

                            <UniformGrid Columns="8" HorizontalAlignment="Left">
                                <Button Style="{StaticResource IconButton}" Padding="5" Command="{Binding SetThemeColorCommand}" CommandParameter="#9B59B6">
                                    <Border Width="20" Height="20" Background="#9B59B6" CornerRadius="10"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5" Command="{Binding SetThemeColorCommand}" CommandParameter="#3498DB">
                                    <Border Width="20" Height="20" Background="#3498DB" CornerRadius="10"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5" Command="{Binding SetThemeColorCommand}" CommandParameter="#2ECC71">
                                    <Border Width="20" Height="20" Background="#2ECC71" CornerRadius="10"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5" Command="{Binding SetThemeColorCommand}" CommandParameter="#E74C3C">
                                    <Border Width="20" Height="20" Background="#E74C3C" CornerRadius="10"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5" Command="{Binding SetThemeColorCommand}" CommandParameter="#F1C40F">
                                    <Border Width="20" Height="20" Background="#F1C40F" CornerRadius="10"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5" Command="{Binding SetThemeColorCommand}" CommandParameter="#E67E22">
                                    <Border Width="20" Height="20" Background="#E67E22" CornerRadius="10"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5" Command="{Binding SetThemeColorCommand}" CommandParameter="#1ABC9C">
                                    <Border Width="20" Height="20" Background="#1ABC9C" CornerRadius="10"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5" Command="{Binding SetThemeColorCommand}" CommandParameter="#607D8B">
                                    <Border Width="20" Height="20" Background="#607D8B" CornerRadius="10"/>
                                </Button>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Font Size Adjustment Setting -->
                        <Grid Margin="0,20,0,10">
                            <StackPanel>
                                <TextBlock Text="Font Sizing Scale" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Scale application typography size dynamically." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Slider Value="{Binding SelectedFontScale}" Minimum="1.0" Maximum="1.5" Width="100" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedFontScale, StringFormat='{}{0:F2}x'}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Width="35"/>
                            </StackPanel>
                        </Grid>

                        <!-- Window / DPI Scaling Setting -->
                        <Grid Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Window DPI Scale" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Adjust global workspace display layout scaling." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Slider Value="{Binding SelectedWindowScale}" Minimum="1.0" Maximum="1.6" Width="100" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedWindowScale, StringFormat='{}{0:F2}x'}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Width="35"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dashboard Layout Mode Setting -->
                        <Grid Margin="0,20,0,10">
                            <StackPanel>
                                <TextBlock Text="Dashboard Layout Mode" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Choose preferred visualization layout for system dashboard." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox SelectedItem="{Binding SelectedDashboardLayoutMode}" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <m:DashboardLayoutMode>Grid</m:DashboardLayoutMode>
                                <m:DashboardLayoutMode>List</m:DashboardLayoutMode>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 1. Telemetry & Performance -->
                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="TELEMETRY &amp; PERFORMANCE" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                        
                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Run at Windows Startup" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Automatically launch Eternal when you sign in." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ModernSwitch}" IsChecked="{Binding Settings.RunAtStartup}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Minimize to System Tray" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Keep the app running in the background when closed." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ModernSwitch}" IsChecked="{Binding Settings.MinimizeToTray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Telemetry Polling Profile" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Optimize sensor updates for battery or accuracy." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox SelectedValue="{Binding Settings.PollingProfile}" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <system:String>Balanced</system:String>
                                <system:String>High</system:String>
                                <system:String>PowerSaver</system:String>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Refresh Frequency" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Set interval for live telemetry updates (seconds)." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Slider Value="{Binding Settings.RefreshFrequency}" Minimum="1" Maximum="10" Width="100" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Settings.RefreshFrequency, StringFormat='{}{0}s'}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Width="25"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Data & Privacy -->
                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="DATA &amp; PRIVACY" Style="{StaticResource Caption}" Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Intelligence Export Path" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Default folder for saving intelligence reports (.json)." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.ExportFolderPath}" IsReadOnly="True" Background="#0DFFFFFF" BorderBrush="{DynamicResource BorderBrush}" Padding="8,5" Foreground="{DynamicResource TextBrush}"/>
                                <Button Grid.Column="1" Command="{Binding SelectExportFolderCommand}" Content="Browse" Margin="8,0,0,0" Padding="15,0" Style="{StaticResource PrimaryAction}"/>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="WMI Query Timeout" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Seconds to wait for low-level system responses." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Slider Value="{Binding Settings.WmiTimeoutSeconds}" Minimum="2" Maximum="30" Width="100" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Settings.WmiTimeoutSeconds, StringFormat='{}{0}s'}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Width="25"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Verbose Session Logging" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Capture detailed app actions in the 'System Logs' tab." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ModernSwitch}" IsChecked="{Binding Settings.IsVerboseLoggingEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Intelligence Mode -->
                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="CORE INTELLIGENCE" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                        
                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Advanced Intelligence Mode" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Enables deep telemetry and raw system identifiers." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ModernSwitch}" IsChecked="{Binding Settings.IsAdvancedMode}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Preload Data on Startup" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Loads system metrics in background during app launch." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ModernSwitch}" IsChecked="{Binding Settings.PreloadOnStartup}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. App Updates -->
                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="APP UPDATES" Style="{StaticResource Caption}" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Automatic Update Checks" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Automatically check for new versions on app startup." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ModernSwitch}" IsChecked="{Binding Settings.IsAutoUpdateEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding CheckForUpdatesCommand}" Content="Check for Updates" Style="{StaticResource PrimaryAction}" Padding="15,8"/>
                            <TextBlock Text="{Binding Settings.LastUpdateCheck, StringFormat='Last checked: {0:g}'}" 
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. Security & Locks -->
                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="SECURITY &amp; LOCKS" Style="{StaticResource Caption}" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Startup Entry Lock" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Require a 6-digit access code when the application starts." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ModernSwitch}" IsChecked="{Binding Settings.IsStartupLockEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding ChangeStartupPinCommand}" Content="Change Access Code" Style="{StaticResource SecondaryButton}" Padding="15,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About Section -->
                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="ABOUT ETERNAL" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                        <Grid>
                            <StackPanel>
                                <Button Command="{Binding VersionClickedCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0" Margin="0">
                                    <TextBlock Text="{Binding AppVersion, StringFormat='Version: {0}'}" FontWeight="Bold" Foreground="White"/>
                                </Button>
                                <TextBlock Text="Compatible with: Windows 10 &amp; 11 (64-bit)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="MACHINE FINGERPRINT" Style="{StaticResource Caption}" FontSize="8" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding MachineId}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}" Style="{StaticResource IconButton}" Padding="20,10" Margin="0,0,10,0"/>
                    <Button Command="{Binding ClearAllDataCommand}" Style="{StaticResource IconButton}" Padding="20,10" Margin="0,0,10,0" BorderBrush="{DynamicResource CriticalBrush}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Trash" Width="12" Margin="0,0,10,0" Foreground="{DynamicResource CriticalBrush}"/>
                            <TextBlock Text="Reset All Application Data" Foreground="{DynamicResource CriticalBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveConfigCommand}" Style="{StaticResource PrimaryAction}" Padding="25,10">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Save" Width="12" Margin="0,0,10,0" Foreground="White"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            <TextBlock Text="COMMIT SETTINGS" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>




