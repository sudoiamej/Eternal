<UserControl x:Class="Eternal.Views.Modules.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100">
    <Border Padding="40">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                <StackPanel>
                    <TextBlock Text="ETERNAL › SECURITY FORENSICS" Style="{StaticResource HeaderBreadcrumb}"/>
                    <TextBlock Text="Sentinel Privacy Audit" Style="{StaticResource H1}" Margin="0"/>
                </StackPanel>
                
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Command="{Binding LoadCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh Audit" Margin="0,0,10,0">
                        <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsBusy}"/>
                    </Button>
                    <Button Command="{Binding ApplyAllCommand}" Content="HARDEN SYSTEM" Style="{StaticResource PrimaryButton}" Padding="20,8" Background="{DynamicResource CriticalBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Score & Telemetry Purger Summary -->
            <Grid Grid.Row="1" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: Privacy Score -->
                <Border Grid.Column="0" Style="{StaticResource StandardCard}" Margin="0,0,10,0">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <helpers:RadialGauge Value="{Binding PrivacyScore}" Width="110" Height="110" StrokeThickness="8" Stroke="{DynamicResource AccentBrush}" GlowColor="{DynamicResource AccentColor}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PrivacyScore}" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="INDEX" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                            </StackPanel>
                        </helpers:RadialGauge>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                            <TextBlock Text="PRIVACY STATUS" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding ScoreStatus}" FontSize="24" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="Alignment of Windows telemetry and app permission policies with the Eternal Sentinel privacy baseline." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Card: Telemetry Cleanser -->
                <Border Grid.Column="1" Style="{StaticResource StandardCard}" Margin="10,0,0,0">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <helpers:RadialGauge Value="{Binding CleanserProgress}" Width="110" Height="110" StrokeThickness="8" Stroke="{DynamicResource InfoBrush}" GlowColor="{DynamicResource InfoColor}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CleanserProgress, StringFormat='{}{0:0}%'}" FontSize="24" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="PROGRESS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                            </StackPanel>
                        </helpers:RadialGauge>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                            <TextBlock Text="TELEMETRY PURGER" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                            <Button Command="{Binding ClearTelemetryCacheCommand}" Content="CLEANSE TELEMETRY" Style="{StaticResource PrimaryButton}" 
                                    Background="{DynamicResource InfoBrush}" Foreground="White" Padding="12,6" Height="28" Margin="0,5,0,0"
                                    IsEnabled="{Binding IsCleansing, Converter={StaticResource InvertBooleanConverter}}"/>
                            <TextBlock Text="Wipes diagnostic trace logs (.etl) in ProgramData to minimize passive telemetry data collection." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="14"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Policies List -->
            <Border Grid.Row="2" Style="{StaticResource StandardCard}" Padding="0">
                <DataGrid ItemsSource="{Binding Policies}" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent" GridLinesVisibility="None"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STATE" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <fa:ImageAwesome Icon="{Binding IsHardened, Converter={StaticResource BooleanToIconConverter}, ConverterParameter='CheckCircle:TimesCircle'}" 
                                                     Width="16" HorizontalAlignment="Center">
                                        <fa:ImageAwesome.Style>
                                            <Style TargetType="fa:ImageAwesome">
                                                <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHardened}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </fa:ImageAwesome.Style>
                                    </fa:ImageAwesome>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="POLICY" Binding="{Binding Name}" Width="200" FontWeight="Bold"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="ACTION" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.TogglePolicyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Style="{StaticResource IconButton}">
                                        <TextBlock Text="{Binding IsHardened, Converter={StaticResource BooleanToStatusConverter}, ConverterParameter='Restore:Harden'}" 
                                                   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</UserControl>
