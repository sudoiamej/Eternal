<UserControl x:Class="Eternal.Views.Modules.BootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Border Padding="40">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                        <TextBlock Text="BOOT ARCHITECTURE" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Text="Boot Records" Style="{StaticResource H1}" Margin="0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LoadCommand}" Style="{StaticResource IconButton}" VerticalAlignment="Bottom">
                    <fa:ImageAwesome Icon="Refresh" Width="16" Foreground="{StaticResource TextSecondaryBrush}" Spin="{Binding IsBusy}"/>
                </Button>
            </Grid>

            <!-- 2. Records List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Records}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StandardCard}" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Indicator Icon -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#10FFFFFF" Margin="0,0,20,0">
                                        <Grid>
                                            <fa:ImageAwesome Icon="ExternalLink" Width="16" Foreground="{StaticResource InfoBrush}" Visibility="{Binding IsBootManager, Converter={StaticResource VisibilityConverter}}"/>
                                            <fa:ImageAwesome Icon="CheckCircle" Width="16" Foreground="{StaticResource SuccessBrush}" Visibility="{Binding IsCurrent, Converter={StaticResource VisibilityConverter}}"/>
                                            <fa:ImageAwesome Icon="HddOutline" Width="16" Foreground="{StaticResource TextSecondaryBrush}" 
                                                           Visibility="{Binding IsBootManager, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                            <Border Background="#20FFFFFF" CornerRadius="2" Padding="4,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Identifier}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                            </Border>
                                        </StackPanel>

                                        <UniformGrid Columns="2" Margin="0,15,0,0">
                                            <StackPanel Margin="0,0,10,10">
                                                <TextBlock Text="DEVICE / PATH" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding Device}" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,10">
                                                <TextBlock Text="OS ARCHITECTURE" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding OsDevice}" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="{Binding SystemRoot}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="RESUME OBJECT" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding ResumeObject}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="BOOT POLICY" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding BootMenuPolicy}" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="{Binding Nx, StringFormat='NX: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
