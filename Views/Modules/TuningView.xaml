<UserControl x:Class="Eternal.Views.Modules.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1000">

    <Grid>
        <Border Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 1. Header -->
                    <RowDefinition Height="Auto"/> <!-- 2. Safety Vault -->
                    <RowDefinition Height="*"/>    <!-- 3. Tweak Grid -->
                    <RowDefinition Height="Auto"/> <!-- 4. Modern Status Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Header (HCI Rule 7: Visibility of System Status) -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="GUARDIAN TUNING" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="Performance &amp; Privacy" Style="{StaticResource H1}" Margin="0"/>
                    </StackPanel>
                    
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Command="{Binding LoadTweaksCommand}" Style="{StaticResource IconButton}" ToolTip="Re-analyze System" Margin="0,0,15,0">
                            <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Safety Vault (HCI Rule 5 & 8: Constraints & Error Prevention) -->
                <Border Grid.Row="1" Margin="0,0,0,30" BorderThickness="1" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.05"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="Restore point created successfully.">
                                    <Setter Property="Background" Value="#104CAF50"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        
                            <Border Grid.Column="0" Background="#15FFFFFF" Padding="12" CornerRadius="6" Margin="0,0,20,0">
                                <fa:ImageAwesome Icon="Shield" Width="20" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM PROTECTION PROTOCOL" FontWeight="Black" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="It is highly recommended to establish a Restore Point before applying low-level registry modifications." 
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="2" Command="{Binding CreateRestorePointCommand}" Style="{StaticResource PrimaryAction}" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Magic" Width="12" Margin="0,0,10,0" Foreground="White"/>
                                    <TextBlock Text="INITIALIZE SAFETY SNAPSHOT" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <!-- 3. Tweak Grid (UX: Visual Hierarchy & Mapping) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tweaks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,15,15" CornerRadius="8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StandardCard}">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="Background" Value="#054CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border Padding="25">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                        
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <fa:ImageAwesome Icon="Magic" Width="12" Foreground="{StaticResource AccentSecondaryBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Category, FallbackValue='OPTIMIZATION'}" Style="{StaticResource Caption}" Foreground="{StaticResource AccentSecondaryBrush}"/>
                                                </StackPanel>
                                            
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="White" Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                            </StackPanel>

                                            <!-- Toggle Affordance (HCI Rule 3: Feedback) -->
                                            <Button Grid.Column="1" Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                    CommandParameter="{Binding}" VerticalAlignment="Center" Margin="20,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Width" Value="110"/>
                                                        <Setter Property="Height" Value="42"/>
                                                        <Setter Property="Content" Value="OPTIMIZE"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                                <Setter Property="Content" Value="REVERT"/>
                                                                <Setter Property="Background" Value="#30FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. Status Bar -->
                <Border Grid.Row="3" Background="#0DFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15,12" Margin="0,20,0,0" CornerRadius="6">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="InfoCircle" Width="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                        <fa:ImageAwesome Icon="Spinner" Spin="{Binding IsBusy}" Width="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
