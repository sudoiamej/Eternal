<UserControl x:Class="Eternal.Views.Modules.PEModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <Border Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Content Area -->
                </Grid.RowDefinitions>

                <!-- 1. Unified Header (HCI Rule 9 & 18: Consistency & Safety) -->
                <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{StaticResource CriticalBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="RECOVERY &amp; EMERGENCY CONSOLE" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Medkit" Width="24" Foreground="{StaticResource CriticalBrush}" VerticalAlignment="Center" Margin="0,0,15,8"/>
                            <TextBlock Text="PE Mode Diagnostics" Style="{StaticResource H1}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding LoadDiagnosticsCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Margin="0,0,0,5" ToolTip="Rerun Hardware Scan">
                        <fa:ImageAwesome Icon="Refresh" Width="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- 2. Offline Hardware Diagnostics (HCI Rule 6: Conceptual Model) -->
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="OFFLINE HARDWARE DIAGNOSTICS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                        <Border Style="{StaticResource StandardCard}" Padding="30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="HddO" Width="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="System Drive Health" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SystemDriveStatus}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Shield" Width="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Boot Record (BCD) Integrity" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BootRecordStatus}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,25">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Microchip" Width="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Physical Memory Status" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MemoryStatus}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,20"/>
                                <TextBlock Text="Note: Diagnostics are performed using native offline calls and do not require active drivers." 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. Recovery Emergency Console (HCI Rule 18: Safety by Design) -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SYSTEM RECOVERY TOOLS" Style="{StaticResource Caption}" Margin="0,0,0,15" Foreground="{StaticResource CriticalBrush}"/>
                        <Border Style="{StaticResource StandardCard}" Padding="20" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="0,0,0,4">
                            <StackPanel>
                                <Button Command="{Binding RunRecoveryToolCommand}" CommandParameter="BCD Rebuild" 
                                        Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" HorizontalContentAlignment="Left" Padding="15" Margin="0,0,0,12" Background="#0AFFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Grid.Column="0" Icon="Wrench" Width="16" Foreground="{StaticResource CriticalBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Rebuild Boot Config (BCD)" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Fix missing or corrupt boot files." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding RunRecoveryToolCommand}" CommandParameter="SFC Scan" 
                                        Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" HorizontalContentAlignment="Left" Padding="15" Margin="0,0,0,12" Background="#0AFFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Grid.Column="0" Icon="Search" Width="16" Foreground="{StaticResource WarningBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="System File Checker" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Repair corrupt Windows system files." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding RunRecoveryToolCommand}" CommandParameter="Disk Check" 
                                        Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" HorizontalContentAlignment="Left" Padding="15" Background="#0AFFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Grid.Column="0" Icon="HddO" Width="16" Foreground="{StaticResource InfoBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Check Disk (Chkdsk)" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Scan and repair filesystem errors." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Warning: These tools can modify system state. Ensure data is backed up before execution." 
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Loading Overlay (HCI Rule 7: Status) -->
                <Border Grid.RowSpan="2" Background="#CC000000" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}" Margin="-40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{StaticResource CriticalBrush}" Width="48" Margin="0,0,0,20"/>
                        <TextBlock Text="Initializing System Recovery Console..." FontSize="18" Foreground="{StaticResource TextBrush}" FontWeight="Bold"/>
                        <TextBlock Text="Scanning hardware and boot sectors..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>

</UserControl>
