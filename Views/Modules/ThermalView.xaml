<UserControl x:Class="Eternal.Views.Modules.ThermalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1000">
    <Border Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Telemetry Grid -->
                    <RowDefinition Height="Auto"/> <!-- Details -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="THERMAL &amp; POWER" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="Thermal Intelligence" Style="{StaticResource H1}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <Button Command="{Binding LoadCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" ToolTip="Rescan Sensors">
                            <fa:ImageAwesome Icon="Refresh" Width="16" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Primary Telemetry Grid -->
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,25">
                    <!-- CPU Card -->
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,6,12" Padding="25">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="PROCESSOR TELEMETRY" Style="{StaticResource Caption}"/>
                                <fa:ImageAwesome Icon="Microchip" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            </Grid>
                            <Grid HorizontalAlignment="Center" Margin="0,10">
                                <Ellipse Width="100" Height="100" Stroke="{DynamicResource BorderBrush}" StrokeThickness="6"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CpuTempText}" FontSize="24" FontWeight="Black"/>
                                    <TextBlock Text="CORE TEMP" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Power Draw: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CpuPowerText}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Voltage: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CpuVoltageText}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GPU Card -->
                    <Border Style="{StaticResource StandardCard}" Margin="6,0,0,12" Padding="25">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="GRAPHICS TELEMETRY" Style="{StaticResource Caption}"/>
                                <fa:ImageAwesome Icon="Desktop" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            </Grid>
                            <Grid HorizontalAlignment="Center" Margin="0,10">
                                <Ellipse Width="100" Height="100" Stroke="{DynamicResource BorderBrush}" StrokeThickness="6"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding GpuTempText}" FontSize="24" FontWeight="Black"/>
                                    <TextBlock Text="GPU TEMP" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fan Speed: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FanSpeedText}" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="6,2">
                                        <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Power Architecture Card -->
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,6,0" Padding="25">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="POWER ARCHITECTURE" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                            
                            <StackPanel Visibility="{Binding Data.HasBattery, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                                <fa:ImageAwesome Icon="Plug" Width="32" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                <TextBlock Text="DIRECT AC POWER" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Desktop configuration detected" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Data.HasBattery, Converter={StaticResource VisibilityConverter}}">
                                <Grid Margin="0,0,0,10">
                                    <fa:ImageAwesome Icon="BatteryFull" Width="32" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Left"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <TextBlock Text="{Binding Data.BatteryPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Margin="40,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Data.PowerSource}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Data.BatteryStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- System Status Card -->
                    <Border Style="{StaticResource StandardCard}" Margin="6,0,0,0" Padding="25">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="THERMAL MARGIN" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <Border CornerRadius="20" Padding="20,10" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThermalStatus}" Value="WARNING">
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ThermalStatus}" Value="CRITICAL">
                                                <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ThermalStatus}" FontSize="24" FontWeight="Black">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThermalStatus}" Value="WARNING">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ThermalStatus}" Value="CRITICAL">
                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Intelligence Analysis Active" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 3. Environmental Analysis -->
                <Border Grid.Row="2" Style="{StaticResource StandardCard}" Padding="25" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="0,0,0,4" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="LightbulbOutline" Width="24" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" Margin="0,2,20,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ENVIRONMENTAL ANALYSIS" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ConclusionText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Loading Overlay -->
                <Border Grid.RowSpan="3" Background="#CC0A0A0A" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}" Margin="-40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                        <TextBlock Text="Polling Thermal Sensors..." FontSize="18" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>




