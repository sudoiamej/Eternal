<UserControl x:Class="Eternal.Views.Modules.TestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             xmlns:converters="clr-namespace:Eternal.Helpers">
    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header and Action Strip -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="FEATURE INTEGRITY SUITE" Style="{DynamicResource Header}" FontSize="24" FontWeight="Black"/>
                    <TextBlock Text="Comprehensive validation of subsystems, service health, and secure diagnostic hooks." 
                               Style="{DynamicResource Caption}" Opacity="0.6" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SidebarBrush}" CornerRadius="20" Padding="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="FeatureToggles" Style="{StaticResource IconButton}" ToolTip="Feature Toggles">
                                <fa:ImageAwesome Icon="ToggleOn" Width="14" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="Flags" Style="{StaticResource IconButton}" ToolTip="Developer Flags">
                                <fa:ImageAwesome Icon="Flag" Width="14" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,0"/>
                            <Button Command="{Binding DataContext.ToggleUICommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource IconButton}" ToolTip="Switch Shell UI">
                                <fa:ImageAwesome Icon="Exchange" Width="14" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Diagnostic Results -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-15,0" Padding="0,0,15,0">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SidebarBrush}" CornerRadius="10" Margin="0,0,0,12" Padding="25,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="#05FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Icon/Orb -->
                                    <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,25,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                        <Setter Property="Background" Value="#4CAF50"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#4CAF50" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource CriticalColor}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{DynamicResource CriticalColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Information -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FeatureName}" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{Binding Message}" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Status Pill -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="20,0" Padding="12,4" CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                        <Setter Property="Background" Value="#154CAF50"/>
                                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                                        <Setter Property="Background" Value="#15FF5252"/>
                                                        <Setter Property="BorderBrush" Value="#FF5252"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="Black">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                            <Setter Property="Text" Value="PASS"/>
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                                            <Setter Property="Text" Value="FAIL"/>
                                                            <Setter Property="Foreground" Value="#FF5252"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Latency Metric -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.4">
                                        <TextBlock Text="LATENCY" FontSize="8" FontWeight="Black" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Latency}" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Execution Layer -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,20,0,0">
                <Grid>
                    <TextBlock Text="INTEGRITY POLLING ACTIVE" VerticalAlignment="Center" FontWeight="Black" FontSize="11" Opacity="0.4"
                               Visibility="{Binding IsTesting, Converter={StaticResource VisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.1" To="0.5" Duration="0:0:0.8" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding RunDiagnosticsCommand}" Style="{DynamicResource PrimaryButton}" 
                            Content="RUN SYSTEM DIAGNOSTIC" Height="45" Width="220" HorizontalAlignment="Right">
                        <Button.IsEnabled>
                            <Binding Path="IsTesting" Converter="{StaticResource InvertBooleanConverter}"/>
                        </Button.IsEnabled>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Loading Backdrop -->
            <Border Grid.RowSpan="3" Background="#990A0A10" CornerRadius="12" Visibility="{Binding IsTesting, Converter={StaticResource VisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <StackPanel.Resources>
                            <Style TargetType="Ellipse">
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="Height" Value="8"/>
                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Margin" Value="4,0"/>
                                <Setter Property="Opacity" Value="0.3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Ellipse>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" BeginTime="0:0:0.4" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </StackPanel>
                    <TextBlock Text="VALIDATING SUBSYSTEMS" FontWeight="Black" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>