<UserControl x:Class="Eternal.Views.Modules.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Spatial Entrance Animation -->
        <Storyboard x:Key="EntranceAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Border Padding="35">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Header Section -->
                    <StackPanel Style="{StaticResource ModuleHeaderStyle}" Margin="0,0,0,35">
                        <TextBlock Text="ETERNAL › CONNECTIVITY ARCHITECTURE" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <TextBlock Text="Network Intelligence" Style="{StaticResource H1}" Margin="0" FontSize="32" FontWeight="Black"/>
                            
                            <Button HorizontalAlignment="Right" Command="{Binding LoadCommand}" 
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" 
                                    Style="{StaticResource IconButton}" ToolTip="Scan Network Map">
                                <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsLoading}"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 2. Real-time Throughput (HCI: Immediate Feedback) -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StandardCard}" Margin="0,0,10,0" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="80"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <fa:ImageAwesome Icon="Download" Width="14" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="DOWNLOAD THROUGHPUT" Style="{StaticResource Caption}" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding DownloadMbps, StringFormat='{}{0:F2} Mbps'}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,0,0,20"/>
                                
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding DownloadHistory}" VerticalAlignment="Bottom" Height="80" ClipToBounds="True">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="60" Rows="1" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SuccessBrush}" Opacity="0.3" Margin="1,0" VerticalAlignment="Bottom" CornerRadius="2"
                                                    Height="{Binding Converter={StaticResource ProportionalHeightConverter}, ConverterParameter='80'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StandardCard}" Margin="10,0,0,0" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="80"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <fa:ImageAwesome Icon="Upload" Width="14" Foreground="{DynamicResource InfoBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="UPLOAD THROUGHPUT" Style="{StaticResource Caption}" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding UploadMbps, StringFormat='{}{0:F2} Mbps'}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,0,0,20"/>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding UploadHistory}" VerticalAlignment="Bottom" Height="80" ClipToBounds="True">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="60" Rows="1" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InfoBrush}" Opacity="0.3" Margin="1,0" VerticalAlignment="Bottom" CornerRadius="2"
                                                    Height="{Binding Converter={StaticResource ProportionalHeightConverter}, ConverterParameter='80'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- CarPlay/Ookla Style Speed Test Panel -->
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30" Padding="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <fa:ImageAwesome Icon="Dashboard" Width="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="INTELLIGENT SPEEDTEST" Style="{StaticResource Caption}" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock Text="Validate connection throughput against Cloudflare &amp; HTTPBin endpoints." 
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,25" TextWrapping="Wrap" LineHeight="18"/>
                                
                                <Button Content="RUN SPEEDTEST" Command="{Binding StartSpeedTestCommand}" 
                                        IsEnabled="{Binding IsSpeedTesting, Converter={StaticResource InvertBooleanConverter}}"
                                        Style="{StaticResource PrimaryButton}" Height="45" Width="180" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="30,0,0,0">
                                <!-- Speed Testing Active View -->
                                <Grid Visibility="{Binding IsSpeedTesting, Converter={StaticResource VisibilityConverter}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="36" Height="36" Margin="0,0,0,15"/>
                                        <TextBlock Text="{Binding SpeedTestPhase, StringFormat='{}Phase: {0}'}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeedTestValue, StringFormat='{}{0:F2} Mbps'}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                                        
                                        <!-- ProgressBar -->
                                        <Grid Width="250" Height="6">
                                            <Border CornerRadius="3" Background="#16FFFFFF"/>
                                            <Border CornerRadius="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="{Binding SpeedTestProgressPercentage, Converter={StaticResource SpeedTestProgressWidthConverter}, ConverterParameter='250'}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Speed Test Idle / Finished Result View -->
                                <Grid Visibility="{Binding IsSpeedTesting, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                                    <Grid Visibility="{Binding HasSpeedTestResult, Converter={StaticResource VisibilityConverter}}">
                                        <UniformGrid Columns="3" VerticalAlignment="Center">
                                            <!-- Download Result -->
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="DOWNLOAD" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ResultDownload, StringFormat='{}{0:F1}'}" FontSize="36" FontWeight="Black" Foreground="White"/>
                                                <TextBlock Text="Mbps" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            
                                            <!-- Upload Result -->
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="UPLOAD" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ResultUpload, StringFormat='{}{0:F1}'}" FontSize="36" FontWeight="Black" Foreground="White"/>
                                                <TextBlock Text="Mbps" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            
                                            <!-- Ping Result -->
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="LATENCY" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ResultPing, StringFormat='{}{0} ms'}" FontSize="36" FontWeight="Black" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="RTT" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                    
                                    <Grid Visibility="{Binding HasSpeedTestResult, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                                        <TextBlock Text="Ready to run diagnostics..." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- 3. Active Interface Cards -->
                    <TextBlock Text="HARDWARE INTERFACES" Style="{StaticResource Caption}" Margin="10,0,0,20" Opacity="0.6"/>
                    <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,0,0,30">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StandardCard}" Margin="0,0,15,15" Padding="25" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Icon="Globe" Width="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,20,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Black" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding IpAddress, StringFormat='{}IPv4: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#10FFFFFF" Padding="10,4" CornerRadius="6" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding MacAddress}" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Black"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 4. Connection Sentry (Disabled) -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay (Spatial Focus) -->
        <Border Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}">
            <Border.Effect><BlurEffect Radius="25"/></Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,25"/>
                <TextBlock Text="INTERCEPTING TRAFFIC..." FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
