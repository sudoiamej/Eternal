<UserControl x:Class="Eternal.Views.Modules.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Spatial Entrance Animation -->
        <Storyboard x:Key="EntranceAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <Border Padding="35">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 1. Header Section -->
                    <StackPanel Style="{StaticResource ModuleHeaderStyle}" Margin="0,0,0,35">
                        <TextBlock Text="ETERNAL › CONNECTIVITY ARCHITECTURE" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <TextBlock Text="Network Intelligence" Style="{StaticResource H1}" Margin="0" FontSize="32" FontWeight="Black"/>
                            
                            <Button HorizontalAlignment="Right" Command="{Binding LoadCommand}" 
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" 
                                    Style="{StaticResource IconButton}" ToolTip="Scan Network Map">
                                <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsLoading}"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 2. Real-time Throughput (HCI: Immediate Feedback) -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StandardCard}" Margin="0,0,10,0" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="80"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <fa:ImageAwesome Icon="Download" Width="14" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="DOWNLOAD THROUGHPUT" Style="{StaticResource Caption}" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding DownloadMbps, StringFormat='{}{0:F2} Mbps'}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,0,0,20"/>
                                
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding DownloadHistory}" VerticalAlignment="Bottom" Height="80" ClipToBounds="True">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="60" Rows="1" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SuccessBrush}" Opacity="0.3" Margin="1,0" VerticalAlignment="Bottom" CornerRadius="2"
                                                    Height="{Binding Converter={StaticResource ProportionalHeightConverter}, ConverterParameter='80'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StandardCard}" Margin="10,0,0,0" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="80"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <fa:ImageAwesome Icon="Upload" Width="14" Foreground="{DynamicResource InfoBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="UPLOAD THROUGHPUT" Style="{StaticResource Caption}" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding UploadMbps, StringFormat='{}{0:F2} Mbps'}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,0,0,20"/>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding UploadHistory}" VerticalAlignment="Bottom" Height="80" ClipToBounds="True">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="60" Rows="1" VerticalAlignment="Bottom"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InfoBrush}" Opacity="0.3" Margin="1,0" VerticalAlignment="Bottom" CornerRadius="2"
                                                    Height="{Binding Converter={StaticResource ProportionalHeightConverter}, ConverterParameter='80'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- 3. Active Interface Cards -->
                    <TextBlock Text="HARDWARE INTERFACES" Style="{StaticResource Caption}" Margin="10,0,0,20" Opacity="0.6"/>
                    <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,0,0,30">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StandardCard}" Margin="0,0,15,15" Padding="25" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Icon="Globe" Width="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,20,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Black" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding IpAddress, StringFormat='{}IPv4: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#10FFFFFF" Padding="10,4" CornerRadius="6" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding MacAddress}" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Black"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 4. Connection Sentry (TCP/UDP MAP) -->
                    <TextBlock Text="CONNECTION SENTRY" Style="{StaticResource Caption}" Margin="10,0,0,20" Opacity="0.6"/>
                    <Border Style="{StaticResource StandardCard}" Padding="5">
                        <DataGrid ItemsSource="{Binding Connections}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                  RowBackground="Transparent" GridLinesVisibility="None"
                                  Foreground="White" CanUserAddRows="False"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  MinHeight="400">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0DFFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="15,10"/>
                                    <Setter Property="FontWeight" Value="Black"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#08FFFFFF"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol}" Width="80">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Black"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="15,0"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="LOCAL ADDRESS" Binding="{Binding LocalAddress}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="REMOTE ADDRESS" Binding="{Binding RemoteAddress}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource AccentSecondaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="STATE" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,4" CornerRadius="8" HorizontalAlignment="Left" Margin="5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="ESTABLISHED"><Setter Property="Background" Value="#1A00FFAA"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="LISTENING"><Setter Property="Background" Value="#1A00CCFF"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Black">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="ESTABLISHED"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="LISTENING"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Black"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay (Spatial Focus) -->
        <Border Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}">
            <Border.Effect><BlurEffect Radius="25"/></Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,25"/>
                <TextBlock Text="INTERCEPTING TRAFFIC..." FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
