<UserControl x:Class="Eternal.Views.Modules.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">
    <Border Padding="40">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Header (Spans both) -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource ModuleHeaderStyle}" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                        <TextBlock Text="INTEGRATED SHELL" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Text="Eternal Console" Style="{StaticResource H1}" Margin="0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ClearConsoleCommand}" Style="{StaticResource IconButton}" VerticalAlignment="Bottom">
                    <fa:ImageAwesome Icon="Trash" Width="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- 2. Macro Sidebar -->
            <Border Grid.Row="1" Grid.Column="0" Background="#0DFFFFFF" CornerRadius="4,0,0,4" Padding="15">
                <StackPanel>
                    <TextBlock Text="DIAGNOSTIC MACROS" Style="{StaticResource Caption}" Margin="0,0,0,15" Foreground="{StaticResource AccentBrush}"/>
                    <ItemsControl ItemsSource="{Binding Macros}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RunMacroCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource IconButton}" Margin="0,0,0,10" HorizontalAlignment="Stretch" Padding="10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <fa:ImageAwesome Icon="Terminal" Width="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Terminal View -->
            <Border Grid.Row="1" Grid.Column="1" Background="#05000000" CornerRadius="0,4,4,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ConsoleOutputList" ItemsSource="{Binding OutputLines}" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="10"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#CCFFFFFF" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Border Grid.Row="1" Background="#10FFFFFF" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PS › " Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" Foreground="White"
                                     FontFamily="Consolas" VerticalAlignment="Center" CaretBrush="White" Margin="5,0,0,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendCommandCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
