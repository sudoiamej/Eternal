<UserControl x:Class="Eternal.Views.Modules.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:models="clr-namespace:Eternal.Models"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1000">
    <Grid>
        <Border Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Top Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="TERMINAL ECOSYSTEM" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="Terminal Intelligence" Style="{StaticResource H1}" Margin="0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Command="{Binding ClearConsoleCommand}" Style="{StaticResource IconButton}" ToolTip="Clear Terminal Buffer" Margin="0,0,10,0">
                            <fa:ImageAwesome Icon="Trash" Width="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Terminal Main Area (Windows Terminal ConHost Style) -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tab Strip -->
                        <RowDefinition Height="*"/>    <!-- Interactive ConHost Terminal Viewport -->
                    </Grid.RowDefinitions>

                    <!-- Windows Terminal Style Tab Bar -->
                    <Grid Grid.Row="0" Background="#111116">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabBorder" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" MinWidth="140" MaxWidth="260" Padding="14,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <fa:ImageAwesome Grid.Column="0" Icon="{Binding Icon}" Width="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <!-- Live Typing Indicator Pill -->
                                                            <Border Visibility="{Binding IsTyping, Converter={StaticResource VisibilityConverter}}" Background="#2000E5FF" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                                                <TextBlock Text="TYPING..." FontSize="8" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" Style="{StaticResource IconButton}" Margin="10,0,0,0" Opacity="0.6">
                                                            <fa:ImageAwesome Icon="Close" Width="8" Foreground="White"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#0C0C0C"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#1A1A20"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Add Tab Dropdown (Installed CLI Auto-Detector) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Command="{Binding NewTabCommand}" CommandParameter="{Binding DetectedShells[0]}"
                                    Style="{StaticResource IconButton}" Padding="8,10" VerticalAlignment="Stretch" ToolTip="New Shell Tab">
                                <fa:ImageAwesome Icon="Plus" Width="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button x:Name="AddTabMenuButton" Click="AddTabMenuButton_Click"
                                    Style="{StaticResource IconButton}" Padding="6,10" VerticalAlignment="Stretch" ToolTip="Installed CLI Shells">
                                <fa:ImageAwesome Icon="ChevronDown" Width="8" Foreground="{DynamicResource TextDisabledBrush}"/>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding DetectedShells}" Background="#09090F" BorderBrush="#1F1F2E">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Name}"/>
                                                <Setter Property="Command" Value="{Binding DataContext.NewTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Setter Property="CommandParameter" Value="{Binding}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Native ConHost Terminal Viewport (Authentic CMD / PowerShell Terminal Window) -->
                    <Border Grid.Row="1" Background="#0C0C0C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" CornerRadius="0,0,8,8">
                        <Grid>
                            <ContentControl Content="{Binding SelectedSession}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type models:ConsoleSession}">
                                        <ScrollViewer x:Name="TerminalScrollViewer" Loaded="TerminalScrollViewer_Loaded"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                                      Padding="14,12" Background="#0C0C0C" MouseDown="TerminalArea_MouseDown" Cursor="IBeam">
                                            <StackPanel>
                                                <!-- Native Console Output Buffer Stream -->
                                                <ItemsControl ItemsSource="{Binding OutputLines}" Loaded="TerminalOutputItems_Loaded">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#CCCCCC" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1" LineHeight="18"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Active Inline Command Prompt Line (Direct Interactive Typing) -->
                                                <TextBox x:Name="InlineInputBox" Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}" 
                                                         Background="Transparent" BorderThickness="0" Foreground="#CCCCCC"
                                                         FontFamily="Consolas" FontSize="13" CaretBrush="#CCCCCC" Margin="0,2,0,0" Padding="0">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding DataContext.SendCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- Empty State -->
                            <Border Visibility="{Binding SelectedSession, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Background="#0C0C0C">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5">
                                    <fa:ImageAwesome Icon="Terminal" Width="48" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,20"/>
                                    <TextBlock Text="No Active Terminal Sessions" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click the '+' button above to launch an installed CLI shell." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
