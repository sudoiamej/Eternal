<UserControl x:Class="Eternal.Views.Modules.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Address & Navigation Bar -->
            <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main File Grid ListView -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Row 0: Top Navigation & Address Bar -->
        <Border Grid.Row="0" Background="#0A0A10" BorderBrush="#1C1C28" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Navigation History Buttons -->
                    <ColumnDefinition Width="Auto"/> <!-- Drive Selector -->
                    <ColumnDefinition Width="*"/>    <!-- Address Bar -->
                    <ColumnDefinition Width="220"/>  <!-- Search Filter -->
                </Grid.ColumnDefinitions>

                <!-- Navigation History Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Command="{Binding NavigateBackCommand}" Style="{StaticResource StandardButton}" Width="32" Height="32" Margin="0,0,4,0" ToolTip="Back">
                        <fa:ImageAwesome Icon="ArrowLeft" Width="11" Foreground="White"/>
                    </Button>
                    <Button Command="{Binding NavigateForwardCommand}" Style="{StaticResource StandardButton}" Width="32" Height="32" Margin="0,0,4,0" ToolTip="Forward">
                        <fa:ImageAwesome Icon="ArrowRight" Width="11" Foreground="White"/>
                    </Button>
                    <Button Command="{Binding NavigateUpCommand}" Style="{StaticResource StandardButton}" Width="32" Height="32" ToolTip="Up to Parent Folder">
                        <fa:ImageAwesome Icon="ArrowUp" Width="11" Foreground="White"/>
                    </Button>
                </StackPanel>

                <!-- Drive Selector -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding Drives}" SelectedValue="{Binding SelectedDrive}" Width="75" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" Background="#161622" Foreground="White" BorderBrush="#333348"/>

                <!-- Address Bar -->
                <Border Grid.Column="2" Background="#12121C" BorderBrush="#262638" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="32" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="FolderOpen" Width="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}" x:Name="AddressTextBox" KeyDown="AddressTextBox_KeyDown" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"/>
                        <Button Grid.Column="2" Command="{Binding RefreshCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Refresh">
                            <fa:ImageAwesome Icon="Refresh" Width="11" Foreground="#888896"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search Filter Box -->
                <Border Grid.Column="3" Background="#12121C" BorderBrush="#262638" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="32">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="Search" Width="11" Foreground="#666675" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: Action Toolbar -->
        <Border Grid.Row="1" Background="#060609" BorderBrush="#161622" BorderThickness="0,0,0,1" Padding="14,6">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding OpenTerminalHereCommand}" Style="{StaticResource StandardButton}" Height="28" Padding="10,0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Terminal" Width="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Open Terminal Here" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedItem}" Style="{StaticResource StandardButton}" Height="28" Padding="10,0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Copy" Width="10" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Copy Path" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding InspectPropertiesCommand}" CommandParameter="{Binding SelectedItem}" IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}" Style="{StaticResource StandardButton}" Height="28" Padding="10,0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="InfoCircle" Width="10" Foreground="{DynamicResource InfoBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="File Properties &amp; Hashes" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding InspectHexCommand}" CommandParameter="{Binding SelectedItem}" IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}" Style="{StaticResource StandardButton}" Height="28" Padding="10,0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Code" Width="10" Foreground="#EC4899" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hex Inspector" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding CompressToZipCommand}" CommandParameter="{Binding SelectedItem}" IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}" Style="{StaticResource StandardButton}" Height="28" Padding="10,0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="FileArchiveOutline" Width="10" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Compress Zip" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExtractZipCommand}" CommandParameter="{Binding SelectedItem}" IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}" Style="{StaticResource StandardButton}" Height="28" Padding="10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="FolderOpen" Width="10" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Extract Zip" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Row 2: ListView File Items -->
        <ListView Grid.Row="2" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}" MouseDoubleClick="ListView_MouseDoubleClick" Background="#030305" BorderThickness="0" Foreground="White">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Margin" Value="6,2"/>
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Left Cyan Selection Indicator Pill -->
                                        <Border x:Name="SelectionPill" Grid.Column="0" Width="3" Height="18" Background="#00F0FF" CornerRadius="1.5" Margin="0,0,10,0" Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#00F0FF" BlurRadius="8" ShadowDepth="0"/>
                                            </Border.Effect>
                                        </Border>
                                        <GridViewRowPresenter Grid.Column="1" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Hover State: Soft Cyan Glass Highlight with Subtle Border -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#0F1B2A"/>
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00E5FF"/>
                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                    <!-- Selected State: Deep Neon Blue Fill, Cyan Glow Border, and Active Selection Pill -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#14283E"/>
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00F0FF"/>
                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                        <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <!-- Name Column -->
                    <GridViewColumn Header="Name" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="{Binding IconName}" Width="14" Foreground="{Binding IconColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Type Column -->
                    <GridViewColumn Header="Type" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ItemType}" FontSize="11" Foreground="#888896" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Size Column -->
                    <GridViewColumn Header="Size" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeFormatted}" FontSize="11" FontFamily="Consolas" Foreground="#00E5FF" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Date Modified Column -->
                    <GridViewColumn Header="Date Modified" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="#A0A0B2" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Row 3: Status Bar -->
        <Border Grid.Row="3" Background="#0A0A10" BorderBrush="#1C1C28" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="#888896" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="ETERNAL FILE SYSTEM EXPLORER" FontSize="9" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Win32 File Properties Inspector Modal Dialog -->
        <Grid Visibility="{Binding IsPropertiesModalVisible, Converter={StaticResource VisibilityConverter}}" Background="#C0030305" Panel.ZIndex="9999">
            <Border Background="#09090E" BorderBrush="#1F1F2E" BorderThickness="1.5" CornerRadius="12" Width="600" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="InfoCircle" Width="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="WIN32 FILE PROPERTIES &amp; FORENSIC AUDIT" FontSize="14" FontWeight="Black" Foreground="White"/>
                        </StackPanel>
                        <Button Command="{Binding ClosePropertiesModalCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <fa:ImageAwesome Icon="Times" Width="14" Foreground="#888896"/>
                        </Button>
                    </Grid>

                    <!-- General File Metadata Grid -->
                    <Border Background="#0D0D14" BorderBrush="#191926" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Name:" FontSize="10" Foreground="#888896" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InspectName}" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Full Path:" FontSize="10" Foreground="#888896" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InspectPath}" FontSize="10" FontFamily="Consolas" Foreground="#00E5FF" TextWrapping="Wrap" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Size:" FontSize="10" Foreground="#888896" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InspectSize}" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Type:" FontSize="10" Foreground="#888896" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InspectType}" FontSize="11" Foreground="#CCCCCC" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Attributes:" FontSize="10" Foreground="#888896" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InspectAttributes}" FontSize="11" Foreground="#F59E0B" Margin="0,2"/>
                        </Grid>
                    </Border>

                    <!-- Cryptographic Hashes Card -->
                    <Border Background="#0D0D14" BorderBrush="#191926" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CRYPTOGRAPHIC FILE HASHES" FontSize="9" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                            <TextBlock Text="SHA-256 Hash:" FontSize="10" Foreground="#888896"/>
                            <TextBox Text="{Binding InspectSha256}" IsReadOnly="True" Background="#141420" BorderBrush="#262638" Foreground="#00E5FF" FontFamily="Consolas" FontSize="10" Padding="6,4" Margin="0,2,0,8"/>

                            <TextBlock Text="MD5 Hash:" FontSize="10" Foreground="#888896"/>
                            <TextBox Text="{Binding InspectMd5}" IsReadOnly="True" Background="#141420" BorderBrush="#262638" Foreground="#00E5FF" FontFamily="Consolas" FontSize="10" Padding="6,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Version & Security ACL Card -->
                    <Border Background="#0D0D14" BorderBrush="#191926" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Publisher:" FontSize="10" Foreground="#888896" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InspectPublisher}" FontSize="11" Foreground="White" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Owner (NT SID):" FontSize="10" Foreground="#888896" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InspectOwner}" FontSize="10" FontFamily="Consolas" Foreground="#22C55E" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ACL Summary:" FontSize="10" Foreground="#888896" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InspectAclPermissions}" FontSize="9" FontFamily="Consolas" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,2"/>
                        </Grid>
                    </Border>

                    <Button Command="{Binding ClosePropertiesModalCommand}" Style="{StaticResource PrimaryButton}" Height="36" HorizontalAlignment="Right" Padding="20,0">
                        <TextBlock Text="CLOSE INSPECTOR" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hex / Binary File Inspector Modal Dialog -->
        <Grid Visibility="{Binding IsHexModalVisible, Converter={StaticResource VisibilityConverter}}" Background="#C0030305" Panel.ZIndex="9999">
            <Border Background="#09090E" BorderBrush="#1F1F2E" BorderThickness="1.5" CornerRadius="12" Width="720" Height="500" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Code" Width="16" Foreground="#EC4899" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="HEX &amp; BINARY FILE INSPECTOR — " FontSize="14" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="{Binding HexFileHeaderInfo}" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseHexModalCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <fa:ImageAwesome Icon="Times" Width="14" Foreground="#888896"/>
                        </Button>
                    </Grid>

                    <!-- Hex Rows ListView Grid -->
                    <ListView Grid.Row="1" ItemsSource="{Binding HexRows}" Background="#06060A" BorderBrush="#161622" BorderThickness="1" Foreground="White" FontFamily="Consolas" FontSize="11">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Offset" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Offset}" Foreground="#F59E0B" FontFamily="Consolas"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Hex Bytes (16-Byte Block)" Width="400">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding HexBytes}" Foreground="#00E5FF" FontFamily="Consolas"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="ASCII String" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AsciiString}" Foreground="#22C55E" FontFamily="Consolas"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Footer -->
                    <Button Grid.Row="2" Command="{Binding CloseHexModalCommand}" Style="{StaticResource PrimaryButton}" Height="36" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="20,0">
                        <TextBlock Text="CLOSE HEX INSPECTOR" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
