<UserControl x:Class="Eternal.Views.Modules.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <Border Padding="40">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                <TextBlock Text="ETERNAL › HARDWARE TELEMETRY" Style="{StaticResource HeaderBreadcrumb}"/>
                <TextBlock Text="Advanced Battery Lab" Style="{StaticResource H1}" Margin="0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <!-- No Battery Placeholder -->
                <Border Visibility="{Binding NoBatteryDetected, Converter={StaticResource VisibilityConverter}}" 
                        Style="{StaticResource StandardCard}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="50">
                    <StackPanel HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="Bolt" Width="48" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.3" Margin="0,0,0,20"/>
                        <TextBlock Text="NO BATTERY DETECTED" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="This module is designed for portable systems. No ACPI battery interface was found." 
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Battery Data -->
                <Grid Visibility="{Binding NoBatteryDetected, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Visual Health -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HARDWARE HEALTH" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                        <Border Style="{StaticResource StandardCard}" Padding="30">
                            <StackPanel>
                                <Grid HorizontalAlignment="Center" Margin="0,0,0,30">
                                    <helpers:RadialGauge Value="{Binding Battery.WearLevel}" Width="180" Height="180" StrokeThickness="15" 
                                                       Stroke="{DynamicResource CriticalBrush}" GlowColor="{DynamicResource CriticalColor}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Battery.WearLevel, StringFormat='{}{0:F1}%'}" FontSize="32" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="WEAR LEVEL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </helpers:RadialGauge>
                                </Grid>
                                
                                <ProgressBar Value="{Binding Battery.ChargeLevel}" Height="10" Style="{StaticResource GlowingProgressBar}" Margin="0,0,0,10"/>
                                <Grid>
                                    <TextBlock Text="Current Charge" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Battery.ChargeLevel, StringFormat='{}{0}%'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="White"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Technical Specs -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ACPI SPECIFICATIONS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                        <Border Style="{StaticResource StandardCard}" Padding="25">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Device Name" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Battery.DeviceName}" HorizontalAlignment="Right" Foreground="White" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Chemistry" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Battery.Chemistry}" HorizontalAlignment="Right" Foreground="White"/>
                                </Grid>
                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,15"/>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Design Capacity" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Battery.DesignCapacity, StringFormat='{}{0} mWh'}" HorizontalAlignment="Right" Foreground="White"/>
                                </Grid>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Full Charge Capacity" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Battery.FullChargeCapacity, StringFormat='{}{0} mWh'}" HorizontalAlignment="Right" Foreground="White"/>
                                </Grid>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="Cycle Count" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Battery.CycleCount}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Power Source" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Battery.PowerSource}" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
