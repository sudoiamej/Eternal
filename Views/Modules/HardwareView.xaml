<UserControl x:Class="Eternal.Views.Modules.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:viewmodels="clr-namespace:Eternal.ViewModels.Modules"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">
    
    <Grid>
        <!-- Main Content (HCI Rule 4: Cognitive Load Control) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40" 
                      VirtualizingPanel.ScrollUnit="Pixel"
                      Visibility="{Binding HasError, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
            <StackPanel>
                <!-- 1. Unified Header (HCI Rule 9: Consistency) -->
                <Grid Style="{StaticResource ModuleHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="HARDWARE INTELLIGENCE" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="System Blueprint" Style="{StaticResource H1}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="Advanced Data" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <CheckBox IsChecked="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}}" Width="32" Height="18" Style="{StaticResource {x:Static ToolBar.CheckBoxStyleKey}}"/>
                        </StackPanel>
                        <Button Command="{Binding LoadDataCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" ToolTip="Rescan Hardware">
                            <fa:ImageAwesome Icon="Refresh" Width="16" Foreground="{DynamicResource TextSecondaryBrush}"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Chassis & Core (HCI Rule 6: Conceptual Model) -->
                <TextBlock Text="CHASSIS &amp; ARCHITECTURE" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                <Border Style="{StaticResource StandardCard}" Margin="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Desktop" Width="32" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,30,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Motherboard.Manufacturer}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Motherboard.Model}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                            
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <fa:ImageAwesome Icon="Microchip" Width="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                <TextBlock Text="{Binding Cpu.Name}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="CORES" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Cpu.Cores}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="THREADS" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Cpu.Threads}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="CLOCK" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Cpu.Frequency}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="ARCH" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Cpu.Architecture}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 3. Memory Infrastructure (HCI Rule 5: Mapping) -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="MEMORY INFRASTRUCTURE" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                        <Border Style="{StaticResource StandardCard}" Height="120">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:ImageAwesome Icon="Bars" Width="24" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,20,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="System RAM" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Ram.TotalCapacity}" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Ram.Speed}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 4. Visual Processing (HCI Rule 11: Progressive Disclosure) -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="VISUAL PROCESSING" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                        <Border Style="{StaticResource StandardCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:ImageAwesome Icon="Television" Width="24" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Top" Margin="0,5,20,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Graphics Adapter" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Gpu.Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                                    <UniformGrid Columns="2" Margin="0,5,0,0">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="VRAM" Style="{StaticResource Caption}" FontSize="9"/>
                                            <TextBlock Text="{Binding Gpu.Vram}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="TEMP" Style="{StaticResource Caption}" FontSize="9"/>
                                            <TextBlock Text="{Binding Gpu.Temperature}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="CORE CLOCK" Style="{StaticResource Caption}" FontSize="9"/>
                                            <TextBlock Text="{Binding Gpu.CoreClock}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="MEM CLOCK" Style="{StaticResource Caption}" FontSize="9"/>
                                            <TextBlock Text="{Binding Gpu.MemoryClock}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="UTILIZATION" Style="{StaticResource Caption}" FontSize="9"/>
                                            <TextBlock Text="{Binding Gpu.Utilization}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="CORES" Style="{StaticResource Caption}" FontSize="9"/>
                                            <TextBlock Text="{Binding Gpu.Cores}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="{Binding Gpu.DriverVersion, StringFormat='Driver: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 5. Storage Sentry (HCI Rule 15: Error Transparency) -->
                <TextBlock Text="STORAGE SENTRY" Style="{StaticResource Caption}" Margin="0,20,0,15"/>
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StandardCard}" Margin="0,0,0,10" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <fa:ImageAwesome Icon="HddOutline" Width="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Size}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="8,4" CornerRadius="2" Background="#1A000000" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Health}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 6. Detailed System Summary (Triggered as Subwindow) -->
                <StackPanel Margin="0,30,0,0" Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="DETAILED SYSTEM SUMMARY (MSINFO32)" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Padding="25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Full Diagnostic Report Available" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                <TextBlock Text="Detailed hardware, firmware, and OS summary logs matching msinfo32 standards." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ViewDetailsCommand}" Style="{StaticResource PrimaryAction}" Padding="20,10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="ListAlt" Width="12" Foreground="Black" Margin="0,0,10,0"/>
                                    <TextBlock Text="VIEW DIAGNOSTIC BLUEPRINT" FontWeight="Black" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Error State (HCI Rule 2: Recovery) -->
        <helpers:ErrorCard HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource VisibilityConverter}}"
                           MaxWidth="500">
            <helpers:ErrorCard.DataContext>
                <Binding Path="." />
            </helpers:ErrorCard.DataContext>
        </helpers:ErrorCard>

        <!-- Loading Overlay (HCI Rule 5: Feedback System) -->
        <Border Background="#CC0A0A0A" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"><fa:ImageAwesome.Effect><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                <TextBlock Text="Scanning Hardware..." FontSize="18" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
