<UserControl x:Class="Eternal.Views.Modules.PcScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:vmm="clr-namespace:Eternal.ViewModels.Modules"
             xmlns:models="clr-namespace:Eternal.Models"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid>
        <Border Padding="40">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel.Resources>
                        <DataTemplate x:Key="IssueItemTemplate">
                            <Border Background="{DynamicResource CardBrush}" Margin="0,0,0,12" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                <StackPanel>
                                    <!-- Header Row (Clickable) -->
                                    <ToggleButton x:Name="ExpandToggle" Background="Transparent" BorderThickness="0" Padding="20" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- Category Icon -->
                                                        <fa:ImageAwesome Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,20,0">
                                                            <fa:ImageAwesome.Style>
                                                                <Style TargetType="fa:ImageAwesome">
                                                                    <Setter Property="Icon" Value="ExclamationCircle"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Category}" Value="Security"><Setter Property="Icon" Value="Shield"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Category}" Value="Storage"><Setter Property="Icon" Value="Database"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Category}" Value="Performance"><Setter Property="Icon" Value="Flash"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Category}" Value="Cleanup"><Setter Property="Icon" Value="TrashOutline"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Required"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Recommended"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Optional"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </fa:ImageAwesome.Style>
                                                        </fa:ImageAwesome>

                                                        <!-- Text Summary -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Black" FontSize="14" Foreground="White"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,30,0" TextWrapping="Wrap" Opacity="0.8"/>
                                                        </StackPanel>

                                                        <!-- Action Button -->
                                                        <Button Grid.Column="2" Command="{Binding DataContext.FixIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,15,0" Padding="15,7">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="AutoFix">
                                                                            <Setter Property="Content" Value="FIX NOW"/>
                                                                            <Setter Property="Background" Value="#1A4CAF50"/>
                                                                            <Setter Property="BorderBrush" Value="#404CAF50"/>
                                                                            <Setter Property="ToolTip" Value="Attempt to resolve this issue automatically with one click."/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ActionType}" Value="ManualNavigation">
                                                                            <Setter Property="Content" Value="REVIEW"/>
                                                                            <Setter Property="ToolTip" Value="Navigate to the specialized module to address this issue manually."/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <!-- Expand Arrow (Signifier) -->
                                                        <fa:ImageAwesome Grid.Column="3" Icon="AngleDown" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <fa:ImageAwesome.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </fa:ImageAwesome.RenderTransform>
                                                            <fa:ImageAwesome.Style>
                                                                <Style TargetType="fa:ImageAwesome">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                            <DataTrigger.EnterActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.25"/></Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                            <DataTrigger.ExitActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25"/></Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.ExitActions>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </fa:ImageAwesome.Style>
                                                        </fa:ImageAwesome>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Collapsible Expert Detail Section (Don Norman: Conceptual Models) -->
                                    <Border x:Name="DetailsPane" Background="#05FFFFFF" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="25" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="UNDER THE HOOD (DIAGNOSTIC METRICS)" FontSize="9" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding TechnicalDetails}" FontFamily="Consolas, Courier New" FontSize="11" Foreground="#CCFFFFFF" LineHeight="18" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ExpandToggle}" Value="True">
                                    <Setter TargetName="DetailsPane" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </StackPanel.Resources>

                    <!-- Header -->
                    <StackPanel Style="{StaticResource ModuleHeaderStyle}">
                        <TextBlock Text="ETERNAL › SYSTEM DIAGNOSTICS" Style="{StaticResource HeaderBreadcrumb}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PC Intelligence Scanner" Style="{StaticResource H1}" Margin="0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <TextBlock Text="SORT BY" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,5,5" Opacity="0.5"/>
                                <ComboBox SelectedValue="{Binding CurrentSortOption}" SelectedValuePath="Tag" Width="150"
                                          Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBoxItem Content="Default" Tag="{x:Static models:ScannerSortOption.Default}"/>
                                    <ComboBoxItem Content="Level" Tag="{x:Static models:ScannerSortOption.Level}"/>
                                    <ComboBoxItem Content="Easy to Hard" Tag="{x:Static models:ScannerSortOption.EasyToHard}"/>
                                    <ComboBoxItem Content="Alphabetical" Tag="{x:Static models:ScannerSortOption.Alphabetical}"/>
                                    <ComboBoxItem Content="Safe to Dangerous" Tag="{x:Static models:ScannerSortOption.SafeToDangerous}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Scan Control Banner -->
                    <Border Style="{StaticResource StandardCard}" Margin="0,0,0,30" Padding="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" Background="{DynamicResource CardBrush}" CornerRadius="32" Margin="0,0,25,0">
                                <fa:ImageAwesome Icon="Search" Width="28" Foreground="{DynamicResource AccentBrush}" 
                                                 Spin="{Binding IsBusy}"><fa:ImageAwesome.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/></fa:ImageAwesome.Effect></fa:ImageAwesome>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <ProgressBar Height="6" Margin="0,15,40,0" Value="{Binding ScanProgress}" 
                                             Style="{StaticResource GlowingProgressBar}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}"/>
                            </StackPanel>


                            <Button Grid.Column="2" Command="{Binding StartScanCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"
                                    Content="START FULL SCAN" Style="{StaticResource PrimaryAction}" Padding="30,12"/>
                        </Grid>
                    </Border>

                    <!-- Summary Cards -->
                    <UniformGrid Columns="3" Margin="0,0,0,30">
                        <Border Style="{StaticResource StandardCard}" Margin="0,0,15,0" Padding="20" BorderBrush="{DynamicResource CriticalBrush}" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="REQUIRED" Style="{StaticResource Caption}" Foreground="{DynamicResource CriticalBrush}"/>
                                <TextBlock Text="{Binding RequiredCount}" FontSize="32" FontWeight="Black" Foreground="White" Margin="0,5"/>
                                <TextBlock Text="Critical issues needing attention" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StandardCard}" Margin="7,0,7,0" Padding="20" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="RECOMMENDED" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Text="{Binding RecommendedCount}" FontSize="32" FontWeight="Black" Foreground="White" Margin="0,5"/>
                                <TextBlock Text="Performance &amp; security improvements" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StandardCard}" Margin="15,0,0,0" Padding="20" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="OPTIONAL" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding OptionalCount}" FontSize="32" FontWeight="Black" Foreground="White" Margin="0,5"/>
                                <TextBlock Text="Minor optimizations &amp; maintenance" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Tiered View (Default Sort) -->
                    <StackPanel Name="TieredContainer">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSortOption}" Value="Default">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        
                        <!-- Required Issues List -->
                        <StackPanel Visibility="{Binding RequiredCount, Converter={StaticResource VisibilityConverter}}">
                            <TextBlock Text="REQUIRED ACTIONS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <ItemsControl ItemsSource="{Binding RequiredIssues}" ItemTemplate="{StaticResource IssueItemTemplate}"/>
                        </StackPanel>

                        <!-- Recommended Issues List -->
                        <StackPanel Visibility="{Binding RecommendedCount, Converter={StaticResource VisibilityConverter}}" Margin="0,20,0,0">
                            <TextBlock Text="RECOMMENDED IMPROVEMENTS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <ItemsControl ItemsSource="{Binding RecommendedIssues}" ItemTemplate="{StaticResource IssueItemTemplate}"/>
                        </StackPanel>

                        <!-- Optional Issues List -->
                        <StackPanel Visibility="{Binding OptionalCount, Converter={StaticResource VisibilityConverter}}" Margin="0,20,0,0">
                            <TextBlock Text="OPTIONAL OPTIMIZATIONS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                            <ItemsControl ItemsSource="{Binding OptionalIssues}" ItemTemplate="{StaticResource IssueItemTemplate}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sorted View (Any other Sort) -->
                    <StackPanel Name="SortedContainer">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSortOption}" Value="Default">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Visible"/>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Text="SORTED DIAGNOSTICS" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                        <ItemsControl ItemsSource="{Binding SortedIssues}" ItemTemplate="{StaticResource IssueItemTemplate}"/>
                    </StackPanel>

                    <!-- Empty State (Shield of Safety) -->
                    <Border Background="{DynamicResource CardBrush}" Padding="45" CornerRadius="20" Margin="0,20,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding RequiredCount, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecommendedCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="70" Height="70" Margin="0,0,0,25" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ShieldScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Grid.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="ShieldScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.06" Duration="0:0:2.5">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ShieldScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.06" Duration="0:0:2.5">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <Ellipse Fill="#0800FFAA" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.5" Width="70" Height="70">
                                    <Ellipse.Effect><DropShadowEffect Color="{DynamicResource SuccessColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/></Ellipse.Effect>
                                </Ellipse>
                                <fa:ImageAwesome Icon="Shield" Width="30" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="System Shield: Fully Secure &amp; Optimized" 
                                       Foreground="White" FontWeight="Black" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="All analyzed hardware metrics, process signatures, and memory margins are within optimal thresholds." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>




