<UserControl x:Class="Eternal.Views.Modules.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Border Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Storage Intelligence" Style="{StaticResource H1}"/>

                <TextBlock Text="LOGICAL PARTITIONS" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Partitions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StandardCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding FreeSpace}" Maximum="{Binding TotalSize}" Height="4" Margin="0,10" Background="{StaticResource BorderBrush}" Foreground="{StaticResource AccentBrush}"/>
                                    <Grid>
                                        <TextBlock Text="{Binding FileSystem}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="10">
                                            <Run Text="Free: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text="{Binding FreeSpace, Converter={StaticResource SizeConverter}}"/>
                                            <Run Text=" of " Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text="{Binding TotalSize, Converter={StaticResource SizeConverter}}"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="PHYSICAL DISK DRIVES" Style="{StaticResource Caption}" Margin="0,20,0,10"/>
                <ItemsControl ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StandardCard}" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Model}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Serial}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
