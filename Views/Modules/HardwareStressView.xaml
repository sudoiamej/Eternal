<UserControl x:Class="Eternal.Views.Modules.HardwareStressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <Border Padding="40">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                <TextBlock Text="ETERNAL › PERFORMANCE LAB" Style="{StaticResource HeaderBreadcrumb}"/>
                <TextBlock Text="Hardware Stress Hub" Style="{StaticResource H1}" Margin="0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Control & Visualizer -->
                <Border Grid.Column="0" Margin="0,0,20,0" Style="{StaticResource StandardCard}" Padding="40">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Big Toggle Button -->
                        <Button Command="{Binding ToggleStressCommand}" Width="200" Height="200" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Outer" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="Glow" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="Inner" Margin="10" Fill="#10FFFFFF"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <fa:ImageAwesome x:Name="Icon" Icon="Flash" Width="48" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="Txt" Text="START STRESS" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource CriticalBrush}"/>
                                            <Setter TargetName="Inner" Property="Fill" Value="#20F44336"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                            <Setter TargetName="Txt" Property="Text" Value="STOP STRESS"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Inner" Property="Fill" Value="#15FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Margin="0,30,0,0" FontSize="18" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Right: Config & Impact -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CONFIGURATION" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Thread Workers Slider -->
                            <TextBlock Text="THREAD WORKERS" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Value="{Binding ThreadCount, Mode=TwoWay}" Minimum="1" Maximum="{Binding ThreadOptions.Count}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBooleanConverter}}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ThreadCount}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" Width="20" TextAlignment="Right"/>
                            </Grid>

                            <!-- Cyclical Stress Mode -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CYCLICAL LOAD WAVE" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Fluctuates CPU load on a cosine cycle" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ModernSwitch}" IsChecked="{Binding IsCyclicalMode}"
                                              IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBooleanConverter}}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Thermal Safety Switch -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="THERMAL SAFETY SHIELD" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="Halts stress test if core spikes &gt; 88°C" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ModernSwitch}" IsChecked="{Binding IsThermalSafetyEnabled}"
                                              IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBooleanConverter}}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="REAL-TIME IMPACT" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Padding="20">
                        <StackPanel>
                            <!-- CPU Usage -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="System CPU Load" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DataContext.CpuUsage, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="White"/>
                            </Grid>
                            <ProgressBar Value="{Binding DataContext.CpuUsageValue, RelativeSource={RelativeSource AncestorType=Window}}" Height="4" Style="{StaticResource GlowingProgressBar}" Margin="0,0,0,20"/>

                            <!-- CPU Temperature -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="CPU Core Temperature" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentCpuTemp, StringFormat='{}{0:F1}°C'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="White"/>
                            </Grid>
                            <ProgressBar Value="{Binding CurrentCpuTemp}" Minimum="0" Maximum="100" Height="4" Margin="0,0,0,20">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource GlowingProgressBar}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentCpuTemp, Converter={StaticResource NumericComparisonConverter}, ConverterParameter='&gt;80'}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CurrentCpuTemp, Converter={StaticResource NumericComparisonConverter}, ConverterParameter='&gt;65'}" Value="True"/>
                                                    <Condition Binding="{Binding CurrentCpuTemp, Converter={StaticResource NumericComparisonConverter}, ConverterParameter='&gt;80'}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <TextBlock Text="Safety Notice: This test utilizes high-intensity prime calculations. The thermal safety shield will auto-terminate operations to protect processor silicon." 
                                       FontSize="10" Foreground="{DynamicResource WarningBrush}" Margin="0,5,0,0" TextWrapping="Wrap" FontWeight="SemiBold" LineHeight="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
