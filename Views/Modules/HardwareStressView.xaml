<UserControl x:Class="Eternal.Views.Modules.HardwareStressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <Border Padding="40">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                <TextBlock Text="ETERNAL › PERFORMANCE LAB" Style="{StaticResource HeaderBreadcrumb}"/>
                <TextBlock Text="Hardware Stress Hub" Style="{StaticResource H1}" Margin="0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Control & Visualizer -->
                <Border Grid.Column="0" Margin="0,0,20,0" Style="{StaticResource StandardCard}" Padding="40">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Big Toggle Button -->
                        <Button Command="{Binding ToggleStressCommand}" Width="200" Height="200" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Outer" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="Glow" Color="{DynamicResource CriticalColor}" BlurRadius="30" ShadowDepth="0" Opacity="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Ellipse x:Name="Inner" Margin="10" Fill="#10FFFFFF"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <fa:ImageAwesome x:Name="Icon" Icon="Flash" Width="48" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="Txt" Text="START STRESS" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource CriticalBrush}"/>
                                            <Setter TargetName="Inner" Property="Fill" Value="#20F44336"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                            <Setter TargetName="Txt" Property="Text" Value="STOP STRESS"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Inner" Property="Fill" Value="#15FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Margin="0,30,0,0" FontSize="18" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Right: Config & Impact -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CONFIGURATION" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Padding="25" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Target Threads" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding ThreadOptions}" SelectedItem="{Binding ThreadCount}" 
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBooleanConverter}}"
                                      Background="#151515" Foreground="White" BorderBrush="{DynamicResource BorderBrush}"
                                      HorizontalAlignment="Stretch" Padding="10,5">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#222222"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <TextBlock Text="Higher counts will maximize CPU load across more logical cores." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.5"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="REAL-TIME IMPACT" Style="{StaticResource Caption}" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource StandardCard}" Padding="25">
                        <StackPanel>
                            <!-- CPU Usage (Bound to Window DataContext which is MainViewModel) -->
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="CPU Load" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DataContext.CpuUsage, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="White"/>
                            </Grid>
                            <ProgressBar Value="{Binding DataContext.CpuUsageValue, RelativeSource={RelativeSource AncestorType=Window}}" Height="4" Style="{StaticResource GlowingProgressBar}"/>

                            <TextBlock Text="Note: This test uses high-intensity prime calculations. Your system may become unresponsive during the test." 
                                       FontSize="10" Foreground="{DynamicResource WarningBrush}" Margin="0,25,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
