<UserControl x:Class="Eternal.Views.Modules.ProcessIntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:Models="clr-namespace:Eternal.Models"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Spatial Entrance Animation -->
        <Storyboard x:Key="EntranceAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/> <!-- Spatial Detail Rail -->
        </Grid.ColumnDefinitions>

        <!-- Main Workspace: Process Map -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Data Grid -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}" Margin="10,25,10,15">
                <TextBlock Text="ETERNAL › ACTIVE WORKSPACE" Style="{StaticResource HeaderBreadcrumb}"/>
                <Grid>
                    <TextBlock Text="Process Intelligence Map" Style="{StaticResource H1}" Margin="0" FontSize="32" FontWeight="Black"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#10FFFFFF" CornerRadius="15" Padding="18,6" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Cube" Width="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalProcessCount, StringFormat='{}NODES: {0}'}" Foreground="White" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding LoadCommand}" Style="{StaticResource IconButton}" ToolTip="Sync Kernel Data">
                            <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsBusy}">
                                <fa:ImageAwesome.Effect>
                                    <DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                </fa:ImageAwesome.Effect>
                            </fa:ImageAwesome>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 2. Main Data Grid -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding FlatProcesses}" 
                      SelectedItem="{Binding SelectedProcess}"
                      Style="{StaticResource NeuDataGrid}"
                      Margin="10,0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      CanUserSortColumns="True"
                      RenderOptions.ClearTypeHint="Enabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="3*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <fa:ImageAwesome Icon="Cube" Width="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" Opacity="0.6"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="0.8*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Opacity" Value="0.8"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="CPU" Width="1*" SortMemberPath="CpuUsage">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="4" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CpuUsage, Converter={StaticResource NumericComparisonConverter}, ConverterParameter='>10'}" Value="True">
                                                    <Setter Property="Background" Value="#25FF9800"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CpuUsage, Converter={StaticResource NumericComparisonConverter}, ConverterParameter='>50'}" Value="True">
                                                    <Setter Property="Background" Value="#40F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CpuUsage, StringFormat='{}{0:F1}%'}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="Black"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryUsage}" Width="1.5*" SortMemberPath="MemoryBytes">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Disk" Binding="{Binding DiskUsage}" Width="1.2*" SortMemberPath="DiskBytesPerSec">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Network" Binding="{Binding NetworkUsage}" Width="1.2*" SortMemberPath="NetworkBytesPerSec">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- SPATIAL LAYER 4: Detail Rail (Contextual Overlay) -->
        <Border Grid.Column="1" x:Name="DetailRail" Width="0" Background="{DynamicResource SidebarBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding SelectedProcess, Converter={StaticResource VisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedProcess, Converter={StaticResource VisibilityConverter}}" Value="Visible">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="360" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedProcess}" Value="{x:Null}">
                            <Setter Property="Width" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Actions -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <Grid>
                        <TextBlock Text="NODE FORENSICS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <Button Command="{Binding SelectProcessCommand}" CommandParameter="{x:Null}" HorizontalAlignment="Right" Style="{StaticResource IconButton}">
                            <fa:ImageAwesome Icon="Times" Width="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding SelectedProcess.Name}" FontSize="24" FontWeight="Black" Foreground="White" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelectedProcess.PID, StringFormat='{}SYSTEM PROCESS PID: {0}'}" FontSize="9" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" Opacity="0.8"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
                    <StackPanel>
                        <!-- Live Telemetry Card -->
                        <Border Style="{StaticResource StandardCard}" Margin="0,0,0,20" Padding="20">
                            <StackPanel>
                                <TextBlock Text="LIVE TELEMETRY" Style="{StaticResource Caption}" Margin="0,0,0,15" Opacity="0.7"/>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="CPU LOAD" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedProcess.CpuUsage, StringFormat='{}{0:F1}%'}" HorizontalAlignment="Right" FontWeight="Black" Foreground="White"/>
                                </Grid>
                                <ProgressBar Value="{Binding SelectedProcess.CpuUsage}" Style="{StaticResource GlowingProgressBar}" Height="4" Margin="0,0,0,15"/>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="MEMORY FOOTPRINT" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedProcess.MemoryUsage}" HorizontalAlignment="Right" FontWeight="Black" Foreground="White"/>
                                </Grid>
                                <Border Background="#10FFFFFF" Height="4" CornerRadius="2"/>
                            </StackPanel>
                        </Border>

                        <!-- Path Card -->
                        <Border Style="{StaticResource StandardCard}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="EXECUTABLE PATH" Style="{StaticResource Caption}" Margin="0,0,0,12" Opacity="0.7"/>
                                <TextBlock Text="{Binding SelectedProcess.Path}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" FontWeight="Bold" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Active Network Connections Card -->
                        <Border Style="{StaticResource StandardCard}" Margin="0,20,0,0" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SOCKET CONNECTIONS" Style="{StaticResource Caption}" Margin="0,0,0,15" Opacity="0.7"/>
                                
                                <ItemsControl ItemsSource="{Binding ActiveConnections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1D1D22" BorderThickness="0,0,0,1" Padding="0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Protocol}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding State}" HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding LocalAddress, StringFormat='{}Local: {0}'}" FontSize="10" Foreground="White" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding RemoteAddress, StringFormat='{}Remote: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <TextBlock Text="No active network sockets detected." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveConnections.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions -->
                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Button Command="{Binding KillProcessCommand}" CommandParameter="{Binding SelectedProcess}" Style="{StaticResource PrimaryAction}" Background="#20FF3366" BorderBrush="{DynamicResource CriticalBrush}" Height="50">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Times" Width="14" Foreground="White" Margin="0,0,12,0"/>
                            <TextBlock Text="TERMINATE PROCESS" FontWeight="Black" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <Border.Effect><BlurEffect Radius="25"/></Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,25"/>
                <TextBlock Text="SYNCING WORKSPACE STATE..." FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
