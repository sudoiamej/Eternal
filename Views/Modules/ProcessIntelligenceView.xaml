<UserControl x:Class="Eternal.Views.Modules.ProcessIntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:Models="clr-namespace:Eternal.Models"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <Border Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Summary Overview -->
                    <RowDefinition Height="*"/>    <!-- Process List -->
                </Grid.RowDefinitions>

                <!-- 1. Unified Header (HCI Rule 9: Consistency) -->
                <Grid Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="ACTIVE TELEMETRY" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="Process Intelligence" Style="{StaticResource H1}" Margin="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding LoadCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Style="{StaticResource IconButton}" VerticalAlignment="Bottom" Margin="0,0,0,5" ToolTip="Refresh Process List">
                        <fa:ImageAwesome Icon="Refresh" Width="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- 2. Summary Overview (HCI Rule 11: Progressive Disclosure) -->
                <Border Grid.Row="1" Style="{StaticResource StandardCard}" Margin="0,0,0,20" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Tasks" Width="32" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,25,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE TASKS SUMMARY" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalProcessCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text=" Active Processes Grouped by Kernel Signature" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="5,0,0,2"/>
                            </StackPanel>
                            <TextBlock Text="Processes are grouped by name. Expand a group to see individual instances." FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Grouped TreeView -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Headers Simulator -->
                    <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/> <!-- Spacer for toggle -->
                                <ColumnDefinition Width="100"/> <!-- Impact -->
                                <ColumnDefinition Width="2*"/> <!-- Name -->
                                <ColumnDefinition Width="120"/> <!-- Memory -->
                                <ColumnDefinition Width="100"/> <!-- PID / Count -->
                                <ColumnDefinition Width="3*"/> <!-- Path -->
                                <ColumnDefinition Width="50"/> <!-- Action -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="IMPACT" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="PROCESS NAME" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="DETAILS" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="5" Text="EXECUTABLE PATH" Style="{StaticResource Caption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="1" ItemsSource="{Binding ProcessGroups}" 
                              Background="Transparent" BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type Models:ProcessGroup}" ItemsSource="{Binding Items}">
                                <Grid Margin="0,4" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Padding="8,3" CornerRadius="2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Impact}" Value="High">
                                                        <Setter Property="Background" Value="#33F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                        <Setter Property="Background" Value="#33FFC107"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Impact}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Impact}" Value="High">
                                                            <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                        <Border Background="{StaticResource AccentBrush}" Opacity="0.2" CornerRadius="2" Margin="10,0,0,0" Padding="4,1" VerticalAlignment="Center">
                                            <TextBlock Text="APP GROUP" FontSize="8" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TotalMemory, Converter={StaticResource SizeConverter}}" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Count, StringFormat='({0} instances)'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type Models:ProcessDetail}">
                                <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center" Opacity="0.8"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MemoryBytes, Converter={StaticResource SizeConverter}}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Id, StringFormat='PID: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Path}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.6"/>

                                    <Button Grid.Column="5" Command="{Binding DataContext.TerminateProcessCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            HorizontalAlignment="Center">
                                        <fa:ImageAwesome Icon="TimesCircle" Width="12" Foreground="{StaticResource CriticalBrush}" Opacity="0.4"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>

                            <Style TargetType="TreeViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="UIElement.Focusable" Value="false"/>
                                                                    <Setter Property="FrameworkElement.Width" Value="16"/>
                                                                    <Setter Property="FrameworkElement.Height" Value="16"/>
                                                                    <Setter Property="Control.Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Padding="2" Background="Transparent">
                                                                                    <fa:ImageAwesome Icon="AngleRight" Width="8" Foreground="{StaticResource TextSecondaryBrush}">
                                                                                        <fa:ImageAwesome.Style>
                                                                                            <Style TargetType="fa:ImageAwesome">
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                                                        <Setter Property="Rotation" Value="90"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </fa:ImageAwesome.Style>
                                                                                    </fa:ImageAwesome>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                        <ContentPresenter Grid.Column="1" x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="20,0,0,0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="false">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="false">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="true">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="true"/>
                                                        <Condition Property="IsSelectionActive" Value="false"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
                                                </MultiTrigger>
                                                <Trigger Property="IsMouseOver" Value="true">
                                                    <Setter TargetName="Bd" Property="Background" Value="#05FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>

                <!-- Loading Overlay (HCI Rule 7: Status Feedback) -->
                <Border Grid.RowSpan="3" Background="#CC0A0A0A" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}" Margin="-40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{StaticResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                        <TextBlock Text="Analyzing Process Impact..." FontSize="18" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>

</UserControl>
