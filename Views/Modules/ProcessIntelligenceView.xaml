<UserControl x:Class="Eternal.Views.Modules.ProcessIntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:Models="clr-namespace:Eternal.Models"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Process Topology (Data) -->
        <Border Grid.Column="0" Padding="40" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}">
                    <TextBlock Text="ETERNAL › ACTIVE MONITORING" Style="{StaticResource HeaderBreadcrumb}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Process Intelligence" Style="{StaticResource H1}" Margin="0"/>
                        
                        <Button Grid.Column="1" Command="{Binding LoadCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh Process Map" VerticalAlignment="Center">
                            <fa:ImageAwesome Icon="Refresh" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsBusy}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <TreeView Grid.Row="1" ItemsSource="{Binding ProcessGroups}" 
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type Models:ProcessGroup}" ItemsSource="{Binding Processes}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Impact}" Value="High">
                                                    <Setter Property="Background" Value="#33F44336"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                    <Setter Property="Background" Value="#33FFC107"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Impact}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding TotalMemory, Converter={StaticResource SizeConverter}}" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Count, StringFormat='({0} instances)'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type Models:ProcessDetail}">
                            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}"/>
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PID}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding MemoryUsage}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                
                                <Button Grid.Column="3" Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" 
                                        CommandParameter="{Binding}" Style="{StaticResource IconButton}">
                                    <fa:ImageAwesome Icon="InfoCircle" Width="10" Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>
        </Border>

        <!-- Right: Management Pane (HCI Rule 6: Logical Mapping) -->
        <Border Grid.Column="1" Padding="30" Background="{DynamicResource SidebarBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PROCESS FORENSICS" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                    
                    <Border Background="{DynamicResource CardBrush}" Padding="20" CornerRadius="8" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="SECURITY CONSTRAINTS" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="SafetyLock" Content="Unlock Advanced Actions" 
                                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,20"/>

                            <Button Command="{Binding DataContext.NeutralizeProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding SelectedProcess.PID}"
                                    IsEnabled="{Binding IsChecked, ElementName=SafetyLock}"
                                    Style="{StaticResource StandardButton}" Background="{DynamicResource WarningBrush}" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Pause" Width="12" Foreground="White" Margin="0,0,12,0"/>
                                    <TextBlock Text="SUSPEND PROCESS" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding DataContext.IsolateNetworkCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding SelectedProcess.PID}"
                                    IsEnabled="{Binding IsChecked, ElementName=SafetyLock}"
                                    Style="{StaticResource StandardButton}" Background="{DynamicResource CriticalBrush}" Margin="0,0,0,15">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Globe" Width="12" Foreground="White" Margin="0,0,12,0"/>
                                    <TextBlock Text="ISOLATE NETWORK" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,15"/>

                            <Button Command="{Binding DataContext.AdvisorVm.AskNeuralisCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding SelectedProcess.Name, StringFormat='Analyze this process for potential malware or performance issues: {0}'}"
                                    Style="{StaticResource PrimaryButton}" Background="{DynamicResource AccentBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Bolt" Width="12" Foreground="White" Margin="0,0,12,0"/>
                                    <TextBlock Text="ANALYZE WITH NEURALIS" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DIAGNOSTIC HINT" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <Border Background="#0DFFFFFF" Padding="20" CornerRadius="8">
                        <TextBlock Text="Double-click a sub-process to view deep memory allocations and digital signatures." 
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Opacity="0.7"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#CC0A0A0A" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="18" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
