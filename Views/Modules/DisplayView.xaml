<UserControl x:Class="Eternal.Views.Modules.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
             xmlns:Models="clr-namespace:Eternal.Models"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Spatial Entrance Animation -->
        <Storyboard x:Key="EntranceAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Spatial Topology Canvas (HCI: Natural Mapping) -->
        <Border Grid.Column="0" Padding="35" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Canvas -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Style="{StaticResource ModuleHeaderStyle}" Margin="0,0,0,40">
                    <TextBlock Text="ETERNAL › DISPLAY ARCHITECTURE" Style="{StaticResource HeaderBreadcrumb}"/>
                    <Grid>
                        <TextBlock Text="Display Intelligence" Style="{StaticResource H1}" Margin="0" FontSize="32" FontWeight="Black"/>
                        <Button HorizontalAlignment="Right" Command="{Binding LoadCommand}" Style="{StaticResource IconButton}" ToolTip="Re-detect Displays">
                            <fa:ImageAwesome Icon="Refresh" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Spin="{Binding IsBusy}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Interactive Monitor Map -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left, Converter={StaticResource ProportionalHeightConverter}, ConverterParameter='0.1'}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top, Converter={StaticResource ProportionalHeightConverter}, ConverterParameter='0.1'}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource StandardCard}">
                                        <Setter Property="Width" Value="{Binding CurrentWidth, Converter={StaticResource ProportionalHeightConverter}, ConverterParameter='0.1'}"/>
                                        <Setter Property="Height" Value="{Binding CurrentHeight, Converter={StaticResource ProportionalHeightConverter}, ConverterParameter='0.1'}"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                        <Binding Path="."/>
                                                        <Binding Path="DataContext.SelectedMonitor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background" Value="#15FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <!-- Monitor Screen Content -->
                                    <Border Background="#05FFFFFF" CornerRadius="18" Margin="10">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Index}" FontSize="32" FontWeight="Black" Foreground="White" Opacity="0.8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentWidth, StringFormat='{}{0}x'}" FontSize="9" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentHeight}" FontSize="9" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Primary Badge -->
                                    <Border Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="8" Padding="8,3" Margin="15" Visibility="{Binding IsPrimary, Converter={StaticResource VisibilityConverter}}">
                                        <TextBlock Text="PRIMARY" FontSize="8" FontWeight="Black" Foreground="Black"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Legend / Canvas Controls -->
                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Background="#10FFFFFF" CornerRadius="15" Padding="15,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="MousePointer" Width="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DRAG TO ARRANGE" FontSize="9" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#10FFFFFF" CornerRadius="15" Padding="15,5">
                        <TextBlock Text="SCALE: 1:10" FontSize="9" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: Contextual Intelligence Rail (HCI: Progressive Disclosure) -->
        <Border Grid.Column="1" Padding="30" Background="{DynamicResource SidebarBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="MONITOR PROPERTIES" Style="{StaticResource Caption}" Margin="0,0,0,25" Opacity="0.7"/>

                    <Border Visibility="{Binding SelectedMonitor, Converter={StaticResource VisibilityConverter}}" Style="{StaticResource StandardCard}" Padding="30" Margin="0,0,0,30">
                        <StackPanel>
                            <TextBlock Text="Hardware Identity" FontSize="10" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" Opacity="0.8" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SelectedMonitor.Model}" FontSize="18" FontWeight="Black" Foreground="White" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedMonitor.DeviceID}" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5" Margin="0,5,0,0"/>

                            <Border Background="#0DFFFFFF" Padding="20" CornerRadius="16" Margin="0,25,0,25">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="Resolution" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                                        <TextBlock Text="{Binding SelectedMonitor.CurrentWidth, StringFormat='{}{0} x '}" HorizontalAlignment="Right" Margin="0,0,40,0" FontSize="11" FontWeight="Black" Foreground="White"/>
                                        <TextBlock Text="{Binding SelectedMonitor.CurrentHeight}" HorizontalAlignment="Right" FontSize="11" FontWeight="Black" Foreground="White"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="Refresh Rate" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                                        <TextBlock Text="{Binding SelectedMonitor.RefreshRate, StringFormat='{}{0} Hz'}" HorizontalAlignment="Right" FontSize="11" FontWeight="Black" Foreground="White"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Color State" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                                        <TextBlock Text="HDR ACTIVE" HorizontalAlignment="Right" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}" Visibility="{Binding SelectedMonitor.IsHdrEnabled, Converter={StaticResource VisibilityConverter}}"/>
                                        <TextBlock Text="SDR MODE" HorizontalAlignment="Right" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding SelectedMonitor.IsHdrEnabled, Converter={StaticResource VisibilityConverter}, ConverterParameter='Inverse'}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="INTENT CONTROL" Style="{StaticResource Caption}" Margin="0,0,0,15" Opacity="0.6"/>
                            
                            <Button Command="{Binding IdentifyMonitorCommand}" CommandParameter="{Binding SelectedMonitor}" Style="{StaticResource StandardButton}" Height="50" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Eye" Width="14" Foreground="White" Margin="0,0,15,0"/>
                                    <TextBlock Text="IDENTIFY PHYSICAL DISPLAY" FontWeight="Black" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ApplySettingsCommand}" Style="{StaticResource PrimaryAction}" Height="50">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Check" Width="14" Foreground="White" Margin="0,0,15,0"/>
                                    <TextBlock Text="APPLY SECTOR MAPPING" FontWeight="Black" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="GPU DISK PIPELINE" Style="{StaticResource Caption}" Margin="0,10,0,20" Opacity="0.7"/>
                    <ItemsControl ItemsSource="{Binding Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StandardCard}" Padding="25" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Black" FontSize="16" Foreground="White"/>
                                        <TextBlock Text="{Binding DriverVersion, StringFormat='{}KERNEL DRIVER: {0}'}" FontSize="9" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6" Margin="0,5,0,15"/>
                                        
                                        <Grid>
                                            <TextBlock Text="VRAM STATUS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding VramBytes, Converter={StaticResource SizeConverter}}" HorizontalAlignment="Right" FontSize="10" FontWeight="Black" Foreground="White"/>
                                        </Grid>
                                        <ProgressBar Value="35" Style="{StaticResource GlowingProgressBar}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
            <Border.Effect><BlurEffect Radius="25"/></Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,25"/>
                <TextBlock Text="MAPPING DISPLAY SECTORS..." FontSize="14" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
