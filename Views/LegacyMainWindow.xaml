<Window x:Class="Eternal.Views.LegacyMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:vm="clr-namespace:Eternal.ViewModels"
        xmlns:vmm="clr-namespace:Eternal.ViewModels.Modules"
        xmlns:vmv="clr-namespace:Eternal.Views.Modules"
        xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
        xmlns:converters="clr-namespace:Eternal.Helpers"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="780" Width="1340"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="0.98" To="1.0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="0.98" To="1.0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Pure AMOLED Dark Window Background -->
    <Window.Background>
        <SolidColorBrush Color="#000000"/>
    </Window.Background>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding CommandPaletteVm.OpenCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Module View DataTemplates -->
        <DataTemplate DataType="{x:Type vmm:DashboardViewModel}"><vmv:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:HardwareViewModel}"><vmv:HardwareView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PEModeViewModel}"><vmv:PEModeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BiosViewModel}"><vmv:BiosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SecurityViewModel}"><vmv:SecurityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PerformanceViewModel}"><vmv:PerformanceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DriversViewModel}"><vmv:DriversView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ServicesViewModel}"><vmv:ServicesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:StorageViewModel}"><vmv:StorageView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:NetworkViewModel}"><vmv:NetworkView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ReportsViewModel}"><vmv:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ToolsViewModel}"><vmv:ToolsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SettingsViewModel}"><vmv:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ProcessIntelligenceViewModel}"><vmv:ProcessIntelligenceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ThermalViewModel}"><vmv:ThermalView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:EnvironmentViewModel}"><vmv:EnvironmentView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:VerboseLoggingViewModel}"><vmv:VerboseLoggingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RepairCenterViewModel}"><vmv:RepairCenterView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RegistryViewModel}"><vmv:RegistryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:TuningViewModel}"><vmv:TuningView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ConsoleViewModel}"><vmv:ConsoleView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BootViewModel}"><vmv:BootView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:UserManagementViewModel}"><vmv:UserManagementView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ComponentsViewModel}"><vmv:ComponentsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:WindowsUpdateViewModel}"><vmv:WindowsUpdateView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DisplayViewModel}"><vmv:DisplayView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PcScannerViewModel}"><vmv:PcScannerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DismImagingViewModel}"><vmv:DismImagingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PcRatingViewModel}"><vmv:PcRatingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SnapshotsViewModel}"><vmv:SnapshotsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:HardwareStressViewModel}"><vmv:HardwareStressView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:CommandPaletteViewModel}"><helpers:CommandPaletteOverlay/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PrivacyViewModel}"><vmv:PrivacyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BatteryViewModel}"><vmv:BatteryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FileForensicsViewModel}"><vmv:FileForensicsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FeatureTogglesViewModel}"><vmv:FeatureTogglesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FlagsViewModel}"><vmv:FlagsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ConfigEditorViewModel}"><vmv:ConfigEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:WmiExplorerViewModel}"><vmv:WmiExplorerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:AppProfilerViewModel}"><vmv:AppProfilerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:HomeGridDashboardViewModel}"><vmv:HomeGridDashboard/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:CategoryGridViewModel}"><vmv:CategoryGridView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RegistryLexiconViewModel}"><vmv:RegistryLexiconView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ExplorerViewModel}"><vmv:ExplorerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:NetworkMonitorViewModel}"><vmv:NetworkMonitorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:AppManagerViewModel}"><vmv:AppManagerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:MemoryInspectorViewModel}"><vmv:MemoryInspectorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PortScannerViewModel}"><vmv:PortScannerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DriverKernelViewModel}"><vmv:DriverKernelView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DiskSectorViewModel}"><vmv:DiskSectorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:TestingViewModel}"><vmv:TestingView/></DataTemplate>

        <!-- Pure AMOLED Dynamic Navigation Rail Item Template -->
        <DataTemplate x:Key="FluentNavItemTemplate">
            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding ViewName}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Margin="0,2" Padding="0" Background="Transparent" BorderThickness="0" Height="36"
                    ToolTip="{Binding Name}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="10,0" Margin="4,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="IconCol" Width="28"/> <!-- Icon Container -->
                                                <ColumnDefinition Width="*"/>    <!-- Text Label -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <fa:ImageAwesome Grid.Column="0" Icon="{Binding Icon}" Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <fa:ImageAwesome.Style>
                                                    <Style TargetType="fa:ImageAwesome">
                                                        <Setter Property="Foreground" Value="#888896"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </fa:ImageAwesome.Style>
                                            </fa:ImageAwesome>

                                            <!-- Text Title -->
                                            <TextBlock x:Name="NavText" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888896"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#14141E"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#121C2B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                            <Setter TargetName="ItemBorder" Property="Padding" Value="4,0"/>
                                            <Setter TargetName="ItemBorder" Property="Margin" Value="2,0"/>
                                            <Setter TargetName="IconCol" Property="Width" Value="*"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
        </Grid.LayoutTransform>

        <!-- Application Pure AMOLED Layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- AMOLED Top Command Bar -->
                <RowDefinition Height="*"/>  <!-- Navigation Rail + Main View Area -->
                <RowDefinition Height="32"/> <!-- Diagnostics Status Footer Bar -->
            </Grid.RowDefinitions>

            <!-- Row 0: Pure AMOLED Header -->
            <Border Grid.Row="0" Background="#000000" BorderBrush="#1C1C26" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Hamburger Toggle + Brand Emblem -->
                        <ColumnDefinition Width="*"/>    <!-- Quick Search Command Palette -->
                        <ColumnDefinition Width="Auto"/> <!-- Right Actions / System Info -->
                    </Grid.ColumnDefinitions>

                        <!-- Left: Nav Toggle & Eternal Emblem (Triple-Click Core Orbital Visualizer) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Sidebar Collapsible Toggle Button -->
                            <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource FluentNavToggleStyle}" ToolTip="Toggle Collapsible Navigation Rail">
                                <fa:ImageAwesome Icon="Bars" Width="14" Foreground="#888896"/>
                            </Button>

                            <StackPanel MouseLeftButtonDown="EternalLogo_MouseLeftButtonDown" Cursor="Hand" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/logo.png" Width="22" Height="22" Margin="4,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                                <TextBlock Text="ETERNAL" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Border Background="#1A0078D4" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM INTELLIGENCE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </Border>

                            <Border Background="#20F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BETA" FontSize="8" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </Border>
                                
                                <!-- VS Debugger Attached / Testing Mode Pill Badge -->
                                <Border Visibility="{Binding IsVsDebuggerAttached, Converter={StaticResource VisibilityConverter}}" Background="#30EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="VS DEBUGGER ATTACHED • TESTING MODE" FontSize="8" FontWeight="Black" Foreground="#EF4444" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                        </StackPanel>

                    <!-- Center: AMOLED Search Action Bar -->
                    <Button Grid.Column="1" Command="{Binding CommandPaletteVm.OpenCommand}" HorizontalAlignment="Stretch" MaxWidth="420" VerticalAlignment="Center" Height="32" Margin="20,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SearchBorder" Background="#08080C" BorderBrush="#1C1C28" BorderThickness="1" CornerRadius="8">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Grid.Column="0" Icon="Search" Width="12" Foreground="#666675" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="Search actions &amp; diagnostic macros..." FontSize="11" Foreground="#666675" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="#161622" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Ctrl + K" FontSize="9" FontWeight="SemiBold" Foreground="#888896"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SearchBorder" Property="Background" Value="#101018"/>
                                        <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Right: Quick Status Actions & User Identity -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- WinPE Mode Pill (If Active) -->
                        <Border Visibility="{Binding IsPeMode, Converter={StaticResource VisibilityConverter}}" Background="#201400" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="ExclamationTriangle" Width="10" Foreground="#F59E0B" Margin="0,0,6,0"/>
                                <TextBlock Text="WINPE RECOVERY MODE" FontSize="9" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>

                        <!-- User Greeting & Windows Role Badge (5-click Net User Inspector) -->
                        <Border MouseLeftButtonDown="UserGreetingBadge_MouseLeftButtonDown" Cursor="Hand" IsEnabled="{Binding IsAuthenticated}" Background="#0C0C14" BorderBrush="#1F1F2E" BorderThickness="1" CornerRadius="8" Padding="6,4,10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Mini Circular Profile Avatar -->
                                <Grid Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Width="22" Height="22" Fill="#141420" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"/>
                                    <fa:ImageAwesome Icon="UserCircle" Width="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="20" Height="20" Visibility="{Binding HasUserProfileImage, Converter={StaticResource VisibilityConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding UserProfileImage}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="{Binding CurrentUserGreeting}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="#1A0078D4" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserRoleBadge}" FontSize="8" FontWeight="Black" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Lock / Logout Workstation Action Button -->
                        <Button Command="{Binding LockWorkstationCommand}" IsEnabled="{Binding IsAuthenticated}" Style="{StaticResource FluentHeaderIconButton}" ToolTip="Lock Workstation / Logout" Margin="0,0,6,0">
                            <fa:ImageAwesome Icon="Lock" Width="13" Foreground="#EF4444"/>
                        </Button>

                        <!-- Settings Quick Access Button (Upper Right) -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" IsEnabled="{Binding IsAuthenticated}" Style="{StaticResource FluentHeaderIconButton}" ToolTip="Settings" Margin="0,0,6,0">
                            <fa:ImageAwesome Icon="Gear" Width="13" Foreground="White"/>
                        </Button>

                        <!-- Eternal Console Quick Access Button -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Console" IsEnabled="{Binding IsAuthenticated}" Style="{StaticResource FluentHeaderIconButton}" ToolTip="Eternal Diagnostic Console" Margin="0,0,6,0">
                            <fa:ImageAwesome Icon="Terminal" Width="13" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Workspace Split (Pure AMOLED Sidebar + Content Area) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar Column width bound to IsSidebarExpanded -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Pure AMOLED Navigation Rail Container -->
                <Border Grid.Column="0" Background="#000000" BorderBrush="#1C1C26" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="230"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <Setter Property="Width" Value="64"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <ScrollViewer Style="{StaticResource ThinDarkScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="VerticalOnly">
                        <StackPanel Margin="6,12,6,12">
                            <!-- Category: System Diagnostics -->
                            <TextBlock Text="SYSTEM DIAGNOSTICS" FontSize="9" FontWeight="Bold" Foreground="#555562" Margin="10,4,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SystemItems}" ItemTemplate="{StaticResource FluentNavItemTemplate}"/>
                            
                            <!-- Category: Telemetry & Hardware -->
                            <TextBlock Text="TELEMETRY &amp; HARDWARE" FontSize="9" FontWeight="Bold" Foreground="#555562" Margin="10,16,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding TelemetryItems}" ItemTemplate="{StaticResource FluentNavItemTemplate}"/>
                            
                            <!-- Category: Optimization & Repair -->
                            <TextBlock Text="OPTIMIZATION &amp; REPAIR" FontSize="9" FontWeight="Bold" Foreground="#555562" Margin="10,16,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding MonitoringItems}" ItemTemplate="{StaticResource FluentNavItemTemplate}"/>
                            
                            <!-- Category: Support & WinPE -->
                            <TextBlock Text="SUPPORT &amp; WINDOWS PE" FontSize="9" FontWeight="Bold" Foreground="#555562" Margin="10,16,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SupportItems}" ItemTemplate="{StaticResource FluentNavItemTemplate}"/>

                            <!-- Category: Dev Testing -->
                            <StackPanel Visibility="{Binding IsTestingModeActive, Converter={StaticResource VisibilityConverter}}">
                                <TextBlock Text="DEV TESTING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="10,16,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding DevToolkitItems}" ItemTemplate="{StaticResource FluentNavItemTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Main Content Canvas with Pure AMOLED Background -->
                <Grid Grid.Column="1" Background="#000000">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Canvas Sub-Header Title -->
                        <RowDefinition Height="*"/>    <!-- View Host -->
                    </Grid.RowDefinitions>

                    <!-- Active View Breadcrumb Bar -->
                    <Border Grid.Row="0" Background="#000000" BorderBrush="#1C1C26" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:ImageAwesome Icon="FolderOpen" Width="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CurrentViewTitle}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ZoomPercentageString, StringFormat='Scale: {0}'}" FontSize="10" Foreground="#666675" Margin="0,0,10,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dynamic View Host (AMOLED Deep Dark Base with Smooth Navigation Animations) -->
                    <Border Grid.Row="1" Background="#040406" Padding="0" ClipToBounds="True">
                        <ContentControl Content="{Binding CurrentView, NotifyOnTargetUpdated=True}" RenderTransformOrigin="0.5,0.5">
                            <ContentControl.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ContentControl.Triggers>
                            <ContentControl.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </ContentControl.RenderTransform>
                        </ContentControl>
                    </Border>
                </Grid>
            </Grid>

            <!-- Row 2: Diagnostics Status Footer Bar (Pure AMOLED Telemetry) -->
            <Border Grid.Row="2" Background="#000000" BorderBrush="#1C1C26" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Telemetry Metrics -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- System Uptime -->
                        <fa:ImageAwesome Icon="History" Foreground="#666675" Width="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Uptime:" Foreground="#666675" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Uptime}" Foreground="#CCCCCC" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>

                        <!-- CPU Load Bar -->
                        <fa:ImageAwesome Icon="Microchip" Foreground="{DynamicResource AccentBrush}" Width="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU:" Foreground="#666675" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Width="60" Height="6" Background="#161622" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0">
                            <ProgressBar Value="{Binding CpuUsageValue}" Minimum="0" Maximum="100" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                        </Border>
                        <TextBlock Text="{Binding CpuUsage}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,24,0"/>

                        <!-- RAM Load Bar -->
                        <fa:ImageAwesome Icon="Tasks" Foreground="#10B981" Width="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RAM:" Foreground="#666675" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Width="60" Height="6" Background="#161622" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0">
                            <ProgressBar Value="{Binding RamUsageValue}" Minimum="0" Maximum="100" Background="Transparent" Foreground="#10B981" BorderThickness="0"/>
                        </Border>
                        <TextBlock Text="{Binding RamUsage}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    </StackPanel>

                    <!-- Right: Engine & Security Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- VS Debugger Active / Testing Mode Footer Pill -->
                        <Border Visibility="{Binding IsVsDebuggerAttached, Converter={StaticResource VisibilityConverter}}" Background="#25EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="VS DEBUGGER ACTIVE: TESTING MODE" FontSize="9" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1000FF99" BorderBrush="#1C00FF99" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="WORKSTATION ENGINE: ONLINE" FontSize="9" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="v3.5.5 (BETA)" Foreground="#555562" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Global Toast Notification Overlays -->
        <ItemsControl VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20,60,20,0" Panel.ZIndex="999" ItemsSource="{Binding ToastVm.ActiveToasts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0C0C14" CornerRadius="8" BorderBrush="#26263A" BorderThickness="1" Margin="0,0,0,10" Padding="14,10" Width="320">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.7"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <fa:ImageAwesome Grid.Column="0" Icon="{Binding Severity, Converter={StaticResource CategoryToIconConverter}, ConverterParameter='Toast'}" 
                                            Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center"
                                            Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- macOS-Style Cyberpunk Quick Settings Control Center Flyout Modal -->
        <Grid Visibility="{Binding IsControlCenterVisible, Converter={StaticResource VisibilityConverter}}" Background="#80000000" Panel.ZIndex="350">
            <!-- Background Backdrop Dismiss Click -->
            <Border Background="Transparent" MouseLeftButtonDown="ControlCenterBackdrop_Click"/>

            <Border Width="360" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,55,20,0" Background="#09090F" BorderBrush="#1F1F2E" BorderThickness="1.5" CornerRadius="14" Padding="18">
                <Border.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="30" ShadowDepth="4" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <!-- Main Content Panel (Blurred and Disabled when IsControlCenterEnabled is false) -->
                    <StackPanel IsEnabled="{Binding IsControlCenterEnabled}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsControlCenterEnabled}" Value="False">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="14" KernelType="Gaussian"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    <!-- Account & Identity Header Card -->
                    <Border Background="#0E0E18" BorderBrush="#1A1A28" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar -->
                            <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse Width="42" Height="42" Fill="#141420" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
                                <fa:ImageAwesome Icon="UserCircle" Width="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="40" Height="40" Visibility="{Binding HasUserProfileImage, Converter={StaticResource VisibilityConverter}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding UserProfileImage}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <!-- Name & Username -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserFullName}" FontSize="14" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="{Binding CurrentUsernameOnly}" FontSize="10" FontWeight="SemiBold" Foreground="#888896"/>
                            </StackPanel>
                            <!-- Admin Role Badge -->
                            <Border Grid.Column="2" Background="#1A0078D4" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserRoleBadge}" FontSize="9" FontWeight="Black" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Connectivity 2x2 Grid (Wi-Fi, Bluetooth, Do Not Disturb, Night Light) -->
                    <UniformGrid Columns="2" Margin="0,0,0,14">
                        <!-- Wi-Fi Toggle -->
                        <Border Background="#0C0C14" BorderBrush="#1C1C2B" BorderThickness="1" CornerRadius="10" Margin="0,0,4,4" Padding="12,8" Height="52">
                            <Button Command="{Binding ToggleWifiCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="Wifi" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Wi-Fi" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding WifiSsid}" FontSize="9" Foreground="#888896" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Bluetooth Toggle -->
                        <Border Background="#0C0C14" BorderBrush="#1C1C2B" BorderThickness="1" CornerRadius="10" Margin="4,0,0,4" Padding="12,8" Height="52">
                            <Button Command="{Binding ToggleBluetoothCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="BluetoothB" Width="16" Height="16" Foreground="#3B82F6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Bluetooth" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding BluetoothStatus}" FontSize="9" Foreground="#888896" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Do Not Disturb Toggle -->
                        <Border Background="#0C0C14" BorderBrush="#1C1C2B" BorderThickness="1" CornerRadius="10" Margin="0,4,4,0" Padding="12,8" Height="52">
                            <Button Command="{Binding ToggleDoNotDisturbCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="BellSlash" Width="16" Height="16" Foreground="#EC4899" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Do Not Disturb" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,0,0,2"/>
                                        <TextBlock Text="Focus Active" FontSize="9" Foreground="#888896"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Night Light Toggle -->
                        <Border Background="#0C0C14" BorderBrush="#1C1C2B" BorderThickness="1" CornerRadius="10" Margin="4,4,0,0" Padding="12,8" Height="52">
                            <Button Command="{Binding ToggleNightLightCommand}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa:ImageAwesome Icon="LightbulbOutline" Width="16" Height="16" Foreground="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Night Light" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,0,0,2"/>
                                        <TextBlock Text="Warm Tint" FontSize="9" Foreground="#888896"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Border>
                    </UniformGrid>

                    <!-- Master System Volume Slider -->
                    <Border Background="#0D0D14" BorderBrush="#191926" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <fa:ImageAwesome Grid.Column="0" Icon="VolumeUp" Width="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" Value="{Binding MasterVolumeLevel, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding MasterVolumeLevel, StringFormat='{}{0:0}%'}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Performance Preset Pills -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="PERFORMANCE PROFILE PRESETS" FontSize="8" FontWeight="Black" Foreground="#888896" Margin="0,0,0,6"/>
                        <UniformGrid Columns="3">
                            <Button Command="{Binding SelectPowerPresetCommand}" CommandParameter="Eco" Style="{StaticResource StandardButton}" Height="28" Margin="0,0,3,0">
                                <TextBlock Text="Eco Power" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                            </Button>
                            <Button Command="{Binding SelectPowerPresetCommand}" CommandParameter="Balanced" Style="{StaticResource StandardButton}" Height="28" Margin="3,0,3,0">
                                <TextBlock Text="Balanced" FontSize="9" FontWeight="Bold" Foreground="#00E5FF"/>
                            </Button>
                            <Button Command="{Binding SelectPowerPresetCommand}" CommandParameter="Gaming" Style="{StaticResource StandardButton}" Height="26" Margin="3,0,0,0">
                                <TextBlock Text="Gaming Turbo" FontSize="9" FontWeight="Bold" Foreground="#EC4899"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Power Actions Grid (Lock, Sleep, Restart, Shutdown) -->
                    <UniformGrid Columns="4">
                        <Button Command="{Binding ExecuteControlCenterPowerActionCommand}" CommandParameter="Lock" Style="{StaticResource StandardButton}" Height="36" Margin="0,0,2,0" ToolTip="Lock Workstation">
                            <fa:ImageAwesome Icon="Lock" Width="14" Height="14" Foreground="#EF4444"/>
                        </Button>
                        <Button Command="{Binding ExecuteControlCenterPowerActionCommand}" CommandParameter="Sleep" Style="{StaticResource StandardButton}" Height="36" Margin="2,0,2,0" ToolTip="Sleep Mode">
                            <fa:ImageAwesome Icon="Bed" Width="14" Height="14" Foreground="#3B82F6"/>
                        </Button>
                        <Button Command="{Binding ExecuteControlCenterPowerActionCommand}" CommandParameter="Restart" Style="{StaticResource StandardButton}" Height="36" Margin="2,0,2,0" ToolTip="Restart System">
                            <fa:ImageAwesome Icon="Refresh" Width="14" Height="14" Foreground="#F59E0B"/>
                        </Button>
                        <Button Command="{Binding ExecuteControlCenterPowerActionCommand}" CommandParameter="Shutdown" Style="{StaticResource StandardButton}" Height="36" Margin="2,0,0,0" ToolTip="Shut Down System">
                            <fa:ImageAwesome Icon="PowerOff" Width="14" Height="14" Foreground="#EF4444"/>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Feature Disabled Overlay (Visible when IsControlCenterEnabled is false) -->
                <Border Visibility="{Binding IsControlCenterEnabled, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Background="#E006060A" CornerRadius="12" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Lock" Width="28" Height="28" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="FEATURE DISABLED" FontSize="14" FontWeight="Black" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Quick Settings Control Center is disabled by Experimental Testing Flags." FontSize="10" Foreground="#888896" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

        <!-- Command Palette Modal Overlay Host -->
        <ContentControl Panel.ZIndex="400" Content="{Binding CommandPaletteVm}" Visibility="{Binding CommandPaletteVm.IsOpen, Converter={StaticResource VisibilityConverter}}"/>

        <!-- Full-Bleed AMOLED Blackout Buffer Overlay Host (Active during post-auth transition to prevent dashboard flash) -->
        <Grid Visibility="{Binding IsBlackoutActive, Converter={StaticResource VisibilityConverter}}" Panel.ZIndex="997" Background="#030305"/>

        <!-- Post-Auth Animated Telemetry & Tips Overlay Host -->
        <Grid Visibility="{Binding IsPostAuthSplashVisible, Converter={StaticResource VisibilityConverter}}" Opacity="{Binding PostAuthSplashOpacity}" Panel.ZIndex="998" Background="#030305">
            <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Logo & Eternal Branding -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Image Source="/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#0078D4" BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="ETERNAL" Foreground="#FFFFFF" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="SYSTEM INTELLIGENCE" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0" Opacity="0.9"/>
                </StackPanel>

                <!-- Hello [Username] -->
                <TextBlock Text="{Binding CurrentUserGreeting}" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding PostAuthSplashStatusText}" Foreground="#888896" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,22"/>
                <!-- Status Bar 0-100 Style -->
                <Border Height="8" Background="#12121D" BorderBrush="#1F1F2E" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" ClipToBounds="True">
                    <ProgressBar Value="{Binding PostAuthSplashProgress}" Minimum="0" Maximum="100" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                </Border>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="INITIALIZATION PROGRESS" Foreground="#555566" FontSize="9" FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding PostAuthSplashProgress, StringFormat='{}{0:0}%'}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Monospace Terminal Live Telemetry Ticker -->
                <Border Background="#08080F" BorderBrush="#141420" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,18">
                    <TextBlock Text="{Binding SplashTelemetryTicker}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Dynamic Workstation Tip Card -->
                <Border Background="#0B0B12" BorderBrush="#1A1A28" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Grid.Column="0" Icon="LightbulbOutline" Width="14" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding PostAuthSplashTip}" Foreground="#A0A0B2" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Embedded Full-Bleed AMOLED Strict Login Overlay (Active when IsAuthenticated is False) -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}" Opacity="{Binding LoginOverlayOpacity}" Panel.ZIndex="999" Background="#030305">
            <!-- Ambient Cyberpunk Glowing Bokeh Aura Canvas Background -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Width="350" Height="350" Fill="#0078D4" Canvas.Left="-50" Canvas.Top="-50" Opacity="0.08">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#00E5FF" BlurRadius="120" ShadowDepth="0"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="400" Height="400" Fill="#7F00FF" Canvas.Right="-80" Canvas.Bottom="-80" Opacity="0.06">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#7F00FF" BlurRadius="150" ShadowDepth="0"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Matrix Cyber Rain Text Canvas -->
                <TextBlock Text="01010011 01010101 01000100 01001111 01001001 01000001 01001101 01000101 01001010" FontFamily="Consolas" FontSize="11" Foreground="#00F0FF" Opacity="0.04" Canvas.Left="40" Canvas.Top="80"/>
                <TextBlock Text="ETERNAL SYSTEM INTELLIGENCE v3.5.5 // RING-0 KERNEL AUDIT ACTIVE // SAM STRICT IDENTITY VALIDATION" FontFamily="Consolas" FontSize="10" Foreground="#10B981" Opacity="0.05" Canvas.Right="40" Canvas.Bottom="120"/>
            </Canvas>

            <StackPanel x:Name="LoginContainerPanel" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="1">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LoginScale" ScaleX="0.94" ScaleY="0.94"/>
                        <TranslateTransform x:Name="LoginTranslate" Y="20"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="StackPanel.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LoginContainerPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="LoginScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="LoginScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="LoginTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                <!-- Header Branding -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Image Source="/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Image.Effect>
                            <DropShadowEffect Color="#0078D4" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="ETERNAL" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="STRICT WORKSTATION IDENTITY" FontSize="9" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Opacity="0.9"/>
                        <Border Background="#20F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v3.5.5 BETA" FontSize="7.5" FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- User Profile Identity Header (Circular Avatar + Full Name + Username Subheader) -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <!-- Circular User Profile Avatar Ring with Electric Cyber Neon Breathing Surround -->
                    <Grid Width="106" Height="106" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <!-- Outer Diffuse Cyber Neon Halo (Cyan #00F0FF) -->
                        <Ellipse x:Name="ProfileOuterNeon" Width="102" Height="102" Stroke="#00F0FF" StrokeThickness="1.5" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="NeonScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="ProfileOuterNeonEffect" Color="#00F0FF" BlurRadius="45" ShadowDepth="0" Opacity="1.0"/>
                            </Ellipse.Effect>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="ProfileOuterNeon"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0.9"
                                                             Duration="0:0:2.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ProfileOuterNeonEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             From="20" To="55"
                                                             Duration="0:0:2.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NeonScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.97" To="1.04"
                                                             Duration="0:0:2.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NeonScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.97" To="1.04"
                                                             Duration="0:0:2.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- Inner Electric Core Neon Ring -->
                        <Ellipse x:Name="ProfileInnerNeon" Width="84" Height="84" Stroke="#00F0FF" StrokeThickness="2.5">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="ProfileInnerNeonEffect" Color="#00E5FF" BlurRadius="25" ShadowDepth="0" Opacity="0.95"/>
                            </Ellipse.Effect>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="ProfileInnerNeonEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             From="12" To="32"
                                                             Duration="0:0:2.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Width="78" Height="78" Fill="#0D0D14"/>
                        <!-- Fallback User Icon -->
                        <fa:ImageAwesome Icon="User" Width="36" Height="36" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Actual Windows Account Picture if Available -->
                        <Ellipse Width="78" Height="78" Visibility="{Binding HasUserProfileImage, Converter={StaticResource VisibilityConverter}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding UserProfileImage}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <!-- SAM Full Name Header -->
                    <TextBlock Text="{Binding UserFullName}" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <!-- Username Subheader -->
                    <TextBlock Text="{Binding CurrentUsernameOnly}" FontSize="12" FontWeight="SemiBold" Foreground="#888896" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Auth Input Form -->
                <StackPanel Margin="0,0,0,10">
                    <!-- Password Input Field -->
                    <StackPanel Margin="0,0,0,22" IsEnabled="{Binding IsPasswordAuthEnabled}" Visibility="{Binding IsPasswordAuthEnabled, Converter={StaticResource VisibilityConverter}}">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="WINDOWS ACCOUNT PASSWORD / PIN" Style="{StaticResource Caption}" FontSize="9" Foreground="#888896" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <!-- Caps Lock Live Warning Badge -->
                            <Border Visibility="{Binding IsCapsLockOn, Converter={StaticResource VisibilityConverter}}" Background="#2B1A00" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="ExclamationTriangle" Width="9" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Caps Lock is ON" FontSize="8" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#0D0D14" BorderBrush="#1F1F2E" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <fa:ImageAwesome Grid.Column="0" Icon="Lock" Width="14" Foreground="#888896" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <!-- Masked Password Box -->
                                <PasswordBox Grid.Column="1" x:Name="OverlayPasswordBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" KeyDown="OverlayPasswordBox_KeyDown" PasswordChanged="OverlayPasswordBox_PasswordChanged" IsEnabled="{Binding IsPasswordAuthEnabled}" Visibility="{Binding IsPasswordRevealed, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}"/>

                                <!-- Revealed Password Text Box -->
                                <TextBox Grid.Column="1" x:Name="RevealedPasswordTextBox" Text="{Binding RevealedPasswordText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" KeyDown="RevealedPasswordTextBox_KeyDown" TextChanged="RevealedPasswordTextBox_TextChanged" IsEnabled="{Binding IsPasswordAuthEnabled}" Visibility="{Binding IsPasswordRevealed, Converter={StaticResource VisibilityConverter}}"/>

                                <!-- Show/Hide Eye Toggle Button -->
                                <Button Grid.Column="2" Click="PasswordEyeToggle_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Show/Hide Password">
                                    <fa:ImageAwesome Icon="Eye" Width="14" Foreground="#888896"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Enter Button -->
                    <Button Click="OverlayEnterButton_Click" IsEnabled="{Binding IsPasswordAuthEnabled}" Visibility="{Binding IsPasswordAuthEnabled, Converter={StaticResource VisibilityConverter}}" Style="{StaticResource PrimaryButton}" Height="46" Cursor="Hand" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="Key" Width="14" Foreground="Black" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ENTER WORKSTATION" FontWeight="Black" FontSize="12" Foreground="Black" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Windows Hello Button -->
                    <Button Click="OverlayWindowsHelloButton_Click" IsEnabled="{Binding IsWindowsHelloAuthEnabled}" Visibility="{Binding IsWindowsHelloAuthEnabled, Converter={StaticResource VisibilityConverter}}" Style="{StaticResource StandardButton}" Height="40" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="Windows" Width="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Use Windows Hello" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Inactivity Auto-Logout Notification Banner -->
                <Border Visibility="{Binding WasLoggedOutDueToInactivity, Converter={StaticResource VisibilityConverter}}" Background="#2B1A00" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,14,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="ClockOutline" Width="12" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding InactivityNoticeMessage}" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Footer Status -->
                <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="{Binding AuthStatusMessage}" FontSize="10" Foreground="{Binding AuthStatusColor}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>

                <!-- Security Audit HUD Badge -->
                <Border Background="#08080E" BorderBrush="#161622" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,14,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Shield" Width="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SecurityAuditHudText}" FontSize="9" FontWeight="SemiBold" Foreground="#666675" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Cyber Matrix Digital Mode Overlay Grid (Konami Code Easter Egg) -->
        <Grid x:Name="MatrixOverlayGrid" Visibility="Collapsed" Panel.ZIndex="10000" Background="#F0030508" IsHitTestVisible="False">
            <Border Background="#0C141C" BorderBrush="#00FF66" BorderThickness="1.5" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <fa:ImageAwesome Icon="Terminal" Width="14" Foreground="#00FF66" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CYBER MATRIX VECTOR HUD [UNLOCKED]" FontSize="13" FontWeight="Black" Foreground="#00FF66"/>
                    </StackPanel>
                    <TextBlock Text="CPU VECTOR INSTRUCTIONS &amp; KERNEL CAPABILITIES:" FontSize="10" FontWeight="Bold" Foreground="#888896" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Width="420">
                        <TextBlock Text="• AVX2 Vector Extensions: ACTIVE" FontSize="11" FontFamily="Consolas" Foreground="#00FF66" Margin="0,3"/>
                        <TextBlock Text="• AVX-512 Instruction Set: READY" FontSize="11" FontFamily="Consolas" Foreground="#00FF66" Margin="0,3"/>
                        <TextBlock Text="• AES-NI Hardware Crypto: ACTIVE" FontSize="11" FontFamily="Consolas" Foreground="#00FF66" Margin="0,3"/>
                        <TextBlock Text="• SHA-NI Engine: ENGAGED" FontSize="11" FontFamily="Consolas" Foreground="#00FF66" Margin="0,3"/>
                        <TextBlock Text="• RDRAND Entropy Provider: OK" FontSize="11" FontFamily="Consolas" Foreground="#00FF66" Margin="0,3"/>
                        <TextBlock Text="• Hypervisor Tracing Guard: ACTIVE" FontSize="11" FontFamily="Consolas" Foreground="#00FF66" Margin="0,3"/>
                    </UniformGrid>
                    <TextBlock Text="Press ESC or type Konami Code again to exit Cyber Matrix Mode" FontSize="9" Foreground="#666675" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>