<Window x:Class="Eternal.Views.LegacyMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:vm="clr-namespace:Eternal.ViewModels"
        xmlns:vmm="clr-namespace:Eternal.ViewModels.Modules"
        xmlns:vmv="clr-namespace:Eternal.Views.Modules"
        xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
        xmlns:converters="clr-namespace:Eternal.Helpers"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1280"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico"
        KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="0.98" To="1.0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="0.98" To="1.0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="{DynamicResource BackgroundGradientColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource BackgroundColor}" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding CommandPaletteVm.OpenCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmm:DashboardViewModel}"><vmv:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:HardwareViewModel}"><vmv:HardwareView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PEModeViewModel}"><vmv:PEModeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BiosViewModel}"><vmv:BiosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SecurityViewModel}"><vmv:SecurityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PerformanceViewModel}"><vmv:PerformanceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DriversViewModel}"><vmv:DriversView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ServicesViewModel}"><vmv:ServicesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:StorageViewModel}"><vmv:StorageView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:NetworkViewModel}"><vmv:NetworkView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ReportsViewModel}"><vmv:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ToolsViewModel}"><vmv:ToolsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SettingsViewModel}"><vmv:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ProcessIntelligenceViewModel}"><vmv:ProcessIntelligenceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ThermalViewModel}"><vmv:ThermalView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:EnvironmentViewModel}"><vmv:EnvironmentView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:VerboseLoggingViewModel}"><vmv:VerboseLoggingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RepairCenterViewModel}"><vmv:RepairCenterView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RegistryViewModel}"><vmv:RegistryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:TuningViewModel}"><vmv:TuningView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ConsoleViewModel}"><vmv:ConsoleView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BootViewModel}"><vmv:BootView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:UserManagementViewModel}"><vmv:UserManagementView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ComponentsViewModel}"><vmv:ComponentsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:WindowsUpdateViewModel}"><vmv:WindowsUpdateView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DisplayViewModel}"><vmv:DisplayView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PcScannerViewModel}"><vmv:PcScannerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DismImagingViewModel}"><vmv:DismImagingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PcRatingViewModel}"><vmv:PcRatingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SnapshotsViewModel}"><vmv:SnapshotsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:HardwareStressViewModel}"><vmv:HardwareStressView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:CommandPaletteViewModel}"><helpers:CommandPaletteOverlay/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PrivacyViewModel}"><vmv:PrivacyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BatteryViewModel}"><vmv:BatteryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FileForensicsViewModel}"><vmv:FileForensicsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FeatureTogglesViewModel}"><vmv:FeatureTogglesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FlagsViewModel}"><vmv:FlagsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ConfigEditorViewModel}"><vmv:ConfigEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:WmiExplorerViewModel}"><vmv:WmiExplorerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:AppProfilerViewModel}"><vmv:AppProfilerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:TestingViewModel}"><vmv:TestingView/></DataTemplate>
    </Window.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Status Bar (HCI: Persistent Context) -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="11" Background="{DynamicResource BackgroundBrush}">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Menu Toggle Logo -->
                    <ToggleButton x:Name="MenuToggle" Background="Transparent" BorderThickness="0" Margin="0,0,20,0" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Padding="5">
                                    <Image Source="/Assets/logo.png" Width="24" Height="24">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <TextBlock Text="System Status: " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Healthy" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    
                    <Button Command="{Binding CommandPaletteVm.OpenCommand}" Style="{StaticResource IconButton}" Margin="20,0,0,0" ToolTip="Universal Search (Ctrl+K)" FocusVisualStyle="{StaticResource FocusVisual}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Search" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5" Margin="0,0,8,0"/>
                            <Border Background="#20FFFFFF" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="CTRL + K" FontSize="8" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Microchip" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU: " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CpuUsage}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ProgressBar Value="{Binding CpuUsageValue}" Width="40" Style="{StaticResource GlowingProgressBar}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Tasks" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RAM: " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RamUsage}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ProgressBar Value="{Binding RamUsageValue}" Width="40" Style="{StaticResource GlowingProgressBar}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="ClockOutline" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Uptime: " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Uptime}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="15,0"/>

                    <Button Command="{Binding ToggleUICommand}" Style="{StaticResource IconButton}" ToolTip="Switch to Modern UI">
                        <fa:ImageAwesome Icon="Exchange" Width="14" Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (HCI: Elastic Sidebar) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Drawer -->
            <Border Grid.Column="0" x:Name="MainSidebar" 
                    Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                    Width="0" HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" Direction="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, ElementName=MenuToggle}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=MenuToggle}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=MainSidebar}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="260" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Width="260">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Grid.Row="0" Margin="25,25,25,15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextBrush}"/>
                            <Border Background="#9B59B6" CornerRadius="3" VerticalAlignment="Center" Margin="8,0,0,0" Padding="5,1">
                                <TextBlock Text="DEV PREVIEW" FontSize="8" FontWeight="Black" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="SYSTEM INTELLIGENCE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6" Margin="0,0,0,15"/>

                        <!-- Nav Sorting -->
                        <ComboBox SelectedValue="{Binding NavSortOption}" SelectedValuePath="Tag"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Padding="8,4"
                                    HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Default" Tag="{x:Static vm:NavigationSortOption.Default}"/>
                            <ComboBoxItem Content="Level" Tag="{x:Static vm:NavigationSortOption.Level}"/>
                            <ComboBoxItem Content="Easy to Hard" Tag="{x:Static vm:NavigationSortOption.EasyToHard}"/>
                            <ComboBoxItem Content="Alphabetical" Tag="{x:Static vm:NavigationSortOption.Alphabetical}"/>
                            <ComboBoxItem Content="Safe to Dangerous" Tag="{x:Static vm:NavigationSortOption.SafeToDangerous}"/>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                    <Grid Width="240">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                        <fa:ImageAwesome Grid.Column="1" Icon="Sort" Width="10" Foreground="{TemplateBinding Foreground}" Margin="0,0,10,0"/>
                                                        <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}">
                                                                <ScrollViewer SnapsToDevicePixels="True">
                                                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
                        <StackPanel Margin="10,0">
                            <StackPanel.Resources>
                                <DataTemplate x:Key="NavItemTemplate">
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding ViewName}"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,1"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Height="40">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                                    <GradientStop Color="Transparent" Offset="0.8"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid Width="240">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="ActiveMark" Style="{StaticResource ActiveMarker}" Margin="0,0,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                                </Border.Effect>
                                            </Border>

                                            <fa:ImageAwesome Grid.Column="0" Icon="{Binding Icon}" Width="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <fa:ImageAwesome.Style>
                                                    <Style TargetType="fa:ImageAwesome">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </fa:ImageAwesome.Style>
                                            </fa:ImageAwesome>
                                            
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Margin="5,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </StackPanel.Resources>

                            <TextBlock Text="SYSTEM" Style="{StaticResource Caption}" Margin="15,10,0,10" Opacity="0.5"/>
                            <ItemsControl ItemsSource="{Binding SystemItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                            <TextBlock Text="CORE TELEMETRY" Style="{StaticResource Caption}" Margin="15,20,0,10" Opacity="0.5"/>
                            <ItemsControl ItemsSource="{Binding TelemetryItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                            <TextBlock Text="ACTIVE MONITORING" Style="{StaticResource Caption}" Margin="15,20,0,10" Opacity="0.5"/>
                            <ItemsControl ItemsSource="{Binding MonitoringItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                            <TextBlock Text="SUPPORT &amp; SAFETY" Style="{StaticResource Caption}" Margin="15,20,0,10" Opacity="0.5"/>
                            <ItemsControl ItemsSource="{Binding SupportItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                            <TextBlock Text="DEVELOPER TOOLKIT" Margin="15,20,0,10" Opacity="0.5" 
                                       Visibility="{Binding IsTestingModeActive, Converter={StaticResource VisibilityConverter}}"
                                       Style="{StaticResource Caption}"/>
                            <ItemsControl ItemsSource="{Binding DevToolkitItems}" ItemTemplate="{StaticResource NavItemTemplate}"
                                          Visibility="{Binding IsTestingModeActive, Converter={StaticResource VisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- Global Toast Notifications Overlay -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Right" 
                      Margin="20" Panel.ZIndex="999" ItemsSource="{Binding ToastVm.ActiveToasts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SidebarBrush}" CornerRadius="6" Margin="0,0,0,10" 
                            BorderThickness="1" Width="300" Opacity="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="100,0,-100,10" To="0,0,0,10" Duration="0:0:0.4">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.BorderBrush>
                            <Binding Path="Severity">
                                <Binding.Converter>
                                    <converters:SeverityToBrushConverter/>
                                </Binding.Converter>
                            </Binding>
                        </Border.BorderBrush>
                        <Border Padding="15">
                            <Grid Width="240">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:ImageAwesome Width="14" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <fa:ImageAwesome.Style>
                                        <Style TargetType="fa:ImageAwesome">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                    <Setter Property="Icon" Value="CheckCircle"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                    <Setter Property="Icon" Value="InfoCircle"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Icon" Value="ExclamationTriangle"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Icon" Value="TimesCircle"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </fa:ImageAwesome.Style>
                                </fa:ImageAwesome>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Global Command Palette Overlay -->
        <ContentControl Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100" 
                        Content="{Binding CommandPaletteVm}"
                        Visibility="{Binding CommandPaletteVm.IsOpen, Converter={StaticResource VisibilityConverter}}"/>
