<Window x:Class="Eternal.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Eternal Intelligence - Knowledge Base" Height="650" Width="950"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Knowledge Index) -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,10,0,20">
                    <fa:ImageAwesome Icon="Book" Width="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="KNOWLEDGE BASE" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Bar (HCI: Efficiency) -->
                <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="20" Padding="15,8" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <fa:ImageAwesome Icon="Search" Width="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                 FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Search topics..." IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                
                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredArticles}" SelectedItem="{Binding SelectedArticle}"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="15,12" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <fa:ImageAwesome Grid.Column="0" Icon="{Binding Icon}" Width="14" Margin="0,0,15,0" VerticalAlignment="Center" Opacity="0.7">
                                                    <fa:ImageAwesome.Style>
                                                        <Style TargetType="fa:ImageAwesome">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa:ImageAwesome.Style>
                                                </fa:ImageAwesome>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="9" Opacity="0.5" FontWeight="Bold" TextAlignment="Left"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                </ListBox>

                <!-- No Results Overlay (HCI Rule 7) -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5" IsHitTestVisible="False"
                            Visibility="{Binding FilteredArticles.Count, Converter={StaticResource VisibilityConverter}, ConverterParameter=Inverse}">
                    <fa:ImageAwesome Icon="Search" Width="24" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,15"/>
                    <TextBlock Text="No articles found" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Padding="60,50" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Style="{StaticResource ModuleHeaderStyle}" Margin="0,0,0,40">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="DOCUMENTATION" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding SelectedArticle.Category, FallbackValue='GENERAL'}" Style="{StaticResource Caption}" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedArticle.Title, FallbackValue='Select a Topic'}" Style="{StaticResource H1}" Margin="0"/>
                        <TextBlock Text="{Binding SelectedArticle.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Margin="0,10,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <Border Style="{StaticResource StandardCard}" Padding="40" Background="#08FFFFFF">
                        <StackPanel>
                            <fa:ImageAwesome Icon="QuoteLeft" Width="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Opacity="0.15" Margin="0,0,0,25"/>
                            <TextBlock Text="{Binding SelectedArticle.Content}" TextWrapping="Wrap" FontSize="17" Foreground="{DynamicResource TextBrush}" LineHeight="32"/>
                            <fa:ImageAwesome Icon="QuoteRight" Width="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Opacity="0.15" Margin="0,25,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Margin="0,40,0,0" Padding="25,20" Background="#0AFFFFFF" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="LightbulbOutline" Width="18" Foreground="{DynamicResource WarningBrush}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="PRO TIP" FontWeight="Black" FontSize="10" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="You can find specific technical details by using the global 'Eternal Console' for direct CLI queries." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Padding="30,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SidebarBrush}">
                <Button Content="Return to Workspace" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryAction}" Click="CloseButton_Click" Padding="30,12" FontSize="13" FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.ColumnSpan="2" Background="#CC0A0A0A" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <fa:ImageAwesome Icon="Spinner" Spin="True" Foreground="{DynamicResource AccentBrush}" Width="48" Margin="0,0,0,20"/>
                <TextBlock Text="INDEXING KNOWLEDGE BASE..." FontSize="18" FontWeight="Black" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
