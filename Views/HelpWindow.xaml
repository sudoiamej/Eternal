<Window x:Class="Eternal.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Eternal - Knowledge Base" Height="600" Width="900"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation (HCI Rule 5: Mapping) -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <StackPanel Orientation="Horizontal" Margin="5,10,0,30">
                    <fa:ImageAwesome Icon="Book" Width="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="KNOWLEDGE BASE" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <ListBox x:Name="TopicList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                         SelectionChanged="TopicList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,10" Margin="0,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    
                    <ListBoxItem Content="Getting Started" IsSelected="True"/>
                    <ListBoxItem Content="Hardware Intelligence"/>
                    <ListBoxItem Content="Security Auditing"/>
                    <ListBoxItem Content="Active Sentry (Network)"/>
                    <ListBoxItem Content="PE / Recovery Mode"/>
                    <ListBoxItem Content="FAQ &amp; Troubleshooting"/>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Content Area (HCI Rule 6 & 11: Conceptual Model & Disclosure) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Padding="50,40" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Style="{StaticResource ModuleHeaderStyle}" Margin="0,0,0,40">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="ETERNAL SUITE" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text=" › " Style="{StaticResource Caption}"/>
                            <TextBlock Text="DOCUMENTATION" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentTopicTitle}" Style="{StaticResource H1}" Margin="0"/>
                        <TextBlock Text="{Binding CurrentTopicDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource StandardCard}" Padding="35">
                        <StackPanel>
                            <fa:ImageAwesome Icon="QuoteLeft" Width="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" Opacity="0.2" Margin="0,0,0,20"/>
                            <TextBlock Text="{Binding CurrentContent}" TextWrapping="Wrap" FontSize="16" Foreground="{StaticResource TextBrush}" LineHeight="28"/>
                            <fa:ImageAwesome Icon="QuoteRight" Width="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Opacity="0.2" Margin="0,20,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Margin="0,30,0,0" Padding="20" Background="#0AFFFFFF" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="LightbulbOutline" Width="16" Foreground="{StaticResource InfoBrush}" Margin="0,0,15,0"/>
                            <TextBlock Text="Tip: Every module has a 'Refresh' button in the top right for live updates." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" Padding="20,15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SidebarBrush}">
                <Button Content="Return to Intelligence Suite" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryAction}" Click="CloseButton_Click" Padding="20,10"/>
            </Border>
        </Grid>
    </Grid>
</Window>
