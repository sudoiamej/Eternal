<Window x:Class="Eternal.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:vm="clr-namespace:Eternal.ViewModels"
        xmlns:vmm="clr-namespace:Eternal.ViewModels.Modules"
        xmlns:vmv="clr-namespace:Eternal.Views.Modules"
        xmlns:helpers="clr-namespace:Eternal.Views.Helpers"
        xmlns:converters="clr-namespace:Eternal.Helpers"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="800" Width="1400"
        MinWidth="1024" MinHeight="700"
        SizeChanged="Window_SizeChanged"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico"
        KeyDown="Window_KeyDown"
        Opacity="0"
        Background="Transparent">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <PointAnimation Storyboard.TargetName="BgGradient" Storyboard.TargetProperty="Center" From="0.5,0.4" To="0.6,0.5" Duration="0:0:15"/>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.0" Duration="0:0:1">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.0" Duration="0:0:1">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Orb1Trans" Storyboard.TargetProperty="X" From="-50" To="100" Duration="0:0:25"/>
                    <DoubleAnimation Storyboard.TargetName="Orb1Trans" Storyboard.TargetProperty="Y" From="-50" To="150" Duration="0:0:30"/>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Orb2Trans" Storyboard.TargetProperty="X" From="50" To="-150" Duration="0:0:28"/>
                    <DoubleAnimation Storyboard.TargetName="Orb2Trans" Storyboard.TargetProperty="Y" From="-100" To="100" Duration="0:0:35"/>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Orb3Trans" Storyboard.TargetProperty="X" From="-100" To="150" Duration="0:0:32"/>
                    <DoubleAnimation Storyboard.TargetName="Orb3Trans" Storyboard.TargetProperty="Y" From="50" To="-120" Duration="0:0:27"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding CommandPaletteVm.OpenCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmm:DashboardViewModel}"><vmv:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:HardwareViewModel}"><vmv:HardwareView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PEModeViewModel}"><vmv:PEModeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BiosViewModel}"><vmv:BiosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SecurityViewModel}"><vmv:SecurityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PerformanceViewModel}"><vmv:PerformanceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DriversViewModel}"><vmv:DriversView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ServicesViewModel}"><vmv:ServicesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:StorageViewModel}"><vmv:StorageView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:NetworkViewModel}"><vmv:NetworkView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ReportsViewModel}"><vmv:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ToolsViewModel}"><vmv:ToolsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SettingsViewModel}"><vmv:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ProcessIntelligenceViewModel}"><vmv:ProcessIntelligenceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ThermalViewModel}"><vmv:ThermalView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:EnvironmentViewModel}"><vmv:EnvironmentView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:VerboseLoggingViewModel}"><vmv:VerboseLoggingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RepairCenterViewModel}"><vmv:RepairCenterView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RegistryViewModel}"><vmv:RegistryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:TuningViewModel}"><vmv:TuningView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ConsoleViewModel}"><vmv:ConsoleView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BootViewModel}"><vmv:BootView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:UserManagementViewModel}"><vmv:UserManagementView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ComponentsViewModel}"><vmv:ComponentsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:WindowsUpdateViewModel}"><vmv:WindowsUpdateView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DisplayViewModel}"><vmv:DisplayView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PcScannerViewModel}"><vmv:PcScannerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DismImagingViewModel}"><vmv:DismImagingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PcRatingViewModel}"><vmv:PcRatingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SnapshotsViewModel}"><vmv:SnapshotsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:HardwareStressViewModel}"><vmv:HardwareStressView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:CommandPaletteViewModel}"><helpers:CommandPaletteOverlay/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PrivacyViewModel}"><vmv:PrivacyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BatteryViewModel}"><vmv:BatteryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FileForensicsViewModel}"><vmv:FileForensicsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FeatureTogglesViewModel}"><vmv:FeatureTogglesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:FlagsViewModel}"><vmv:FlagsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:TestingViewModel}"><vmv:TestingView/></DataTemplate>
    </Window.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
        </Grid.LayoutTransform>

        <!-- SPATIAL LAYER 0: Background Environment -->
        <Rectangle x:Name="BackgroundRect">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="BgGradient" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="1.2" RadiusY="1.2">
                    <GradientStop x:Name="BgStop1" Color="{DynamicResource BgGradientStop1}" Offset="0"/>
                    <GradientStop x:Name="BgStop2" Color="{DynamicResource BgGradientStop2}" Offset="0.5"/>
                    <GradientStop x:Name="BgStop3" Color="{DynamicResource BgGradientStop3}" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentView.IsFocusModeActive}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.6"/></Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.6"/></Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- Spatial Cyber Orbs Canvas -->
        <Canvas x:Name="OrbsCanvas" IsHitTestVisible="False" Opacity="0.5">
            <!-- Orb 1: Emerald/Indigo -->
            <Ellipse x:Name="Orb1" Width="400" Height="400" Canvas.Left="-50" Canvas.Top="-50">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2000FF88" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb1Trans" X="0" Y="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Orb 2: Royal Blue/Violet -->
            <Ellipse x:Name="Orb2" Width="500" Height="500" Canvas.Right="-100" Canvas.Top="200">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#150078D7" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="120"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb2Trans" X="0" Y="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Orb 3: Contextual Glow bound to Accent -->
            <Ellipse x:Name="Orb3" Width="450" Height="450" Canvas.Left="400" Canvas.Bottom="-100">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="110"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="Orb3Trans" X="0" Y="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- Main Structure (Spatial Layout Engine) -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Intent Pill -->
                <RowDefinition Height="*"/>    <!-- Adaptive Workspace -->
                <RowDefinition Height="Auto"/> <!-- Activity Dock -->
            </Grid.RowDefinitions>

            <!-- SPATIAL LAYER 1: Top Intent Pill (Contextual Header) -->
            <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,25" Padding="25,0" Height="60" CornerRadius="30" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    Background="{DynamicResource SidebarBrush}" Panel.ZIndex="50">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView.IsFocusModeActive}" Value="True">
                                <Setter Property="Opacity" Value="0.2"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo / Workspace Switcher -->
                    <ToggleButton x:Name="MenuToggle" Background="Transparent" BorderThickness="0" Margin="0,0,25,0" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Image Source="/Assets/logo.png" Width="28" Height="28">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value><DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/></Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <TextBlock Text="ETERNAL SYSTEM WORKSPACE" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,25,0" FontWeight="Black" Opacity="0.8"/>
                    
                    <Separator Background="{DynamicResource BorderBrush}" Height="20" Width="1" Margin="0,0,25,0"/>

                    <!-- Global Intent Search -->
                    <Button Command="{Binding CommandPaletteVm.OpenCommand}" Style="{StaticResource IconButton}" ToolTip="Universal Commands (Ctrl+K)">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Search" Width="14" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Margin="0,0,10,0"/>
                            <TextBlock Text="SEARCH ACTIONS" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Telemetry HUD Toggle Button -->
            <Button Grid.Row="0" Command="{Binding ToggleTelemetryHudCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                    Margin="0,0,70,25" Style="{StaticResource IconButton}" ToolTip="Toggle Performance HUD" Panel.ZIndex="100">
                <fa:ImageAwesome Icon="Dashboard" Width="16" Foreground="{DynamicResource AccentBrush}"/>
            </Button>

            <!-- UI Toggle Button (Upper Right Context) -->
            <Button Grid.Row="0" Command="{Binding ToggleUICommand}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                    Margin="0,0,30,25" Style="{StaticResource IconButton}" ToolTip="Switch to Legacy UI" Panel.ZIndex="100"
                    Visibility="{Binding IsUiToggleVisible, Converter={StaticResource VisibilityConverter}}">
                <fa:ImageAwesome Icon="Exchange" Width="16" Foreground="{DynamicResource AccentBrush}"/>
            </Button>

            <!-- SPATIAL LAYER 2: Main Workspace Canvas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Floating Rail -->
                    <ColumnDefinition Width="*"/>    <!-- Adaptive Content -->
                </Grid.ColumnDefinitions>

                <!-- Floating Navigation Rail Panel (HCI: Collapsible with spring overshoot) -->
                <Grid Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,25,0">
                    <Border x:Name="MainSidebar" 
                            Background="{DynamicResource SidebarBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="30"
                            HorizontalAlignment="Left" Padding="0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="280"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView.IsFocusModeActive}" Value="True">
                                        <Setter Property="Opacity" Value="0.2"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggle}" Value="False">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="65" Duration="0:0:0.6">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase EasingMode="EaseInOut" Amplitude="0.6"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="280" Duration="0:0:0.6">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase EasingMode="EaseInOut" Amplitude="0.6"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        
                        <Grid Width="280" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Rail Content -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
                                <StackPanel Margin="10,0">
                                    <StackPanel.Resources>
                                        <DataTemplate x:Key="NavItemTemplate">
                                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding ViewName}"
                                                    HorizontalContentAlignment="Left"
                                                    Margin="0,2" Padding="0" Background="Transparent" BorderThickness="0" Height="45">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="15"><ContentPresenter/></Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#20FFFFFF"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#15FFFFFF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid Width="260">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <fa:ImageAwesome Grid.Column="0" Icon="{Binding Icon}" Width="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <fa:ImageAwesome.Style>
                                                        <Style TargetType="fa:ImageAwesome">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding HasAlert}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="AlertPulse">
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.8" AutoReverse="True"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="AlertPulse"/>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </fa:ImageAwesome.Style>
                                                </fa:ImageAwesome>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Black"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=SidebarToggle}" Value="False">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.15">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </StackPanel.Resources>

                                    <ItemsControl ItemsSource="{Binding SystemItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>
                                    <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="15,15" Opacity="0.3"/>
                                    <ItemsControl ItemsSource="{Binding TelemetryItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>
                                    <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="15,15" Opacity="0.3"/>
                                    <ItemsControl ItemsSource="{Binding MonitoringItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>
                                    <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="15,15" Opacity="0.3"/>
                                    <ItemsControl ItemsSource="{Binding SupportItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                                    <!-- SPATIAL LAYER 4: Developer / Testing Suite (Secret Menu) -->
                                    <StackPanel Visibility="{Binding IsTestingModeActive, Converter={StaticResource VisibilityConverter}}">
                                        <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="15,15" Opacity="0.3"/>
                                        <TextBlock Text="DEV TESTING SUITE" FontSize="9" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" Margin="20,0,0,10" Opacity="0.8"/>
                                        <ItemsControl ItemsSource="{Binding DevToolkitItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Floating Chevron Toggle Button (HCI Signifier & Affordance) -->
                    <ToggleButton x:Name="SidebarToggle" 
                                  IsChecked="{Binding IsChecked, ElementName=MenuToggle, Mode=TwoWay}"
                                  Width="24" Height="24"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,-12,0"
                                  Cursor="Hand"
                                  Panel.ZIndex="100">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="BtnBorder" Background="{DynamicResource SidebarBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
                                    </Border.Effect>
                                    <fa:ImageAwesome x:Name="BtnIcon" Icon="ChevronLeft" Width="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="BtnIcon" Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="BtnIcon" Property="Icon" Value="ChevronRight"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <!-- Adaptive Content Area -->
                <Border Grid.Column="1" Background="#05FFFFFF" CornerRadius="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <ContentControl Content="{Binding CurrentView}"/>
                </Border>
            </Grid>

            <!-- SPATIAL LAYER 3: Dynamic Activity Dock -->
            <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,25,0,5" Padding="30,0" Height="50" CornerRadius="25" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                    Background="{DynamicResource SidebarBrush}" Panel.ZIndex="50">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView.IsFocusModeActive}" Value="True">
                                <Setter Property="Opacity" Value="0.2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CPU Pulse -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                        <fa:ImageAwesome Icon="Microchip" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CpuUsage}" Foreground="White" FontWeight="Black" FontSize="12" VerticalAlignment="Center" Width="40"/>
                        <ProgressBar Value="{Binding CpuUsageValue}" Width="60" Style="{StaticResource GlowingProgressBar}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- RAM Footprint -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                        <fa:ImageAwesome Icon="Tasks" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RamUsage}" Foreground="White" FontWeight="Black" FontSize="12" VerticalAlignment="Center" Width="40"/>
                        <ProgressBar Value="{Binding RamUsageValue}" Width="60" Style="{StaticResource GlowingProgressBar}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- System Pulse indicator -->
                    <Border Background="#1000FFAA" CornerRadius="10" Padding="12,4" Margin="0,0,30,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="NEURAL ENGINE: ACTIVE" FontSize="9" FontWeight="Black" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Uptime -->
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="ClockOutline" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Uptime}" Foreground="White" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Global Overlays -->
        <ItemsControl VerticalAlignment="Top" HorizontalAlignment="Right" Margin="30" Panel.ZIndex="999" ItemsSource="{Binding ToastVm.ActiveToasts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SidebarBrush}" CornerRadius="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="20,15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="Transparent"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="{Binding Severity, Converter={StaticResource CategoryToIconConverter}, ConverterParameter='Toast'}" 
                                            Width="16" Margin="0,0,15,0" 
                                            Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"/>
                            <TextBlock Text="{Binding Message}" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Spatial Layer 5: Drag-and-Drop HUD Overlay Layer -->
        <Canvas Panel.ZIndex="300" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{x:Null}" IsHitTestVisible="True">
            <helpers:TelemetryHUD Canvas.Left="50" Canvas.Top="150"
                                  Visibility="{Binding IsTelemetryHudOpen, Converter={StaticResource VisibilityConverter}}"/>
        </Canvas>

        <ContentControl Panel.ZIndex="400" Content="{Binding CommandPaletteVm}" Visibility="{Binding CommandPaletteVm.IsOpen, Converter={StaticResource VisibilityConverter}}"/>
    </Grid>
</Window>
