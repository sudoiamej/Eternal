<Window x:Class="Eternal.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:vm="clr-namespace:Eternal.ViewModels"
        xmlns:vmm="clr-namespace:Eternal.ViewModels.Modules"
        xmlns:vmv="clr-namespace:Eternal.Views.Modules"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1280"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico"
        KeyDown="Window_KeyDown"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="0.98" To="1.0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="0.98" To="1.0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="{DynamicResource BackgroundGradientColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource BackgroundColor}" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ResetZoomCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmm:DashboardViewModel}"><vmv:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:HardwareViewModel}"><vmv:HardwareView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PEModeViewModel}"><vmv:PEModeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BiosViewModel}"><vmv:BiosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SecurityViewModel}"><vmv:SecurityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:PerformanceViewModel}"><vmv:PerformanceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:DriversViewModel}"><vmv:DriversView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ServicesViewModel}"><vmv:ServicesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:StorageViewModel}"><vmv:StorageView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:NetworkViewModel}"><vmv:NetworkView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ReportsViewModel}"><vmv:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ToolsViewModel}"><vmv:ToolsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:SettingsViewModel}"><vmv:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ProcessIntelligenceViewModel}"><vmv:ProcessIntelligenceView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ThermalViewModel}"><vmv:ThermalView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:EnvironmentViewModel}"><vmv:EnvironmentView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:VerboseLoggingViewModel}"><vmv:VerboseLoggingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RepairCenterViewModel}"><vmv:RepairCenterView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:RegistryViewModel}"><vmv:RegistryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:TuningViewModel}"><vmv:TuningView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ConsoleViewModel}"><vmv:ConsoleView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:BootViewModel}"><vmv:BootView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:UserManagementViewModel}"><vmv:UserManagementView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmm:ComponentsViewModel}">
            <vmv:ComponentsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmm:WindowsUpdateViewModel}">
            <vmv:WindowsUpdateView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmm:PcScannerViewModel}">
            <vmv:PcScannerView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmm:DismImagingViewModel}">
            <vmv:DismImagingView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmm:PcRatingViewModel}">
            <vmv:PcRatingView/>
        </DataTemplate>

    </Window.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" x:Name="MainSidebar" 
                Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                Width="220" HorizontalAlignment="Left">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="60" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="220" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="0,30,0,20">
                    <!-- Logo as Toggle Button (HCI: Branded Recognition) -->
                    <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource IconButton}" 
                            HorizontalAlignment="Center" Margin="0,0,0,15" ToolTip="Toggle Navigation">
                        <Image Source="/Assets/logo.png" Width="32" Height="32"/>
                    </Button>

                    <StackPanel Width="220" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="ETERNAL" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextBrush}"/>
                            <Border Background="#9B59B6" CornerRadius="3" VerticalAlignment="Center" Margin="8,0,0,0" Padding="5,1">
                                <TextBlock Text="DEV PREVIEW" FontSize="8" FontWeight="Black" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="SYSTEM INTELLIGENCE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6" Margin="0,2,0,15" HorizontalAlignment="Center"/>

                        <!-- Nav Sorting -->
                        <ComboBox SelectedValue="{Binding NavSortOption}" SelectedValuePath="Tag"
                                  Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                  Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Padding="8,4"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Default" Tag="{x:Static vm:NavigationSortOption.Default}"/>
                            <ComboBoxItem Content="Level" Tag="{x:Static vm:NavigationSortOption.Level}"/>
                            <ComboBoxItem Content="Easy to Hard" Tag="{x:Static vm:NavigationSortOption.EasyToHard}"/>
                            <ComboBoxItem Content="Alphabetical" Tag="{x:Static vm:NavigationSortOption.Alphabetical}"/>
                            <ComboBoxItem Content="Safe to Dangerous" Tag="{x:Static vm:NavigationSortOption.SafeToDangerous}"/>

                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                        <fa:ImageAwesome Grid.Column="1" Icon="Sort" Width="10" Foreground="{TemplateBinding Foreground}" Margin="0,0,10,0"/>
                                                        <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}">
                                                                <ScrollViewer SnapsToDevicePixels="True">
                                                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5,0">
                        <StackPanel.Resources>
                            <DataTemplate x:Key="NavItemTemplate">
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding ViewName}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,1"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Height="40"
                                        ToolTip="{Binding Name}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0FFFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid Width="220">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- HCI Rule 7: Active State Feedback -->
                                        <Border Style="{StaticResource ActiveMarker}" Margin="0,0,0,0"/>

                                        <fa:ImageAwesome Grid.Column="0" Icon="{Binding Icon}" Width="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <fa:ImageAwesome.Style>
                                                <Style TargetType="fa:ImageAwesome">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </fa:ImageAwesome.Style>
                                        </fa:ImageAwesome>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Margin="5,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </StackPanel.Resources>

                        <TextBlock Text="SYSTEM" Style="{StaticResource Caption}" Margin="15,10,0,10" Opacity="0.5"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding SystemItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                        <TextBlock Text="CORE TELEMETRY" Style="{StaticResource Caption}" Margin="15,20,0,10" Opacity="0.5"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding TelemetryItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                        <TextBlock Text="ACTIVE MONITORING" Style="{StaticResource Caption}" Margin="15,20,0,10" Opacity="0.5"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding MonitoringItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                        <TextBlock Text="SUPPORT &amp; SAFETY" Style="{StaticResource Caption}" Margin="15,20,0,10" Opacity="0.5"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource VisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding SupportItems}" ItemTemplate="{StaticResource NavItemTemplate}"/>

                        <TextBlock Text="DEVELOPER TOOLKIT" Margin="15,20,0,10" Opacity="0.5" 
                                   Visibility="{Binding IsTestingModeActive, Converter={StaticResource VisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding DevToolkitItems}" ItemTemplate="{StaticResource NavItemTemplate}"
                                      Visibility="{Binding IsTestingModeActive, Converter={StaticResource VisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/> <!-- Top Status Bar -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Status Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="System Status: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Healthy" Foreground="#4CAF50" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <fa:ImageAwesome Icon="Microchip" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,8,0"/>
                            <TextBlock Text="CPU: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CpuUsage}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <ProgressBar Value="{Binding CpuUsageValue}" Width="40" Style="{StaticResource GlowingProgressBar}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <fa:ImageAwesome Icon="Tasks" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,8,0"/>
                            <TextBlock Text="RAM: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RamUsage}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <ProgressBar Value="{Binding RamUsageValue}" Width="40" Style="{StaticResource GlowingProgressBar}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="ClockOutline" Foreground="{DynamicResource TextSecondaryBrush}" Width="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Uptime: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Uptime}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>


