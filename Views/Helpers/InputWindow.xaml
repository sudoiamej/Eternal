<Window x:Class="Eternal.Views.Helpers.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Required" Height="200" Width="400"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptText" Text="Please enter value:" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
            <TextBox Grid.Row="1" x:Name="InputBox" Style="{StaticResource ModernTextBox}" VerticalAlignment="Top"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="OK" Click="Ok_Click" Width="80" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                <Button Content="Cancel" Click="Cancel_Click" Width="80" Style="{StaticResource StandardButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
