<Window x:Class="Eternal.Views.Helpers.TestingAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Developer Access" Height="280" Width="350"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#12121A" CornerRadius="12" BorderBrush="#00FF00" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Monospace Terminal Area -->
            <Border Grid.Row="0" Background="#0A0A0F" CornerRadius="8" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="ETERNAL SYSTEM INTELLIGENCE v10.0" FontFamily="Consolas" FontSize="11" Foreground="#00FF00" Opacity="0.7"/>
                    <TextBlock Text="DEV ACCESS GATEWAY - AUTHORIZATION REQUIRED" FontFamily="Consolas" FontSize="11" Foreground="#00FF00" Margin="0,5,0,15"/>
                    <TextBlock Text="WARNING: High-level system bypass triggers enabled." FontFamily="Consolas" FontSize="10" Foreground="#FF3333" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="SYS:\> enter_pin_code: " FontFamily="Consolas" FontSize="12" Foreground="#00FF00" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="PinInput" Background="Transparent" BorderThickness="0" Foreground="#00FF00" CaretBrush="#00FF00" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="0" MaxLength="6" Width="100" HorizontalAlignment="Left" KeyDown="PinInput_KeyDown" PasswordChanged="PinInput_PasswordChanged"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="ConsoleStatusText" Text="SYS:\> status: crypt_key_idle" FontFamily="Consolas" FontSize="11" Foreground="#FFFF00" Margin="0,15,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Console Actions -->
            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="ABORT" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="Cancel_Click" FontFamily="Consolas" FontSize="11"/>
                <Button Grid.Column="1" Content="EXECUTE" Style="{StaticResource PrimaryButton}" Margin="5,0,0,0" Click="Authorize_Click" Background="#008800" BorderBrush="#00FF00" Foreground="White" FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</Window>


