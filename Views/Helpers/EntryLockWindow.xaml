<Window x:Class="Eternal.Views.Helpers.EntryLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="System Locked" Height="420" Width="460"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Topmost="True">
    
    <Window.Resources>
        <!-- Custom Neumorphic style for PasswordBox -->
        <Style x:Key="NeumorphicPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource NeuDarkShadowColor}" BlurRadius="30" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Branded Logo Header -->
                <RowDefinition Height="*"/>    <!-- Input Area -->
                <RowDefinition Height="Auto"/> <!-- Attempt Status & Lockouts -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- Branded Logo Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,25">
                <Image Source="/Assets/logo.png" Height="50" HorizontalAlignment="Center" Margin="0,0,0,15" Stretch="Uniform"/>
                <TextBlock Text="SYSTEM ENTRY LOCKED" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Eternal System Intelligence requires a security handshake." 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Input Area: Horizontal TextBox + Side Arrow -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="320" HorizontalAlignment="Center">
                <TextBlock x:Name="InputPromptText" Text="ENTER ACCESS CODE" Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="9" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Left"/>
                
                <Grid x:Name="VisualPinContainer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="VisualPinContainer_MouseLeftButtonDown" VerticalAlignment="Center">
                        <!-- Invisible PasswordBox overlaying the 6 boxes for focus/input -->
                        <PasswordBox x:Name="PinInput" MaxLength="6" Width="280" Height="46" Opacity="0.01" Background="Transparent" BorderThickness="0"
                                     PasswordChanged="PinInput_PasswordChanged" KeyDown="PinInput_KeyDown" CaretBrush="Transparent"/>
                        
                        <!-- 6-Box Visual Layout -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False" VerticalAlignment="Center">
                            <!-- Box 1 -->
                            <Border x:Name="Box1" Width="40" Height="46" CornerRadius="10" Margin="3,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="#0AFFFFFF">
                                <TextBlock x:Name="Text1" Text="" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Box 2 -->
                            <Border x:Name="Box2" Width="40" Height="46" CornerRadius="10" Margin="3,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="#0AFFFFFF">
                                <TextBlock x:Name="Text2" Text="" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Box 3 -->
                            <Border x:Name="Box3" Width="40" Height="46" CornerRadius="10" Margin="3,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="#0AFFFFFF">
                                <TextBlock x:Name="Text3" Text="" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Box 4 -->
                            <Border x:Name="Box4" Width="40" Height="46" CornerRadius="10" Margin="3,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="#0AFFFFFF">
                                <TextBlock x:Name="Text4" Text="" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Box 5 -->
                            <Border x:Name="Box5" Width="40" Height="46" CornerRadius="10" Margin="3,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="#0AFFFFFF">
                                <TextBlock x:Name="Text5" Text="" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Box 6 -->
                            <Border x:Name="Box6" Width="40" Height="46" CornerRadius="10" Margin="3,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="#0AFFFFFF">
                                <TextBlock x:Name="Text6" Text="" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Side right-arrow action button -->
                    <Button x:Name="UnlockButton" Grid.Column="1" CommandParameter="{Binding}" Height="46" Width="50" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="Unlock_Click" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="ArrowRight" Width="14" Foreground="Black">
                            <fa:ImageAwesome.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.3"/>
                            </fa:ImageAwesome.Effect>
                        </fa:ImageAwesome>
                    </Button>
                </Grid>

                <TextBlock x:Name="ErrorText" Text="Invalid access code" Foreground="{DynamicResource CriticalBrush}" 
                           FontSize="10" Margin="0,8,0,0" Visibility="Collapsed" HorizontalAlignment="Left" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Attempt Status & Lockouts -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                <!-- Visual Attempt Pins -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" x:Name="AttemptPinsPanel" Margin="0,5">
                    <Ellipse x:Name="Attempt1" Width="8" Height="8" Margin="5,0" Fill="{DynamicResource SuccessBrush}"/>
                    <Ellipse x:Name="Attempt2" Width="8" Height="8" Margin="5,0" Fill="{DynamicResource SuccessBrush}"/>
                    <Ellipse x:Name="Attempt3" Width="8" Height="8" Margin="5,0" Fill="{DynamicResource SuccessBrush}"/>
                </StackPanel>
                
                <StackPanel x:Name="LockoutPanel" Visibility="Collapsed" Margin="0,5">
                    <TextBlock Text="SECURITY LOCKOUT ACTIVE" Foreground="{DynamicResource CriticalBrush}" 
                               FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LockoutTimerText" Text="Please wait 00:60" Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="EXIT APPLICATION" Style="{StaticResource SecondaryButton}" Height="36" Width="180" Click="Exit_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
