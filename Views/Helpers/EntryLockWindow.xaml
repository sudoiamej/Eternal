<Window x:Class="Eternal.Views.Helpers.EntryLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="System Locked" Height="400" Width="500"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Topmost="True">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="15" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                <fa:ImageAwesome Icon="Lock" Width="48" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>
                <TextBlock Text="SYSTEM ENTRY LOCKED" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Eternal System Intelligence is protected for testing purposes." 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Input Area -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="300">
                <TextBlock x:Name="InputPromptText" Text="ENTER 6-DIGIT ACCESS CODE" Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                
                <Grid x:Name="VisualPinContainer" HorizontalAlignment="Center" Margin="0,5,0,15" Cursor="Hand" MouseLeftButtonDown="VisualPinContainer_MouseLeftButtonDown">
                    <!-- Invisible PasswordBox that handles all entry and focus -->
                    <PasswordBox x:Name="PinInput" MaxLength="6" Width="300" Height="50" Opacity="0.01" Background="Transparent" BorderThickness="0"
                                 PasswordChanged="PinInput_PasswordChanged" KeyDown="PinInput_KeyDown" CaretBrush="Transparent"/>
                    
                    <!-- Beautiful 6-Dot Visual Indicator Row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False" VerticalAlignment="Center">
                        <!-- Dot 1 -->
                        <Border x:Name="Dot1" Width="20" Height="20" CornerRadius="10" Margin="8,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0"/></Border.Effect>
                        </Border>
                        <!-- Dot 2 -->
                        <Border x:Name="Dot2" Width="20" Height="20" CornerRadius="10" Margin="8,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0"/></Border.Effect>
                        </Border>
                        <!-- Dot 3 -->
                        <Border x:Name="Dot3" Width="20" Height="20" CornerRadius="10" Margin="8,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0"/></Border.Effect>
                        </Border>
                        <!-- Dot 4 -->
                        <Border x:Name="Dot4" Width="20" Height="20" CornerRadius="10" Margin="8,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0"/></Border.Effect>
                        </Border>
                        <!-- Dot 5 -->
                        <Border x:Name="Dot5" Width="20" Height="20" CornerRadius="10" Margin="8,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0"/></Border.Effect>
                        </Border>
                        <!-- Dot 6 -->
                        <Border x:Name="Dot6" Width="20" Height="20" CornerRadius="10" Margin="8,0" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0"/></Border.Effect>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Text="Invalid access code" Foreground="{DynamicResource CriticalBrush}" 
                           FontSize="11" Margin="0,5,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>

                <!-- Visual Attempt Pins -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" x:Name="AttemptPinsPanel">
                    <Ellipse x:Name="Attempt1" Width="10" Height="10" Margin="6,0" Fill="{DynamicResource SuccessBrush}"/>
                    <Ellipse x:Name="Attempt2" Width="10" Height="10" Margin="6,0" Fill="{DynamicResource SuccessBrush}"/>
                    <Ellipse x:Name="Attempt3" Width="10" Height="10" Margin="6,0" Fill="{DynamicResource SuccessBrush}"/>
                </StackPanel>
                
                <StackPanel x:Name="LockoutPanel" Visibility="Collapsed" Margin="0,15,0,0">
                    <TextBlock Text="SECURITY LOCKOUT ACTIVE" Foreground="{DynamicResource CriticalBrush}" 
                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    <Viewbox Width="60" Height="60" Margin="0,15,0,10" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="ClockOutline" Foreground="{DynamicResource TextSecondaryBrush}" Width="40" Height="40"/>
                    </Viewbox>
                    <TextBlock x:Name="LockoutTimerText" Text="Please wait 00:60" Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="EXIT APP" Style="{StaticResource SecondaryButton}" Height="40" Width="140" Margin="0,0,10,0" Click="Exit_Click"/>
                <Button x:Name="UnlockButton" Content="UNLOCK SYSTEM" Style="{StaticResource PrimaryButton}" Height="40" Width="140" Click="Unlock_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>


