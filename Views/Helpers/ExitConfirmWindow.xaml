<Window x:Class="Eternal.Views.Helpers.ExitConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Exit Application" Height="220" Width="400"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        MouseDown="Window_MouseDown">

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <fa:ImageAwesome Icon="SignOut" Width="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <TextBlock Text="EXIT APPLICATION" Style="{StaticResource H1}" FontSize="18" Foreground="White"/>
                <TextBlock Text="Are you sure you want to close Eternal Intelligence?" 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Warning Details -->
            <Border Grid.Row="1" Background="#0AFFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,5" VerticalAlignment="Center">
                <TextBlock Text="Active sweeps and background diagnostic routines will be terminated." FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Opacity="0.8"/>
            </Border>

            <!-- Action buttons -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="CANCEL" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,5,0" Click="Cancel_Click"/>
                <Button Grid.Column="1" Content="EXIT NOW" Style="{StaticResource PrimaryButton}" Height="36" Margin="5,0,0,0" Click="Confirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
