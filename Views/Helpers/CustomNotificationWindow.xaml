<Window x:Class="Eternal.Views.Helpers.CustomNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Notification" Height="260" Width="420"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        MouseDown="Window_MouseDown">

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header and Type Icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <fa:ImageAwesome x:Name="TypeIcon" Icon="InfoCircle" Width="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBlock x:Name="TitleText" Text="NOTIFICATION" Style="{StaticResource H1}" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" Text="Notification message goes here..." 
                           Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center"/>
            </ScrollViewer>

            <!-- Buttons Grid -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="CancelBtn" Content="CANCEL" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="Cancel_Click" Visibility="Collapsed"/>
                <Button x:Name="ConfirmBtn" Grid.Column="1" Content="OK" Style="{StaticResource PrimaryButton}" Margin="5,0,0,0" Click="Confirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
