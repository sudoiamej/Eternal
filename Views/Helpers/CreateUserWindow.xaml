<Window x:Class="Eternal.Views.Helpers.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New User" Height="450" Width="400"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="CREATE LOCAL USER" Style="{StaticResource H2}" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="User name:" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                <TextBlock Text="Full name:" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox x:Name="FullNameBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                <TextBlock Text="Description:" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                <TextBlock Text="Password:" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PassBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,10"/>
                
                <TextBlock Text="Confirm password:" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPassBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,15"/>

                <CheckBox x:Name="MustChangeCheck" Content="User must change password at next logon" Foreground="White" Margin="0,0,0,5"/>
                <CheckBox x:Name="CannotChangeCheck" Content="User cannot change password" Foreground="White" Margin="0,0,0,5"/>
                <CheckBox x:Name="NeverExpiresCheck" Content="Password never expires" Foreground="White" Margin="0,0,0,5"/>
                <CheckBox x:Name="DisabledCheck" Content="Account is disabled" Foreground="White"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Create" Click="Create_Click" Width="80" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                <Button Content="Close" Click="Close_Click" Width="80" Style="{StaticResource StandardButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
