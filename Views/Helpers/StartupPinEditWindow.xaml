<Window x:Class="Eternal.Views.Helpers.StartupPinEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Change Access Code" Height="320" Width="400"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" Background="Transparent">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="15" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <fa:ImageAwesome Icon="Key" Width="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <TextBlock Text="CHANGE ACCESS CODE" Style="{StaticResource H1}" FontSize="18"/>
                <TextBlock Text="Set a new 6-digit security code for application entry." 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Input Fields -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="NEW 6-DIGIT PIN" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <PasswordBox x:Name="NewPinInput" Padding="12" Background="{DynamicResource CardBrush}" 
                             Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             FontSize="16" HorizontalContentAlignment="Center" MaxLength="6"/>

                <TextBlock Text="CONFIRM PIN" Style="{StaticResource Caption}" Margin="0,15,0,8"/>
                <PasswordBox x:Name="ConfirmPinInput" Padding="12" Background="{DynamicResource CardBrush}" 
                             Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             FontSize="16" HorizontalContentAlignment="Center" MaxLength="6"/>
                
                <TextBlock x:Name="ErrorText" Text="PINs do not match or invalid length" Foreground="{DynamicResource CriticalBrush}" 
                           FontSize="10" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="CANCEL" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="Cancel_Click"/>
                <Button Content="UPDATE PIN" Style="{StaticResource PrimaryButton}" Margin="5,0,0,0" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>


