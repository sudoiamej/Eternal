<Window x:Class="Eternal.Views.Helpers.OrbitalVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="CPU Core Telemetry Orbital Visualizer" Height="600" Width="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border x:Name="RootBorder" Background="#050508" BorderBrush="#0078D4" BorderThickness="1.5" CornerRadius="20" Padding="25" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.9" ScaleY="0.9"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WindowScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WindowScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="SunOutline" Width="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ORBITAL HARDWARE SYNTHESIS" FontSize="9" FontWeight="Black" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <TextBlock Text="CORE TELEMETRY MATRIX" FontSize="20" FontWeight="Black" Foreground="White"/>
                </StackPanel>

                <Button Grid.Column="1" Click="CloseButton_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <fa:ImageAwesome Icon="Times" Width="14" Foreground="#888896"/>
                </Button>
            </Grid>

            <!-- Canvas Container -->
            <Grid Grid.Row="1">
                <Canvas x:Name="OrbitalCanvas" Background="Transparent"/>
            </Grid>

            <!-- Footer Stats -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CoresCountText" Text="LOGICAL CORES: 0" FontSize="10" FontWeight="Bold" Foreground="#888896" Margin="0,0,15,0"/>
                    <TextBlock x:Name="AverageLoadText" Text="AVG LOAD: 0%" FontSize="10" FontWeight="Bold" Foreground="#00FF66"/>
                </StackPanel>

                <Button Grid.Column="1" Click="CloseButton_Click" Style="{StaticResource PrimaryButton}" Height="34" Width="90" Cursor="Hand">
                    <TextBlock Text="CLOSE" FontWeight="Black" FontSize="11" Foreground="Black"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
