<Window x:Class="Eternal.Views.Helpers.RegistryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Surgical Registry Editor" MinHeight="420" Height="450" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource ModernWindow}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Scrollable Content -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="VALUE MODIFICATION" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,5"/>
            <TextBlock x:Name="ValueNameText" Text="Value Name" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <!-- 2. Technical Context -->
                <Border Background="#111111" Padding="15" CornerRadius="4" Margin="0,0,0,25">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Type" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="TypeText" Text="REG_DWORD" HorizontalAlignment="Right" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Current Value" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="CurrentValueText" Text="0x00000000" HorizontalAlignment="Right" Foreground="{StaticResource AccentSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Dynamic Input Area -->
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="New Value Entry" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <TextBox x:Name="ValueInput" Padding="12,10" Background="#1A1A1A" Foreground="White" 
                             BorderBrush="{StaticResource BorderBrush}" FontSize="14" FontFamily="Consolas"/>
                    
                    <!-- Specific Options (Progressive Disclosure for known values) -->
                    <ItemsControl x:Name="QuickOptions" Margin="0,15,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 4. Warning (HCI Rule 5: Constraints) -->
                <Border Background="#20F44336" Padding="12" CornerRadius="4" Margin="0,15,0,20">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="ExclamationTriangle" Width="12" Foreground="{StaticResource CriticalBrush}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Direct registry modification can affect system stability. Ensure the input is valid for this data type." 
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="350"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 5. Actions -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Height="40"/>
            <Button Grid.Column="1" Content="Commit Change" Click="Commit_Click" Style="{StaticResource PrimaryAction}" Margin="8,0,0,0" Height="40"/>
        </Grid>
    </Grid>
</Window>
