<Window x:Class="Eternal.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Eternal" Height="380" Width="300"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Background="Transparent" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border x:Name="RootBorder" CornerRadius="20" Background="#060609" BorderBrush="#242436" BorderThickness="1.5" ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.92" ScaleY="0.92"/>
                <TranslateTransform x:Name="WindowTranslate" Y="20"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.92" To="1" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.92" To="1" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.8"/>
        </Border.Effect>
        
        <Grid x:Name="MainGrid" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Center Logo & Breathing Glow Branding -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Margin="0,0,0,22" HorizontalAlignment="Center">
                    <!-- Glowing Aura Effect -->
                    <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource AccentBrush}" Opacity="0.18">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="25" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="0.4" Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    
                    <Image Source="/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                        <Image.RenderTransformOrigin>0.5,0.5</Image.RenderTransformOrigin>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.06" Duration="0:0:1.2">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.06" Duration="0:0:1.2">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                </Grid>

                <TextBlock Text="ETERNAL" FontSize="28" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="DIAGNOSTICS WORKSTATION" FontSize="8" FontWeight="Bold" Foreground="#A2A2A9" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock x:Name="UserGreetingTextBlock" Text="Hello!" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- Progress & Animated Status Text -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <Border Height="3" Background="#12121C" CornerRadius="1.5" Margin="0,0,0,12" ClipToBounds="True">
                    <ProgressBar Height="3" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" IsIndeterminate="True"/>
                </Border>
                <TextBlock Text="INITIALIZING SECURE ENGINE..." FontSize="8" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:0.8"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>