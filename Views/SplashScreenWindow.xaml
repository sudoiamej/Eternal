<Window x:Class="Eternal.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Eternal" Height="420" Width="320"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Background="Transparent" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Opacity="1">

    <Window.Resources>
        <Storyboard x:Key="GlowPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="Opacity" 
                             From="0.5" To="1.0" Duration="0:0:1.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="BlurRadius" 
                             From="25" To="45" Duration="0:0:1.5" AutoReverse="True"/>
            
            <!-- Particle Accelerator Rotations -->
            <DoubleAnimation Storyboard.TargetName="Rot1" Storyboard.TargetProperty="Angle" 
                             From="0" To="360" Duration="0:0:1.2"/>
            <DoubleAnimation Storyboard.TargetName="Rot2" Storyboard.TargetProperty="Angle" 
                             From="360" To="0" Duration="0:0:2.5"/>
            <DoubleAnimation Storyboard.TargetName="Rot3" Storyboard.TargetProperty="Angle" 
                             From="0" To="360" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource GlowPulse}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <Border CornerRadius="25" Background="#0A0A10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="MainGrid">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- Logo & Particle Accelerator Grid -->
                <Grid Margin="0,0,0,35">
                    <!-- Accelerator Layer 1: Outer Slow -->
                    <Ellipse Width="190" Height="190" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.1" StrokeDashArray="4 4"/>
                    <Ellipse Width="190" Height="190" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="0.05 10" StrokeDashCap="Round">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="Rot1" CenterX="95" CenterY="95"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Accelerator Layer 2: Inner Counter-Rotate -->
                    <Ellipse Width="175" Height="175" Stroke="{DynamicResource AccentSecondaryBrush}" StrokeThickness="1.5" StrokeDashArray="0.02 5" StrokeDashCap="Round" Opacity="0.6">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="Rot2" CenterX="87.5" CenterY="87.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Accelerator Layer 3: High Velocity Pulse -->
                    <Ellipse Width="205" Height="205" Stroke="White" StrokeThickness="0.5" StrokeDashArray="0.01 20" StrokeDashCap="Round" Opacity="0.4">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="Rot3" CenterX="102.5" CenterY="102.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Glowing Logo Center -->
                    <Border Width="160" Height="160" Background="#05050A" CornerRadius="80" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Image Source="/Assets/logo.png" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.Effect>
                                <DropShadowEffect x:Name="LogoGlow" Color="{DynamicResource AccentColor}" BlurRadius="35" ShadowDepth="0" Opacity="0.8"/>
                            </Image.Effect>
                        </Image>
                    </Border>
                </Grid>

                <!-- Branding Typography (Matched to Legacy UI Style) -->
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ETERNAL" FontSize="32" FontWeight="Black" Foreground="White" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="SYSTEM INTELLIGENCE" FontSize="11" FontWeight="Bold" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" 
                               Margin="0,8,0,0" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>