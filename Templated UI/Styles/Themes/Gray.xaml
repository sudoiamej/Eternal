<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Gray Theme Palette -->
    <Color x:Key="BackgroundColor">#2C2C2C</Color>
    <Color x:Key="BackgroundGradientColor">#3D3D3D</Color>
    <Color x:Key="SidebarColor">#252525</Color>
    <Color x:Key="CardColor">#353535</Color>
    <Color x:Key="TextColor">#E0E0E0</Color>
    <Color x:Key="TextSecondaryColor">#B0B0B0</Color>
    <Color x:Key="TextDisabledColor">#707070</Color>
    <Color x:Key="BorderColor">#404040</Color>

    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#43A047</Color>
    <Color x:Key="WarningColor">#FFB300</Color>
    <Color x:Key="CriticalColor">#E53935</Color>
    <Color x:Key="InfoColor">#8E24AA</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    
    <!-- Adaptive Text on Accent (Default for Gray) -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="White"/>

    <!-- Derived from Accent (Fallback) -->
    <Color x:Key="AccentSecondaryColor">#333333</Color>

</ResourceDictionary>
