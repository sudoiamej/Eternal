<Window x:Class="Eternal.Views.ShutdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Eternal Shutdown" Height="380" Width="550"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Background="Transparent" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainScale" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Background>
            <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#0F0F0F" Offset="1"/>
                <GradientStop Color="#1A1A1A" Offset="0"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid x:Name="MainGrid" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="MainScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <!-- Branded Content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
                <Image Source="/Assets/logo.png" Width="90" Margin="0,0,0,25">
                    <Image.Effect>
                        <DropShadowEffect Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                    </Image.Effect>
                </Image>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="ETERNAL" FontSize="36" FontWeight="Black" Foreground="{DynamicResource TextBrush}"/>
                    <Border Background="#444444" CornerRadius="4" VerticalAlignment="Top" Margin="10,5,0,0" Padding="6,2">
                        <TextBlock Text="TERMINATING" FontSize="10" FontWeight="Black" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="SECURING SYSTEM ARCHITECTURE" FontSize="10" FontWeight="Bold" 
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" 
                           Margin="0,5,0,0" Opacity="0.6"/>
            </StackPanel>

            <!-- Shutdown Progress (HCI: Continuous Feedback) -->
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,50" Width="300">
                <TextBlock x:Name="StatusText" Text="Encrypting local session logs..." 
                           FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" 
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                
                <Grid>
                    <ProgressBar Height="2" IsIndeterminate="True" Background="#1FFFFFFF" Foreground="{DynamicResource SuccessBrush}" BorderThickness="0"/>
                    <!-- Subtle Success Glow for the shutdown bar -->
                    <Border Height="2" Background="{DynamicResource SuccessBrush}" Opacity="0.3">
                        <Border.Effect>
                            <BlurEffect Radius="10"/>
                        </Border.Effect>
                    </Border>
                </Grid>
                
                <TextBlock x:Name="DetailText" Text="Finalizing integrity report and closing background workers." 
                           FontSize="8" Foreground="{DynamicResource TextDisabledBrush}" 
                           HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.7"/>
            </StackPanel>


            <TextBlock Text="ETERNAL SYSTEM INTELLIGENCE • SECURE DISCONNECT" FontSize="8" FontWeight="Bold" 
                       Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Bottom" 
                       HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.3"/>
        </Grid>
    </Border>
</Window>



