<Window x:Class="Eternal.Views.Helpers.EntryLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="System Locked" Height="400" Width="500"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Topmost="True">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="15" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                <fa:ImageAwesome Icon="Lock" Width="48" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20"/>
                <TextBlock Text="SYSTEM ENTRY LOCKED" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Eternal System Intelligence is protected for testing purposes." 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Input Area -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="300">
                <TextBlock Text="ENTER 6-DIGIT ACCESS CODE" Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="10" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                
                <PasswordBox x:Name="PinInput" Padding="15" Background="{DynamicResource CardBrush}" 
                             Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             FontSize="24" HorizontalContentAlignment="Center" MaxLength="6"
                             KeyDown="PinInput_KeyDown" HorizontalAlignment="Stretch"/>

                <TextBlock x:Name="ErrorText" Text="Invalid access code" Foreground="{DynamicResource CriticalBrush}" 
                           FontSize="11" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>
                
                <StackPanel x:Name="LockoutPanel" Visibility="Collapsed" Margin="0,15,0,0">
                    <TextBlock Text="SECURITY LOCKOUT ACTIVE" Foreground="{DynamicResource CriticalBrush}" 
                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LockoutTimerText" Text="Please wait 00:60" Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2" Width="300" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="EXIT APP" Style="{StaticResource SecondaryButton}" Height="40" Margin="0,0,5,0" Click="Exit_Click"/>
                <Button Grid.Column="1" x:Name="UnlockButton" Content="UNLOCK" Style="{StaticResource PrimaryButton}" Height="40" Margin="5,0,0,0" Click="Unlock_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>


