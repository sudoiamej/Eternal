<Window x:Class="Eternal.Views.Helpers.GroupDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group Properties" Height="450" Width="400"
        Style="{StaticResource ModernWindow}"
        WindowStartupLocation="CenterOwner">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="GroupNameTitle" Text="Group Name" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="DescriptionTitle" Text="Description" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Members:" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <ListBox x:Name="MembersList" Grid.Row="1" Background="#10FFFFFF" BorderBrush="{DynamicResource BorderBrush}" Foreground="White" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Add..." Click="AddMember_Click" Style="{StaticResource StandardButton}" Width="80" Margin="0,0,10,0"/>
                    <Button Content="Remove" Click="RemoveMember_Click" Style="{StaticResource StandardButton}" Width="80"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="OK" Click="Ok_Click" Width="80" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                <Button Content="Cancel" Click="Cancel_Click" Width="80" Style="{StaticResource StandardButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
