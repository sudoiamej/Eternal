<UserControl x:Class="Eternal.Views.Helpers.RadialGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="200" d:DesignWidth="200">
    <Grid x:Name="RootGrid">
        <!-- Background Track -->
        <Path Stroke="{Binding StrokeBackground, ElementName=Root}" 
              StrokeThickness="{Binding StrokeThickness, ElementName=Root}"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.1">
            <Path.Data>
                <EllipseGeometry Center="100,100" RadiusX="90" RadiusY="90"/>
            </Path.Data>
        </Path>

        <!-- Progress Arc -->
        <Path x:Name="ProgressPath" 
              Stroke="{Binding Stroke, ElementName=Root}" 
              StrokeThickness="{Binding StrokeThickness, ElementName=Root}"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect>
                <DropShadowEffect Color="{Binding GlowColor, ElementName=Root}" 
                                  BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
            </Path.Effect>
            <Path.Data>
                <PathGeometry>
                    <PathFigure x:Name="PathFigure" StartPoint="100,10">
                        <ArcSegment x:Name="ArcSegment" Size="90,90" SweepDirection="Clockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Central Content -->
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
